<template>
  <div class="page-container">
    <!-- Header -->
    <div class="header">
      <text
        class="title pressable {{ pressedKey === 'back' ? 'is-down press-down' : '' }} {{ releasedKey === 'back' ? 'press-up' : '' }}"
        ontouchstart="pressDown('back')"
        ontouchend="pressRelease('back')"
        ontouchcancel="pressCancel('back')"
        onclick="goBack"
      >‹设置</text>
    </div>

    <!-- Settings list -->
    <div class="form-area">
      <div class="form-list">
        <!-- 使用interconnect代理http -->
        <div class="form-item">
          <text class="form-label">使用interconnect代理http</text>
          <switch
            class="switch"
            checked="{{ proxyHttp }}"
            @change="onProxyHttpChange"
          ></switch>
        </div>
        <text class="form-desc">开启后由手机代发所有HTTP请求（包括配对），绕过手表的fetch。</text>
      </div>
    </div>
  </div>
</template>

<style>
.page-container {
  width: 100%;
  height: 100%;
  background-color: #000;
  position: relative;
}

/* ---- Header ---- */
.header {
  width: 100%;
  height: 90px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000;
}
.title {
  font-size: 32px;
  font-weight: bold;
  color: #fff;
  text-align: center;
}

/* ---- Form ---- */
.form-area {
  position: absolute;
  top: 90px;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  flex-direction: column;
  align-items: center;
}
.form-list {
  width: 100%;
  flex-direction: column;
  align-items: center;
  padding-top: 20px;
}
.form-item {
  width: 420px;
  height: 96px;
  margin: 5px 0;
  padding: 0 24px;
  background-color: #2e323c;
  border-radius: 48px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.form-label {
  font-size: 24px;
  font-weight: bold;
  color: #fff;
  lines: 2;
  flex-grow: 1;
  margin-right: 16px;
}
.form-desc {
  width: 420px;
  font-size: 18px;
  color: #888;
  margin-top: 8px;
  padding: 0 8px;
}
.switch {
  flex-shrink: 0;
}

.pressable {
  transform-origin: 50% 50%;
  transform: scale(1);
  opacity: 1;
}
.is-down {
  opacity: 0.75;
}
.press-down {
  animation-name: PressDown;
  animation-duration: 80ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
.press-up {
  animation-name: PressUp;
  animation-duration: 140ms;
  animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes PressDown {
  0% { transform: scale(1); opacity: 1; }
  100% { transform: scale(0.94); opacity: 0.75; }
}
@keyframes PressUp {
  0% { transform: scale(0.94); opacity: 0.75; }
  100% { transform: scale(1); opacity: 1; }
}

/* ---- Circle screen adaptation ---- */
@media (shape: circle) {
  .form-list {
    padding-top: 30px;
  }
  .form-item {
    width: 380px;
    height: 92px;
    border-radius: 46px;
  }
  .form-desc {
    width: 380px;
  }
}

/* ---- Rect screen adaptation ---- */
@media (shape: rect) {
  .header {
    height: 65px;
  }
  .form-area {
    top: 65px;
  }
  .form-list {
    padding-top: 10px;
  }
}
</style>

<script>
import router from '@system.router'
import settingsService from '../../services/settingsService.js'

export default {
  private: {
    proxyHttp: false,
    pressedKey: '',
    releasedKey: ''
  },

  onShow() {
    this.loadSettings()
  },

  async loadSettings() {
    try {
      this.proxyHttp = await settingsService.getProxyHttp()
    } catch (e) {
      console.warn('[settings] load failed', e)
    }
  },

  async onProxyHttpChange(e) {
    const value = e && e.checked
    this.proxyHttp = !!value
    try {
      await settingsService.setProxyHttp(this.proxyHttp)
    } catch (err) {
      console.warn('[settings] save failed', err)
    }
  },

  goBack() {
    router.back()
  },

  pressDown(key) {
    this.releasedKey = ''
    this.pressedKey = key
  },

  pressRelease(key) {
    this.pressedKey = ''
    this.releasedKey = key
    setTimeout(() => {
      if (this.releasedKey === key) this.releasedKey = ''
    }, 160)
  },

  pressCancel(key) {
    if (this.pressedKey === key) this.pressedKey = ''
    if (this.releasedKey === key) this.releasedKey = ''
  }
}
</script>
