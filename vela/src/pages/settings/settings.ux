<template>
  <div class="page-container">
    <!-- Header -->
    <div class="header">
      <text class="time-display">{{ currentTime }}</text>
      <text
        class="title pressable {{ pressedKey === 'back' ? 'is-down press-down' : '' }} {{ releasedKey === 'back' ? 'press-up' : '' }}"
        ontouchstart="pressDown('back')"
        ontouchend="pressRelease('back')"
        ontouchcancel="pressCancel('back')"
        onclick="goBack"
      >‹设置</text>
    </div>

    <!-- Settings list -->
    <div class="form-area">
      <div class="form-list">
        <!-- App info card -->
        <div class="app-card">
          <image class="app-icon" src="/common/icon.png"></image>
          <div class="app-info">
            <text class="app-name">HydroStation</text>
            <text class="app-version">v{{ appVersion }}</text>
            <text class="app-author">By Float-11</text>
          </div>
        </div>

        <!-- 强制使用 fetch -->
        <div class="form-item">
          <text class="form-label">强制使用 fetch</text>
          <switch
            class="switch"
            checked="{{ forceFetch }}"
            @change="onForceFetchChange"
          ></switch>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
.page-container {
  width: 100%;
  height: 100%;
  background-color: #000;
  position: relative;
}

/* ---- Header ---- */
.header {
  width: 100%;
  height: 90px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000;
}
.time-display {
  font-size: 28px;
  font-weight: bold;
  color: #fff;
  padding-top: 5px;
  text-align: center;
}
.title {
  font-size: 32px;
  font-weight: bold;
  color: #fff;
  text-align: center;
}

/* ---- Form ---- */
.form-area {
  position: absolute;
  top: 90px;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  flex-direction: column;
  align-items: center;
}
.form-list {
  width: 100%;
  flex-direction: column;
  align-items: center;
  padding-top: 20px;
}
.app-card {
  width: 420px;
  height: 150px;
  margin-bottom: 12px;
  padding: 0 24px;
  background-color: #2e323c;
  border-radius: 24px;
  flex-direction: row;
  justify-content: flex-start;
  align-items: center;
}
.app-icon {
  width: 72px;
  height: 72px;
  margin-right: 20px;
  flex-shrink: 0;
}
.app-info {
  flex-grow: 1;
  flex-direction: column;
  justify-content: center;
}
.app-name {
  font-size: 28px;
  font-weight: bold;
  color: #fff;
}
.app-version {
  font-size: 20px;
  color: #888;
  margin-top: 4px;
}
.app-author {
  font-size: 18px;
  color: #888;
  margin-top: 2px;
}
.form-item {
  width: 420px;
  height: 96px;
  margin: 5px 0;
  padding: 0 24px;
  background-color: #2e323c;
  border-radius: 48px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.form-label {
  font-size: 24px;
  font-weight: bold;
  color: #fff;
  lines: 2;
  flex-grow: 1;
  margin-right: 16px;
}
.switch {
  flex-shrink: 0;
}

.pressable {
  transform-origin: 50% 50%;
  transform: scale(1);
  opacity: 1;
}
.is-down {
  opacity: 0.75;
}
.press-down {
  animation-name: PressDown;
  animation-duration: 80ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
.press-up {
  animation-name: PressUp;
  animation-duration: 140ms;
  animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes PressDown {
  0% { transform: scale(1); opacity: 1; }
  100% { transform: scale(0.94); opacity: 0.75; }
}
@keyframes PressUp {
  0% { transform: scale(0.94); opacity: 0.75; }
  100% { transform: scale(1); opacity: 1; }
}

/* ---- Circle screen adaptation ---- */
@media (shape: circle) {
  .form-list {
    padding-top: 30px;
  }
  .app-card {
    width: 380px;
    height: 140px;
  }
  .form-item {
    width: 380px;
    height: 92px;
    border-radius: 46px;
  }
}

/* ---- Rect screen adaptation ---- */
@media (shape: rect) {
  .header {
    height: 65px;
  }
  .form-area {
    top: 65px;
  }
  .form-list {
    padding-top: 10px;
  }
}
</style>

<script>
import router from '@system.router'
import app from '@system.app'
import settingsService from '../../services/settingsService.js'

export default {
  private: {
    currentTime: '00:00',
    appVersion: '1.0.0',
    forceFetch: false,
    pressedKey: '',
    releasedKey: ''
  },

  onInit() {
    this.updateTime()
    this._timeInterval = setInterval(() => this.updateTime(), 60000)
    try {
      const info = app.getInfo()
      if (info && info.versionName) this.appVersion = info.versionName
    } catch (e) {}
  },

  onDestroy() {
    if (this._timeInterval) clearInterval(this._timeInterval)
  },

  updateTime() {
    const now = new Date()
    this.currentTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`
  },

  onShow() {
    this.loadSettings()
  },

  async loadSettings() {
    try {
      this.forceFetch = await settingsService.getForceFetch()
    } catch (e) {
      console.warn('[settings] load failed', e)
    }
  },

  async onForceFetchChange(e) {
    const value = e && e.checked
    this.forceFetch = !!value
    try {
      await settingsService.setForceFetch(this.forceFetch)
    } catch (err) {
      console.warn('[settings] save failed', err)
    }
  },

  goBack() {
    router.back()
  },

  pressDown(key) {
    this.releasedKey = ''
    this.pressedKey = key
  },

  pressRelease(key) {
    this.pressedKey = ''
    this.releasedKey = key
    setTimeout(() => {
      if (this.releasedKey === key) this.releasedKey = ''
    }, 160)
  },

  pressCancel(key) {
    if (this.pressedKey === key) this.pressedKey = ''
    if (this.releasedKey === key) this.releasedKey = ''
  }
}
</script>
