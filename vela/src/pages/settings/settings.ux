<template>
  <div class="page-container">
    <!-- Header -->
    <div class="header">
      <text class="time-display">{{ currentTime }}</text>
      <text
        class="title pressable {{ pressedKey === 'back' ? 'is-down press-down' : '' }} {{ releasedKey === 'back' ? 'press-up' : '' }}"
        ontouchstart="pressDown('back')"
        ontouchend="pressRelease('back')"
        ontouchcancel="pressCancel('back')"
        onclick="goBack"
      >‹设置</text>
    </div>

    <!-- Settings list（内容变多时能滚：原来是一层 div，超出就直接被裁掉） -->
    <scroll class="scroll-area" scroll-y="true" bounces="true">
      <div class="form-list">
        <!-- App info card -->
        <div
          class="app-card pressable {{ pressedKey === 'about' ? 'is-down press-down' : '' }} {{ releasedKey === 'about' ? 'press-up' : '' }}"
          ontouchstart="pressDown('about')"
          ontouchend="pressRelease('about')"
          ontouchcancel="pressCancel('about')"
          onclick="onOpenVersion"
        >
          <image class="app-icon" src="/common/icon.png"></image>
          <div class="app-info">
            <text class="app-name">HydroLink</text>
            <text class="app-version">v{{ appVersion }} · By Float-11</text>
            <text class="app-group">交流群：1053432339</text>
          </div>
          <text class="app-chevron">›</text>
        </div>

        <!-- 屏幕常亮 -->
        <div class="form-item">
          <text class="form-label">屏幕常亮</text>
          <switch
            class="switch"
            checked="{{ keepScreenOn }}"
            @change="onKeepScreenOnChange"
          ></switch>
        </div>

        <!-- 强制使用 fetch -->
        <div class="form-item">
          <text class="form-label">强制使用 fetch</text>
          <switch
            class="switch"
            checked="{{ forceFetch }}"
            @change="onForceFetchChange"
          ></switch>
        </div>
      </div>
    </scroll>
  </div>
</template>

<style>
.page-container {
  width: 100%;
  height: 100%;
  background-color: #000;
  position: relative;
}

/* ---- Header ---- */
.header {
  width: 100%;
  height: 90px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000;
}
.time-display {
  font-size: 28px;
  font-weight: bold;
  color: #fff;
  padding-top: 5px;
  text-align: center;
}
.title {
  font-size: 32px;
  font-weight: bold;
  color: #fff;
  text-align: center;
}

/* ---- Form ---- */
.scroll-area {
  position: absolute;
  top: 90px;
  left: 0;
  right: 0;
  /* Vela：**竖向滚动需要设置定高**（官方文档原文），只用 top/bottom 不算定高，滚不动。
     这里直接给 466(466) - 90(头部) 的高度；矩形屏在各自的 media 块里调整。 */
  height: 376px;
}
.form-list {
  width: 100%;
  flex-direction: column;
  align-items: center;
  padding-top: 20px;
  padding-bottom: 40px;
  /* 内容容器也必须定高：只给 <scroll> 定高是不够的——Vela 会把 scroll 的子容器拉成
     视口高度，里面的 flex 项随即被压扁去适配，于是"内容永远刚好装下"→ 没有可滚余量。
     这里的值要 ≥ 内容实际高度（卡片 150 + 16 + 96 + 16 + 96 + 上下留白）；
     增删设置项时同步调这个数。 */
  height: 450px;
}
.app-card {
  /* 关键：flex 子项默认 flex-shrink:1，会被压扁去适配可视高度（表现为
     "写了 150px 却显示 77px、第三行被裁、间距消失"）。不收缩才会溢出并触发滚动。 */
  flex-shrink: 0;
  width: 420px;
  height: 150px;
  margin-bottom: 16px;
  padding: 0 24px;
  background-color: #2e323c;
  border-radius: 40px;
  flex-direction: row;
  justify-content: flex-start;
  align-items: center;
}
.app-icon {
  width: 72px;
  height: 72px;
  margin-right: 20px;
  flex-shrink: 0;
}
.app-info {
  flex-grow: 1;
  flex-shrink: 0;
  flex-direction: column;
  justify-content: center;
}
.app-name {
  font-size: 28px;
  font-weight: bold;
  color: #fff;
}
.app-version {
  font-size: 20px;
  color: #fff;
  margin-top: 6px;
}
.app-group {
  font-size: 18px;
  color: #fff;
  margin-top: 3px;
}
.app-chevron {
  font-size: 32px;
  font-weight: bold;
  color: #888;
  flex-shrink: 0;
  margin-left: 8px;
}
.form-item {
  flex-shrink: 0;
  width: 420px;
  height: 96px;
  margin: 0 0 16px 0;
  padding: 0 24px;
  background-color: #2e323c;
  border-radius: 48px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.form-label {
  font-size: 24px;
  font-weight: bold;
  color: #fff;
  lines: 2;
  flex-grow: 1;
  margin-right: 16px;
}
.switch {
  flex-shrink: 0;
}

.pressable {
  transform-origin: 50% 50%;
  transform: scale(1);
  opacity: 1;
}
.is-down {
  opacity: 0.75;
}
.press-down {
  animation-name: PressDown;
  animation-duration: 80ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
.press-up {
  animation-name: PressUp;
  animation-duration: 140ms;
  animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes PressDown {
  0% { transform: scale(1); opacity: 1; }
  100% { transform: scale(0.94); opacity: 0.75; }
}
@keyframes PressUp {
  0% { transform: scale(0.94); opacity: 0.75; }
  100% { transform: scale(1); opacity: 1; }
}

/* ---- Circle screen adaptation ---- */
@media (shape: circle) {
  /* 圆屏：**不做压缩**——内容按正常尺寸排（卡片 156、开关行 100、间距 16），
     装不下就滚。上下各留出余量，任何一项都能滚到圆心中段（可用宽度最大处）看。
     注：圆屏上"贴弧线被切一点"是这类列表的常态，滚动才是解法，不是把内容压小。 */
  .form-list {
    padding-top: 24px;
    padding-bottom: 140px;
    /* 圆屏内容：24 + 156 + 16 + 100 + 16 + 100 + 140(底部安全区) ≈ 552 → 取 560
       （底部这 140px 就是"安全区"：让最后一项能滚到圆心中段，不卡在弧线窄区） */
    height: 560px;
  }
  .app-card {
    width: 360px;
    height: 156px;
    border-radius: 44px;
  }
  .form-item {
    width: 360px;
    height: 100px;
    border-radius: 50px;
  }
}

/* ---- Rect screen adaptation ---- */
@media (shape: rect) {
  .header {
    height: 65px;
    flex-direction: row-reverse;
    justify-content: space-between;
    align-items: center;
    padding: 0 48px;
  }
  .title {
    margin-left: 12px;
  }
  .time-display {
    margin-right: 12px;
  }
  .scroll-area {
    /* 矩形屏：头部 65px。这里按 432x514 的矩形表算（449 = 514 - 65）；换设备只改这个数 */
    top: 65px;
    height: 449px;
  }
  .form-list {
    padding-top: 10px;
  }
}
</style>

<script>
import router from '@system.router'
import app from '@system.app'
import brightness from '@system.brightness'
import settingsService from '../../services/settingsService.js'

/**
 * 应用"屏幕常亮"（@system.brightness 的 keepScreenOn）。
 * 平台不支持或调用失败时只记日志——这只是个体验开关，不该让设置页崩掉。
 */
function applyKeepScreenOn(on) {
  try {
    brightness.setKeepScreenOn({
      keepScreenOn: !!on,
      fail: (data, code) => console.warn('[settings] setKeepScreenOn failed', data, code)
    })
  } catch (e) {
    console.warn('[settings] brightness 不可用', e)
  }
}

export default {
  private: {
    currentTime: '00:00',
    appVersion: '1.0.0',
    forceFetch: false,
    keepScreenOn: false,
    pressedKey: '',
    releasedKey: ''
  },

  onInit() {
    this.updateTime()
    this._timeInterval = setInterval(() => this.updateTime(), 60000)
    try {
      const info = app.getInfo()
      if (info && info.versionName) this.appVersion = info.versionName
    } catch (e) {}
  },

  onDestroy() {
    if (this._timeInterval) clearInterval(this._timeInterval)
  },

  updateTime() {
    const now = new Date()
    this.currentTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`
  },

  onShow() {
    this.loadSettings()
  },

  async loadSettings() {
    try {
      this.forceFetch = await settingsService.getForceFetch()
      this.keepScreenOn = await settingsService.getKeepScreenOn()
      // 重新进入设置页时按当前值再应用一次（系统可能在息屏后重置）
      applyKeepScreenOn(this.keepScreenOn)
    } catch (e) {
      console.warn('[settings] load failed', e)
    }
  },

  async onKeepScreenOnChange(e) {
    const value = e && e.checked
    this.keepScreenOn = !!value
    applyKeepScreenOn(this.keepScreenOn)
    try {
      await settingsService.setKeepScreenOn(this.keepScreenOn)
    } catch (err) {
      console.warn('[settings] save failed', err)
    }
  },

  async onForceFetchChange(e) {
    const value = e && e.checked
    this.forceFetch = !!value
    try {
      await settingsService.setForceFetch(this.forceFetch)
    } catch (err) {
      console.warn('[settings] save failed', err)
    }
  },

  goBack() {
    router.back()
  },

  onOpenVersion() {
    router.push({ uri: '/pages/version' })
  },

  pressDown(key) {
    this.releasedKey = ''
    this.pressedKey = key
  },

  pressRelease(key) {
    this.pressedKey = ''
    this.releasedKey = key
    setTimeout(() => {
      if (this.releasedKey === key) this.releasedKey = ''
    }, 160)
  },

  pressCancel(key) {
    if (this.pressedKey === key) this.pressedKey = ''
    if (this.releasedKey === key) this.releasedKey = ''
  }
}
</script>
