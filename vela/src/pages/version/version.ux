<template>
  <div class="page-container">
    <!-- Header -->
    <div class="header">
      <text class="time-display">{{ currentTime }}</text>
      <text
        class="title pressable {{ pressedKey === 'back' ? 'is-down press-down' : '' }} {{ releasedKey === 'back' ? 'press-up' : '' }}"
        ontouchstart="pressDown('back')"
        ontouchend="pressRelease('back')"
        ontouchcancel="pressCancel('back')"
        onclick="goBack"
      >‹版本信息</text>
    </div>

    <!-- Info list -->
    <div class="form-area">
      <div class="form-list">
        <div class="info-item">
          <text class="info-label">应用版本</text>
          <text class="info-value">v{{ version }}</text>
        </div>
        <div class="info-item">
          <text class="info-label">编译时间</text>
          <text class="info-value">{{ buildTime }}</text>
        </div>
        <div class="info-item">
          <text class="info-label">commit</text>
          <text class="info-value">{{ commit }}</text>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
.page-container {
  width: 100%;
  height: 100%;
  background-color: #000;
  position: relative;
}

/* ---- Header ---- */
.header {
  width: 100%;
  height: 90px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000;
}
.time-display {
  font-size: 28px;
  font-weight: bold;
  color: #fff;
  padding-top: 5px;
  text-align: center;
}
.title {
  font-size: 32px;
  font-weight: bold;
  color: #fff;
  text-align: center;
}

/* ---- Info list ---- */
.form-area {
  position: absolute;
  top: 90px;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  flex-direction: column;
  align-items: center;
}
.form-list {
  width: 100%;
  flex-direction: column;
  align-items: center;
  padding-top: 20px;
}
.info-item {
  width: 420px;
  height: 88px;
  margin: 4px 0;
  padding: 0 24px;
  background-color: #2e323c;
  border-radius: 44px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.info-label {
  font-size: 24px;
  font-weight: bold;
  color: #fff;
}
.info-value {
  font-size: 24px;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.6);
  lines: 1;
  text-overflow: ellipsis;
}

.pressable {
  transform-origin: 50% 50%;
  transform: scale(1);
  opacity: 1;
}
.is-down {
  opacity: 0.75;
}
.press-down {
  animation-name: PressDown;
  animation-duration: 150ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
.press-up {
  animation-name: PressUp;
  animation-duration: 250ms;
  animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes PressDown {
  0% { transform: scale(1); opacity: 1; }
  100% { transform: scale(0.94); opacity: 0.75; }
}
@keyframes PressUp {
  0% { transform: scale(0.94); opacity: 0.75; }
  100% { transform: scale(1); opacity: 1; }
}

/* ---- Circle screen adaptation ---- */
@media (shape: circle) {
  .form-list {
    padding-top: 30px;
  }
  .info-item {
    width: 400px;
    height: 84px;
    border-radius: 42px;
  }
}

/* ---- Rect screen adaptation ---- */
@media (shape: rect) {
  .header {
    height: 65px;
    flex-direction: row-reverse;
    justify-content: space-between;
    align-items: center;
    padding: 0 48px;
  }
  .title {
    margin-left: 12px;
  }
  .time-display {
    margin-right: 12px;
  }
  .form-area {
    top: 65px;
  }
  .form-list {
    padding-top: 10px;
  }
}
</style>

<script>
import router from '@system.router'
import app from '@system.app'
import buildInfo from '../../services/buildInfo.js'

export default {
  private: {
    currentTime: '00:00',
    version: '1.0.0',
    buildTime: '-',
    commit: '-',
    pressedKey: '',
    releasedKey: ''
  },

  onInit() {
    this.updateTime()
    this._timeInterval = setInterval(() => this.updateTime(), 1000)
    try {
      const info = app.getInfo()
      if (info && info.versionName) this.version = info.versionName
    } catch (e) {}
    this.buildTime = buildInfo.buildTime || '-'
    this.commit = buildInfo.commit || '-'
  },

  onDestroy() {
    if (this._timeInterval) clearInterval(this._timeInterval)
  },

  updateTime() {
    const now = new Date()
    this.currentTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`
  },

  goBack() {
    router.back()
  },

  pressDown(key) {
    this.releasedKey = ''
    this.pressedKey = key
  },

  pressRelease(key) {
    this.pressedKey = ''
    this.releasedKey = key
    setTimeout(() => {
      if (this.releasedKey === key) this.releasedKey = ''
    }, 270)
  },

  pressCancel(key) {
    if (this.pressedKey === key) this.pressedKey = ''
    if (this.releasedKey === key) this.releasedKey = ''
  }
}
</script>
