<import
    name="input-method"
    src="../../components/InputMethod/InputMethod.ux"
></import>

<import
    name="numpad"
    src="../../components/NumPad/NumPad.ux"
></import>

<import
    name="handwriting-pad"
    src="../../components/HandwritingPad/HandwritingPad.ux"
></import>

<template>
  <div class="page-container">
    <!-- Header: identical to pair.ux -->
    <div class="header">
      <text
        class="title pressable {{ pressedKey === 'back' ? 'is-down press-down' : '' }} {{ releasedKey === 'back' ? 'press-up' : '' }}"
        ontouchstart="pressDown('back')"
        ontouchend="pressRelease('back')"
        ontouchcancel="pressCancel('back')"
        @click="goBack"
      >‹{{ label }}</text>
    </div>

    <!-- 预览和确认行 -->
    <div class="input-row">
      <div class="preview-box {{ canUseHandwriting ? 'preview-box-compact' : 'preview-box-wide' }}">
        <text class="preview-text">{{ displayValue || ' ' }}</text>
        <text class="cursor">_</text>
      </div>

      <!-- 仅在非IP/端口且互联通道已连接时显示手写切换按钮 (强调色背景，黑色图标) -->
      <div
        if="{{ canUseHandwriting }}"
        class="mode-btn pressable {{ pressedKey === 'mode' ? 'is-down press-down' : '' }} {{ releasedKey === 'mode' ? 'press-up' : '' }}"
        ontouchstart="pressDown('mode')"
        ontouchend="pressRelease('mode')"
        ontouchcancel="pressCancel('mode')"
        @click="toggleHandwritingMode"
      >
        <image
          class="btn-icon"
          src="{{ keyboardMode === 'handwriting' ? '/common/icons/keyboard_32dp_000000_FILL0_wght400_GRAD0_opsz40.png' : '/common/icons/draw_32dp_000000_FILL0_wght400_GRAD0_opsz40.png' }}"
        ></image>
      </div>

      <!-- 确认按钮换成 check_small 黑色图标 -->
      <div
        class="confirm-button pressable {{ pressedKey === 'confirm' ? 'is-down press-down' : '' }} {{ releasedKey === 'confirm' ? 'press-up' : '' }}"
        ontouchstart="pressDown('confirm')"
        ontouchend="pressRelease('confirm')"
        ontouchcancel="pressCancel('confirm')"
        @click="onConfirm"
      >
        <image
          class="btn-icon"
          src="/common/icons/check_small_32dp_000000_FILL0_wght400_GRAD0_opsz40.png"
        ></image>
      </div>
    </div>

    <!-- 键盘区域 (恢复原始定位结构，确保全键盘正确定位与九宫格安全区) -->
    <div class="keyboard-area">
      <!-- 九宫格数字键盘 (恢复原 numpad-wrapper 保障底部 30px 安全区) -->
      <div class="numpad-wrapper">
        <numpad if="{{ keyboardMode === 'numpad' }}"
          @complete="onComplete"
          @delete="onDelete"
          @switchkeyboard="onSwitchToQwerty"
        ></numpad>
      </div>

      <!-- 全键盘输入法 (直接作为 keyboard-area 子节点，恢复原版无包裹布局) -->
      <input-method if="{{ keyboardMode === 'qwerty' }}"
        hide="{{ hide }}"
        keyboardtype="{{ keyboardtype }}"
        maxlength="20"
        vibratemode="{{ vibratemode }}"
        screentype="{{ screentype }}"
        @delete="onDelete"
        @complete="onComplete"
      ></input-method>

      <!-- 手写输入法 -->
      <handwriting-pad if="{{ keyboardMode === 'handwriting' }}"
        @complete="onComplete"
        @delete="onDelete"
        @switchkeyboard="onSwitchFromHandwriting"
      ></handwriting-pad>
    </div>
  </div>
</template>

<style>
.page-container {
  width: 100%;
  height: 100%;
  background-color: #000;
  position: relative;
}

/* ---- Header: identical to pair.ux ---- */
.header {
  width: 100%;
  height: 90px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000;
}
.title {
  font-size: 32px;
  font-weight: bold;
  color: #fff;
  text-align: center;
}

/* ---- Preview + Confirm in one row ---- */
.input-row {
  position: absolute;
  top: 90px;
  left: 0;
  right: 0;
  height: 60px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  padding: 0 20px;
}

.preview-box {
  height: 60px;
  padding: 0 16px;
  background-color: #2e323c;
  border-radius: 30px;
  border-width: 2px;
  border-style: solid;
  border-color: #bac3ff;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.preview-box-compact {
  width: 180px;
}

.preview-box-wide {
  width: 250px;
}

.preview-text {
  font-size: 28px;
  font-weight: bold;
  color: #fff;
  lines: 1;
  text-align: right;
}

.cursor {
  font-size: 28px;
  color: #bac3ff;
  font-weight: bold;
}

/* 切换手写键盘按钮：强调色圆形胶囊 */
.mode-btn {
  width: 60px;
  height: 60px;
  margin-left: 10px;
  border-radius: 30px;
  background-color: #bac3ff;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

/* 确认按钮：强调色圆形胶囊 */
.confirm-button {
  width: 60px;
  height: 60px;
  margin-left: 10px;
  border-radius: 30px;
  background-color: #bac3ff;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.btn-icon {
  width: 34px;
  height: 34px;
}

/* ---- 按压动画 ---- */
.pressable {
  transform-origin: 50% 50%;
  transform: scale(1);
  opacity: 1;
}
.is-down {
  opacity: 0.75;
}
.press-down {
  animation-name: PressDown;
  animation-duration: 80ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
.press-up {
  animation-name: PressUp;
  animation-duration: 140ms;
  animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes PressDown {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  100% {
    transform: scale(0.94);
    opacity: 0.75;
  }
}
@keyframes PressUp {
  0% {
    transform: scale(0.94);
    opacity: 0.75;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

/* ---- 键盘固定在底部 (恢复原版无 flex 干扰布局) ---- */
.keyboard-area {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  overflow: visible;
}
.numpad-wrapper {
  width: 100%;
}

/* ---- Circle screen ---- */
@media (shape: circle) {
  .preview-box-compact {
    width: 170px;
  }
  .preview-box-wide {
    width: 240px;
  }
  .mode-btn {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    margin-left: 8px;
  }
  .confirm-button {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    margin-left: 8px;
  }
  .numpad-wrapper {
    margin-bottom: 30px;
  }
}

/* ---- Rect screen ---- */
@media (shape: rect) {
  .header {
    height: 65px;
  }
  .input-row {
    top: 65px;
  }
  .preview-box-compact {
    width: 220px;
  }
  .preview-box-wide {
    width: 290px;
  }
}
</style>

<script>
import router from '@system.router'
import device from '@system.device'
import interconnectService from '../../services/interconnectService.js'

export default {
  public: {
    field: '',
    label: '',
    value: ''
  },
  private: {
    fieldName: '',
    keyboardtype: 'QWERTY',
    vibratemode: 'short',
    screentype: 'circle',
    textValue: '',
    displayValue: '',
    hide: false,
    pressedKey: '',
    releasedKey: '',
    keyboardMode: 'qwerty',
    lastKeyboardMode: 'qwerty',
    canUseHandwriting: false,
    interconnectConnected: false
  },

  onInit() {
    this.label = this.label || '输入'
    this.fieldName = this.field || ''
    this.textValue = this.value || ''

    // 根据字段决定初始键盘模式
    if (this.fieldName === 'serverPort' || this.fieldName === 'port') {
      // 端口：纯九宫格
      this.keyboardMode = 'numpad'
    } else if (this.fieldName === 'serverIp' || this.fieldName === 'ip') {
      // IP：默认九宫格，长按0可切换全键盘
      this.keyboardMode = 'numpad'
    } else {
      // 设备名称等：全键盘
      this.keyboardMode = 'qwerty'
    }

    this.updateHandwritingAvailability()
    this.updateDisplayValue()

    device.getInfo({
      success: (data) => {
        if (data.screenShape) {
          this.screentype = data.screenShape
          this.updateDisplayValue()
        }
      },
      fail: () => {}
    })
  },

  onShow() {
    this.updateHandwritingAvailability()
    this.updateDisplayValue()
  },

  updateHandwritingAvailability() {
    // 1. IP 和 端口等纯数字字段，绝不提供手写切换
    if (
      this.fieldName === 'serverPort' ||
      this.fieldName === 'port' ||
      this.fieldName === 'serverIp' ||
      this.fieldName === 'ip'
    ) {
      this.canUseHandwriting = false
      return
    }

    // 2. 仅在互联通道处于连接就绪状态时才显示切换手写
    const ready = interconnectService && typeof interconnectService.isReady === 'function'
      ? interconnectService.isReady()
      : false
    this.interconnectConnected = ready
    this.canUseHandwriting = ready
    this.updateDisplayValue()
  },

  // 文本过长时不显示省略号，截取末尾可视字符跟随光标
  updateDisplayValue() {
    const text = this.textValue || ''
    if (!text) {
      this.displayValue = ''
      return
    }

    // 字符视觉单位计算：半角算 1，全角/中文算 2
    const isCircle = this.screentype === 'circle'
    const isCompact = this.canUseHandwriting

    let maxUnits = 12
    if (isCircle) {
      maxUnits = isCompact ? 8 : 13
    } else {
      maxUnits = isCompact ? 11 : 16
    }

    let currentUnits = 0
    let startIndex = text.length

    for (let i = text.length - 1; i >= 0; i--) {
      const code = text.charCodeAt(i)
      const weight = code > 255 ? 2 : 1
      if (currentUnits + weight > maxUnits) {
        break
      }
      currentUnits += weight
      startIndex = i
    }

    this.displayValue = text.slice(startIndex)
  },

  // 长按数字0：单向切换到全键盘
  onSwitchToQwerty() {
    this.keyboardMode = 'qwerty'
  },

  goBack() {
    router.back()
  },

  toggleHandwritingMode() {
    if (this.keyboardMode === 'handwriting') {
      this.keyboardMode = this.lastKeyboardMode || 'qwerty'
    } else {
      this.lastKeyboardMode = this.keyboardMode
      this.keyboardMode = 'handwriting'
    }
  },

  onSwitchFromHandwriting() {
    this.keyboardMode = this.lastKeyboardMode || 'qwerty'
  },

  onComplete(evt) {
    this.textValue += evt.detail.content
    this.updateDisplayValue()
  },

  onDelete() {
    this.textValue = this.textValue.slice(0, -1)
    this.updateDisplayValue()
  },

  onConfirm() {
    if (!this.$app || !this.$app.$def) {
      console.error('[keyboard] app global data is not available')
      return
    }
    this.$app.$def.keyboardResult = {
      field: this.fieldName,
      value: this.textValue
    }
    router.back()
  },

  pressDown(key) {
    this.releasedKey = ''
    this.pressedKey = key
  },

  pressRelease(key) {
    this.pressedKey = ''
    this.releasedKey = key
    setTimeout(() => {
      if (this.releasedKey === key) this.releasedKey = ''
    }, 160)
  },

  pressCancel(key) {
    if (this.pressedKey === key) this.pressedKey = ''
    if (this.releasedKey === key) this.releasedKey = ''
  }
}
</script>
