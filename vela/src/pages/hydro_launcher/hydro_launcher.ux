<template>
  <div class="page-container">
    <!-- Header -->
    <div class="header">
      <text class="time-display">{{ currentTime }}</text>
      <text
        class="title pressable {{ pressedKey === 'back' ? 'is-down press-down' : '' }} {{ releasedKey === 'back' ? 'press-up' : '' }}"
        ontouchstart="pressDown('back')"
        ontouchend="pressRelease('back')"
        ontouchcancel="pressCancel('back')"
        onclick="goBack"
      >‹HydroApps</text>
    </div>

    <div class="center-area" if="{{ loading }}">
      <image class="spin" src="/common/icons/progress-activity.png"></image>
      <text class="hint">加载中...</text>
    </div>
    <div class="center-area" if="{{ errorText }}">
      <text class="err">{{ errorText }}</text>
    </div>

    <scroll class="scroll-area" scroll-y="true" show="{{ !loading && !errorText }}">
      <div class="list">
        <div for="{{ (pi, plugin) in plugins }}">
          <text class="plugin-name">{{ plugin.package.name || plugin.package.id }}</text>
          <div
            for="{{ (ai, app) in plugin.apps }}"
            class="app-row pressable {{ pressedKey === 'app_' + pi + '_' + ai ? 'is-down press-down' : '' }} {{ releasedKey === 'app_' + pi + '_' + ai ? 'press-up' : '' }}"
            ontouchstart="pressDown('app_' + pi + '_' + ai)"
            ontouchend="pressRelease('app_' + pi + '_' + ai)"
            ontouchcancel="pressCancel('app_' + pi + '_' + ai)"
            onclick="openApp(plugin.package.id, app.id, app.name)"
          >
            <text class="app-name">{{ app.name || app.id }}</text>
            <text class="chevron">›</text>
          </div>
        </div>
      </div>
    </scroll>
  </div>
</template>

<style>
.page-container {
  width: 100%;
  height: 100%;
  background-color: #000;
  position: relative;
}
.header {
  width: 100%;
  height: 90px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000;
}
.time-display { font-size: 28px; font-weight: bold; color: #fff; padding-top: 5px; text-align: center; }
.title { font-size: 32px; font-weight: bold; color: #fff; text-align: center; }
/* 加载/错误块：头部以下区域垂直居中，绝不与头部(含返回按钮)重叠 */
.center-area {
  position: absolute; left: 0; right: 0;
  top: 90px; bottom: 0;
  flex-direction: column; align-items: center; justify-content: center;
}
.spin { width: 56px; height: 56px; }
.hint { color: #888; font-size: 20px; margin-top: 8px; }
.err { color: #ffb4ab; font-size: 24px; }
.scroll-area { position: absolute; top: 90px; bottom: 0; left: 0; right: 0; }
.list { width: 100%; flex-direction: column; padding: 10px 20px 30px; }
.plugin-name {
  font-size: 20px; color: #888; font-weight: bold;
  margin-top: 12px; margin-bottom: 6px;
}
.app-row {
  width: 100%; height: 84px;
  background-color: #2e323c; border-radius: 42px;
  flex-direction: row; justify-content: space-between; align-items: center;
  padding: 0 24px; margin-bottom: 8px;
}
.app-name { font-size: 26px; font-weight: bold; color: #fff; }
.chevron { font-size: 30px; color: #888; }

.pressable { transform-origin: 50% 50%; transform: scale(1); opacity: 1; }
.is-down { opacity: 0.75; }
.press-down { animation-name: PressDown; animation-duration: 80ms; animation-timing-function: ease-out; animation-iteration-count: 1; animation-fill-mode: forwards; }
.press-up { animation-name: PressUp; animation-duration: 140ms; animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1); animation-iteration-count: 1; animation-fill-mode: forwards; }
@keyframes PressDown { 0% { transform: scale(1); opacity: 1; } 100% { transform: scale(0.94); opacity: 0.75; } }
@keyframes PressUp { 0% { transform: scale(0.94); opacity: 0.75; } 100% { transform: scale(1); opacity: 1; } }

@media (shape: rect) {
  .header { height: 65px; flex-direction: row-reverse; justify-content: space-between; align-items: center; padding: 0 36px; }
  .title { margin-left: 8px; }
  .time-display { margin-right: 8px; }
  .scroll-area { top: 65px; }
  .center-area { top: 65px; }
}
</style>

<script>
import router from '@system.router'
import deviceService from '../../services/deviceService.js'

export default {
  protected: {
    host: '',
    port: 0,
    deviceId: ''
  },

  private: {
    currentTime: '00:00',
    plugins: [],
    loading: true,
    errorText: '',
    pressedKey: '',
    releasedKey: ''
  },

  onInit() {
    this.updateTime()
    this._timeInterval = setInterval(() => this.updateTime(), 60000)
    this.load()
  },

  onDestroy() {
    if (this._timeInterval) clearInterval(this._timeInterval)
  },

  updateTime() {
    const now = new Date()
    this.currentTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`
  },

  async load() {
    this.loading = true
    this.errorText = ''
    const data = await deviceService.hydro(this.host, this.port, '/api/hydro/list', 'GET')
    this.loading = false
    if (!data || !data.plugins) {
      this.errorText = '加载失败，请检查服务端'
      return
    }
    this.plugins = data.plugins.filter((p) => p.apps && p.apps.length > 0)
    if (this.plugins.length === 0) {
      this.errorText = '暂无 HydroApps'
    }
  },

  openApp(packageId, appId, appName) {
    router.push({
      uri: '/pages/hydro',
      params: {
        plugin: packageId,
        surface: 'app',
        item: appId,
        host: this.host || '',
        port: String(this.port || 0),
        deviceId: this.deviceId || ''
      }
    })
  },

  goBack() {
    router.back()
  },

  pressDown(key) { this.releasedKey = ''; this.pressedKey = key },
  pressRelease(key) {
    this.pressedKey = ''
    this.releasedKey = key
    setTimeout(() => { if (this.releasedKey === key) this.releasedKey = '' }, 160)
  },
  pressCancel(key) {
    if (this.pressedKey === key) this.pressedKey = ''
    if (this.releasedKey === key) this.releasedKey = ''
  }
}
</script>
