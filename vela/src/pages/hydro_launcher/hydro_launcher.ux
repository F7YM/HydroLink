<template>
  <div class="page-container">
    <!-- Header -->
    <div class="header">
      <text class="time-display">{{ currentTime }}</text>
      <text
        class="title pressable {{ pressedKey === 'back' ? 'is-down press-down' : '' }} {{ releasedKey === 'back' ? 'press-up' : '' }}"
        ontouchstart="pressDown('back')"
        ontouchend="pressRelease('back')"
        ontouchcancel="pressCancel('back')"
        onclick="goBack"
      >‹HydroApps</text>
    </div>

    <div class="center-area" if="{{ loading }}">
      <image class="spin" src="/common/icons/progress-activity.png"></image>
      <text class="hint">加载中...</text>
    </div>
    <div class="center-area" if="{{ errorText }}">
      <text class="err">{{ errorText }}</text>
    </div>
    <div class="center-area" if="{{ emptyText }}">
      <text class="empty-text">{{ emptyText }}</text>
    </div>

    <scroll class="scroll-area" scroll-y="true" bounces="true" show="{{ !loading && !errorText && !emptyText }}">
      <div class="list">
        <!-- 列表式（默认） -->
        <div
          if="{{ viewStyle !== 'grid' }}"
          for="{{ (i, item) in apps }}"
          class="app-row pressable {{ pressedKey === 'app_' + i ? 'is-down' : '' }}"
          ontouchstart="pressDown('app_' + i)"
          ontouchend="pressRelease('app_' + i)"
          ontouchcancel="pressCancel('app_' + i)"
          onclick="openApp(item.packageId, item.app.id, item.app.icon)"
        >
          <div class="app-left">
            <!-- 有图标就显示图标（宿主已在 /api/hydro/list 里解析成可取 URL）；
                 没有就用名字首字兜底，避免空白 -->
            <image if="{{ item.app.icon }}" class="app-icon" src="{{ item.app.icon }}"></image>
            <div if="{{ !item.app.icon }}" class="app-icon app-icon-fallback">
              <text class="app-icon-letter">{{ item.app.name[0] || '?' }}</text>
            </div>
            <text class="app-name">{{ item.app.name || item.app.id }}</text>
          </div>
          <text class="chevron">›</text>
        </div>

        <!-- 图标式（每行 3 个：圆形图标 + 下方应用名称） -->
        <div
          if="{{ viewStyle === 'grid' }}"
          for="{{ (ri, row) in appRows }}"
          class="grid-row"
        >
          <div
            for="{{ (ci, cell) in row }}"
            class="grid-item pressable {{ pressedKey === 'grid_' + cell.idx ? 'is-down' : '' }}"
            ontouchstart="pressDown('grid_' + cell.idx)"
            ontouchend="pressRelease('grid_' + cell.idx)"
            ontouchcancel="pressCancel('grid_' + cell.idx)"
            onclick="openApp(cell.packageId, cell.app.id, cell.app.icon)"
          >
            <image if="{{ cell.app.icon }}" class="grid-icon" src="{{ cell.app.icon }}"></image>
            <div if="{{ !cell.app.icon }}" class="grid-icon grid-icon-fallback">
              <text class="grid-icon-letter">{{ cell.app.name[0] || '?' }}</text>
            </div>
            <text class="grid-name">{{ cell.app.name || cell.app.id }}</text>
          </div>
        </div>

        <!-- 底部安全区占位（与 home/settings 同一手法）：圆屏下最后一行能滚到
             圆心中段、不被底部弧线切；触底时留出回弹空间。 -->
        <div class="list-bottom-space"></div>
      </div>
    </scroll>
  </div>
</template>

<style>
.page-container {
  width: 100%;
  height: 100%;
  background-color: #000;
  position: relative;
}
.header {
  width: 100%;
  height: 90px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000;
}
.time-display { font-size: 28px; font-weight: bold; color: #fff; padding-top: 5px; text-align: center; }
.title { font-size: 32px; font-weight: bold; color: #fff; text-align: center; }
/* 加载/错误块：头部以下区域垂直居中，绝不与头部(含返回按钮)重叠 */
.center-area {
  position: absolute; left: 0; right: 0;
  top: 90px; bottom: 0;
  flex-direction: column; align-items: center; justify-content: center;
}
.spin { width: 56px; height: 56px; }
.hint { color: #888; font-size: 20px; margin-top: 8px; }
.err { color: #ffb4ab; font-size: 24px; }
.empty-text { color: #9aa2b1; font-size: 24px; }
.scroll-area {
  position: absolute;
  top: 90px;
  bottom: 0;          /* 与 commandList/settings 一致：定高用 top/bottom 撑满剩余可视高度 */
  left: 0;
  right: 0;
  width: 100%;
  flex-direction: column;
}
.list { width: 100%; flex-direction: column; padding: 10px 20px 0; }
/* 底部安全区占位：内容不足时不显眼，内容多时保证最后一行不被圆屏弧线切、并给触底回弹留空间 */
.list-bottom-space { width: 100%; height: 40px; flex-shrink: 0; }
.app-left { flex-direction: row; align-items: center; flex: 1; }
.app-icon {
  width: 56px; height: 56px; border-radius: 28px;
  margin-left: 8px; margin-right: 18px;   /* 与文字之间留出间距 */
}
.app-icon-fallback {
  background-color: #3d4350;
  justify-content: center; align-items: center;
}
.app-icon-letter { font-size: 26px; font-weight: bold; color: #cfd6e4; }
.app-row {
  flex-shrink: 0;   /* 固定高度行别被 flex 压扁（设置页踩过的坑） */
  width: 100%; height: 84px;
  background-color: #2e323c; border-radius: 42px;
  flex-direction: row; justify-content: space-between; align-items: center;
  padding: 0 24px; margin-bottom: 8px;
}.app-name { font-size: 26px; font-weight: bold; color: #fff; }
.chevron { font-size: 30px; color: #888; }

.grid-row {
  width: 100%;
  flex-direction: row;
  justify-content: flex-start;
  align-items: flex-start;
  margin-bottom: 18px;
  flex-shrink: 0;
}
.grid-item {
  width: 33.33%;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}
.grid-icon {
  width: 84px;
  height: 84px;
  border-radius: 42px;
  margin-bottom: 8px;
}
.grid-icon-fallback {
  background-color: #2e323c;
  justify-content: center;
  align-items: center;
}
.grid-icon-letter {
  font-size: 34px;
  font-weight: bold;
  color: #cfd6e4;
}
.grid-name {
  font-size: 22px;
  font-weight: bold;
  color: #fff;
  lines: 1;
  text-overflow: ellipsis;
  max-width: 120px;
  text-align: center;
}

.pressable { transform-origin: 50% 50%; transform: scale(1); opacity: 1; }
.is-down { opacity: 0.75; }
.press-down { animation-name: PressDown; animation-duration: 150ms; animation-timing-function: ease-out; animation-iteration-count: 1; animation-fill-mode: forwards; }
.press-up { animation-name: PressUp; animation-duration: 250ms; animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1); animation-iteration-count: 1; animation-fill-mode: forwards; }
@keyframes PressDown { 0% { transform: scale(1); opacity: 1; } 100% { transform: scale(0.94); opacity: 0.75; } }
@keyframes PressUp { 0% { transform: scale(0.94); opacity: 0.75; } 100% { transform: scale(1); opacity: 1; } }

/* 圆屏安全区：左右边距与主页设备列表（400px 卡片，左右各 40px）统一，
   底部安全区与新手引导配对页（80px）统一。 */
@media (shape: circle) {
  .list { padding-left: 40px; padding-right: 40px; }
  .list-bottom-space { height: 80px; }
}

@media (shape: rect) {
  .header { height: 65px; flex-direction: row-reverse; justify-content: space-between; align-items: center; padding: 0 36px; }
  .title { margin-left: 8px; }
  .time-display { margin-right: 8px; }
  .scroll-area { top: 65px; }
  .center-area { top: 65px; }
}
</style>

<script>
import router from '@system.router'
import deviceService from '../../services/deviceService.js'
import settingsService from '../../services/settingsService.js'

export default {
  protected: {
    host: '',
    port: 0,
    deviceId: ''
  },

  private: {
    currentTime: '00:00',
    viewStyle: 'grid',
    plugins: [],
    // 扁平化的 HydroApp 列表：每项 { packageId, app }。
    // 渲染成一层 row，避免嵌套 for 的外层 div 默认 row 把同插件多条 App 排成横排。
    apps: [],
    appRows: [],
    loading: true,
    errorText: '',
    emptyText: '',
    pressedKey: '',
    releasedKey: ''
  },

  onInit() {
    this.updateTime()
    this._timeInterval = setInterval(() => this.updateTime(), 1000)
    this.loadViewStyle()
    // 先用缓存渲染（切页面回来不闪加载中），再静默刷新
    const cached = deviceService.peekCache('pluginlist', this.host || this.deviceId)
    if (cached) {
      this.plugins = cached
      this.apps = this.flatten(cached)
      this.appRows = this.chunkRows(this.apps)
      this.loading = false
    }
    this.load()
  },

  onShow() {
    this.updateTime()
    this.loadViewStyle()
  },

  async loadViewStyle() {
    try {
      this.viewStyle = await settingsService.getHydroAppsStyle()
    } catch (e) {
      this.viewStyle = 'grid'
    }
  },

  onDestroy() {
    if (this._timeInterval) clearInterval(this._timeInterval)
  },

  updateTime() {
    const now = new Date()
    this.currentTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`
  },

  async load() {
    this.errorText = ''
    this.emptyText = ''
    // 有缓存就不显示加载态
    this.loading = !this.plugins || this.plugins.length === 0
    const data = await deviceService.hydro(this.host, this.port, '/api/hydro/list', 'GET')
    this.loading = false
    if (!data || !data.plugins) {
      this.errorText = '加载失败，请检查服务端'
      return
    }
    this.plugins = data.plugins.filter((p) => p.apps && p.apps.length > 0)
    this.apps = this.flatten(this.plugins)
    this.appRows = this.chunkRows(this.apps)
    deviceService.putCache('pluginlist', this.host || this.deviceId, this.plugins)
    if (this.apps.length === 0) {
      this.emptyText = '暂无 HydroApps'
    }
  },

  /** 把 {plugins:[{package,apps[]}]} 摊平成 [{packageId, app}]，供单层列表渲染。 */
  flatten(plugins) {
    const out = []
    const list = plugins || []
    for (let pi = 0; pi < list.length; pi++) {
      const plugin = list[pi]
      const apps = (plugin && plugin.apps) || []
      for (let ai = 0; ai < apps.length; ai++) {
        out.push({ packageId: plugin.package.id, app: apps[ai] })
      }
    }
    return out
  },

  /** 把扁平 apps 按每行 3 个分组，供图标式网格渲染。 */
  chunkRows(apps) {
    const rows = []
    const list = apps || []
    for (let i = 0; i < list.length; i += 3) {
      const row = []
      for (let j = i; j < i + 3 && j < list.length; j++) {
        row.push({ idx: j, packageId: list[j].packageId, app: list[j].app })
      }
      rows.push(row)
    }
    return rows
  },

  openApp(packageId, appId, appIcon) {
    router.push({
      uri: '/pages/hydro',
      params: {
        plugin: packageId,
        surface: 'app',
        item: appId,
        host: this.host || '',
        port: String(this.port || 0),
        deviceId: this.deviceId || '',
        appIcon: appIcon || ''
      }
    })
  },

  goBack() {
    router.back()
  },

  pressDown(key) { this.releasedKey = ''; this.pressedKey = key },
  pressRelease(key) {
    this.pressedKey = ''
    this.releasedKey = key
    setTimeout(() => { if (this.releasedKey === key) this.releasedKey = '' }, 270)
  },
  pressCancel(key) {
    if (this.pressedKey === key) this.pressedKey = ''
    if (this.releasedKey === key) this.releasedKey = ''
  }
}
</script>
