<template>
  <div class="page-container">
    <!-- Header -->
    <div class="header">
      <text class="time-display">{{ currentTime }}</text>
      <text
        class="title pressable {{ pressedKey === 'back' ? 'is-down press-down' : '' }} {{ releasedKey === 'back' ? 'press-up' : '' }}"
        ontouchstart="pressDown('back')"
        ontouchend="pressRelease('back')"
        ontouchcancel="pressCancel('back')"
        onclick="goBack"
      >‹关于</text>
    </div>

    <!-- Content list -->
    <scroll class="scroll-area" scroll-y="true" bounces="true">
      <div class="about-list">
        <!-- 主开发者 -->
        <div class="section-header">
          <text class="section-title">主开发者</text>
        </div>
        <div class="person-card">
          <image class="avatar" src="/common/avatars/avatar_float11.jpg"></image>
          <text class="person-name">Float11</text>
        </div>

        <!-- 特别鸣谢 -->
        <div class="section-header">
          <text class="section-title">特别鸣谢</text>
        </div>
        <div class="person-card">
          <image class="avatar" src="/common/avatars/avatar_zxxhcj.jpg"></image>
          <text class="person-name">zxxhcj</text>
        </div>
        <div class="person-card">
          <image class="avatar" src="/common/avatars/avatar_orpudding.jpg"></image>
          <text class="person-name">OrPudding</text>
        </div>

        <!-- 底部安全区占位 -->
        <div class="list-bottom-space"></div>
      </div>
    </scroll>
  </div>
</template>

<style>
.page-container {
  width: 100%;
  height: 100%;
  background-color: #000;
  position: relative;
}

/* ---- Header ---- */
.header {
  width: 100%;
  height: 90px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000;
}
.time-display {
  font-size: 28px;
  font-weight: bold;
  color: #fff;
  padding-top: 5px;
  text-align: center;
}
.title {
  font-size: 32px;
  font-weight: bold;
  color: #fff;
  text-align: center;
}

/* ---- Scroll Area ---- */
.scroll-area {
  position: absolute;
  top: 90px;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  flex-direction: column;
  align-items: center;
}
.about-list {
  width: 100%;
  flex-direction: column;
  align-items: center;
  padding-top: 10px;
}
.list-bottom-space {
  width: 100%;
  height: 40px;
  flex-shrink: 0;
}

/* ---- Section Header ---- */
.section-header {
  width: 420px;
  margin-top: 16px;
  margin-bottom: 8px;
  padding: 0 16px;
}
.section-title {
  font-size: 20px;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.6);
}

/* ---- Person Card ---- */
.person-card {
  width: 420px;
  height: 96px;
  margin: 0 0 12px 0;
  padding: 0 24px;
  background-color: #2e323c;
  border-radius: 48px;
  flex-direction: row;
  justify-content: flex-start;
  align-items: center;
}
.avatar {
  width: 56px;
  height: 56px;
  border-radius: 28px;
  margin-right: 20px;
}
.person-name {
  font-size: 26px;
  font-weight: bold;
  color: #fff;
  lines: 1;
  text-overflow: ellipsis;
}

/* ---- Pressable effect ---- */
.pressable {
  transform-origin: 50% 50%;
  transform: scale(1);
  opacity: 1;
}
.is-down {
  opacity: 0.75;
}
.press-down {
  animation-name: PressDown;
  animation-duration: 80ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
.press-up {
  animation-name: PressUp;
  animation-duration: 140ms;
  animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes PressDown {
  0% { transform: scale(1); opacity: 1; }
  100% { transform: scale(0.94); opacity: 0.75; }
}
@keyframes PressUp {
  0% { transform: scale(0.94); opacity: 0.75; }
  100% { transform: scale(1); opacity: 1; }
}

/* ---- Circle screen adaptation ---- */
@media (shape: circle) {
  .list-bottom-space {
    height: 140px;
  }
  .about-list {
    padding-top: 16px;
  }
  .section-header {
    width: 360px;
  }
  .person-card {
    width: 360px;
    height: 96px;
    border-radius: 48px;
  }
}

/* ---- Rect screen adaptation ---- */
@media (shape: rect) {
  .header {
    height: 65px;
    flex-direction: row-reverse;
    justify-content: space-between;
    align-items: center;
    padding: 0 48px;
  }
  .title {
    margin-left: 12px;
  }
  .time-display {
    margin-right: 12px;
  }
  .scroll-area {
    top: 65px;
    bottom: 0;
  }
  .about-list {
    padding-top: 10px;
  }
}
</style>

<script>
import router from '@system.router'

export default {
  private: {
    currentTime: '00:00',
    pressedKey: '',
    releasedKey: ''
  },

  onInit() {
    this.updateTime()
    this._timeInterval = setInterval(() => this.updateTime(), 60000)
  },

  onDestroy() {
    if (this._timeInterval) clearInterval(this._timeInterval)
  },

  updateTime() {
    const now = new Date()
    this.currentTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`
  },

  goBack() {
    router.back()
  },

  pressDown(key) {
    this.releasedKey = ''
    this.pressedKey = key
  },

  pressRelease(key) {
    this.pressedKey = ''
    this.releasedKey = key
    setTimeout(() => {
      if (this.releasedKey === key) this.releasedKey = ''
    }, 160)
  },

  pressCancel(key) {
    if (this.pressedKey === key) this.pressedKey = ''
    if (this.releasedKey === key) this.releasedKey = ''
  }
}
</script>
