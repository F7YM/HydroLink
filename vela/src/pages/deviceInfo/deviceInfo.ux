<script>
import router from '@system.router'
import prompt from '@system.prompt'
import deviceService from '../../services/deviceService.js'

function getBatteryIcon(percent, charging) {
  if (charging) return 'battery-charging-custom'
  if (percent >= 100) return 'battery-custom'
  const tens = Math.floor(percent / 10) * 10
  if (tens === 0) return 'battery-10-custom'
  if (tens >= 90) return 'battery-90-custom'
  return `battery-${tens}-custom`
}

// ---- 组件卡（Widget 表面）构建函数 ----
const CARD_ICONS = {
  play: '/common/icons/play-custom.png',
  pause: '/common/icons/pause-custom.png',
  next: '/common/icons/skip-next-custom.png',
  prev: '/common/icons/skip-previous-custom.png',
  music: '/common/icons/music-circle-custom.png',
  lock: '/common/icons/lock-custom.png',
  gauge: '/common/icons/gauge-custom.png',
  battery: '/common/icons/battery-custom.png',
  laptop: '/common/icons/laptop.png',
  desktop: '/common/icons/desktop.png',
  mobile: '/common/icons/mobile.png'
}

function cssVal(v) {
  return typeof v === 'number' ? v + 'px' : String(v)
}
function toCss(o) {
  if (!o || typeof o !== 'object') return ''
  const parts = []
  Object.keys(o).forEach((k) => {
    const v = o[k]
    if (v === null || v === undefined) return
    parts.push((k === 'weight' ? 'font-weight' : k.replace(/([A-Z])/g, '-$1').toLowerCase()) + ': ' + cssVal(v))
  })
  return parts.join('; ')
}

// 卡片叶子：白名单（无 nav/scroll/input/switch）；button 支持 action:'open' 跳转 HydroApp
function buildCardLeaf(n, plugin) {
  const p = n.props || {}
  const type = n.type || ''
  const isText = type === 'text'
  const isBtn = type === 'button'
  const isBadge = type === 'badge'
  const isSpin = type === 'spinner'
  const isIcon = type === 'icon'
  const isImg = type === 'image'
  const open = p.action === 'open'
  let st = toCss(n.style)
  if (isText && !(n.style && typeof n.style.color === 'string')) {
    st = 'color: #FFFFFF; ' + st
  }
  return {
    c: false,
    t: type,
    s: st,
    v: (type === 'input' ? (p.value || '') : (p.text || '')),
    label: p.label || '',
    placeholder: p.placeholder || '',
    chk: !!(p.checked),
    src: p.src || '',
    iconSrc: isIcon ? (CARD_ICONS[p.name] || '') : '',
    tap: (n.events && n.events.tap) || '',
    change: (n.events && n.events.change) || '',
    openAction: open ? 'open' : '',
    openSurface: p.surface || 'app',
    openItem: p.item || '',
    plugin: plugin || '',
    isText: isText,
    isBtn: isBtn,
    isSw: false,
    isBadge: isBadge,
    isSpin: isSpin,
    isIcon: isIcon,
    isImg: isImg,
    isInput: false,
    isNav: false,
    isOther: !(isText || isBtn || isBadge || isSpin || isIcon || isImg)
  }
}

function buildCard(n, plugin) {
  if (!n) return null
  const hasKids = !!(n.children && n.children.length)
  if (hasKids) {
    return {
      c: true,
      s: 'width: 100%; flex-direction: ' + (n.type === 'row' ? 'row' : 'column') + '; ' + toCss(n.style),
      kids: n.children.map((c) => buildCardLeaf(c, plugin))
    }
  }
  return buildCardLeaf(n, plugin)
}

export default {
  public: {
    deviceId: '',
    icHost: '',
    icPort: 0
  },
  private: {
    device: {},
    deviceName: '',
    currentTime: '00:00',
    loading: true,
    osVersion: '',
    hasBattery: false,
    batteryPercent: 0,
    batteryIcon: '',
    hasMusic: false,
    musicTitle: '',
    musicArtist: '',
    musicPlaying: false,
    pressedKey: '',
    releasedKey: '',
    hasWidgets: false,
    widgetCards: []
  },

  onInit() {
    this.updateTime()
    this._timeInterval = setInterval(() => this.updateTime(), 60000)
  },

  onDestroy() {
    if (this._timeInterval) clearInterval(this._timeInterval)
    this.stopMusicPoll()
    this.stopWidgetPoll()
  },

  async onShow() {
    this.updateTime()
    await this.loadDevice()
    await this.fetchStatus()
    this.fetchMusic()
    this.startMusicPoll()
    this.loadWidgets()
  },

  onHide() {
    this.stopMusicPoll()
    this.stopWidgetPoll()
  },

  // ---- 组件卡片（Widget 表面）----
  async loadWidgets() {
    this.stopWidgetPoll()
    const host = this.device.host || ''
    const port = this.device.port || 0
    this.widgetCards = []
    this.hasWidgets = false
    if (!host) return
    try {
      const data = await deviceService.hydro(host, port, '/api/hydro/list', 'GET')
      if (!data || !data.plugins) return
      const cards = []
      for (const plugin of data.plugins) {
        for (const w of (plugin.widgets || [])) {
          const pid = plugin.package.id
          const view = await deviceService.hydro(host, port,
            '/api/hydro/' + pid + '/widget/' + w.id + '/view', 'GET')
          if (view && view.root) {
            cards.push({
              plugin: pid,
              id: w.id,
              name: w.name || w.id,
              refreshMs: view.refreshMs || w.refreshMs || 0,
              ui: (view.root.children || []).map((c) => buildCard(c, pid))
            })
          }
        }
      }
      this.widgetCards = cards
      this.hasWidgets = cards.length > 0
      this._startWidgetPoll()
    } catch (e) {
      console.error('[deviceInfo] loadWidgets failed', e)
    }
  },

  _startWidgetPoll() {
    this.stopWidgetPoll()
    this._widgetTimers = []
    this.widgetCards.forEach((card) => {
      if (card.refreshMs > 0) {
        this._widgetTimers.push(setInterval(() => this._refreshWidget(card.plugin, card.id), card.refreshMs))
      }
    })
  },

  stopWidgetPoll() {
    if (this._widgetTimers) {
      this._widgetTimers.forEach((t) => clearInterval(t))
      this._widgetTimers = []
    }
  },

  async _refreshWidget(pkg, id) {
    const host = this.device.host || ''
    const port = this.device.port || 0
    if (!host) return
    const view = await deviceService.hydro(host, port,
      '/api/hydro/' + pkg + '/widget/' + id + '/refresh', 'GET')
    if (!view || !view.root) return
    const idx = this.widgetCards.findIndex((c) => c.plugin === pkg && c.id === id)
    if (idx >= 0) {
      this.widgetCards.splice(idx, 1, Object.assign({}, this.widgetCards[idx], {
        ui: (view.root.children || []).map((c) => buildCard(c, pkg))
      }))
    }
  },

  _unwrap(evt) {
    return evt && evt.detail !== undefined && evt.detail !== null ? evt.detail : evt
  },

  // 卡片不默认跳转；仅按钮(action:'open')跳转 HydroApp；其余事件照常上报
  onCardTap(evt) {
    const leaf = this._unwrap(evt)
    if (!leaf) return
    if (leaf.openAction === 'open') {
      router.push({
        uri: '/pages/hydro',
        params: {
          plugin: leaf.plugin || '',
          surface: leaf.openSurface || 'app',
          item: leaf.openItem || '',
          host: this.device.host || '',
          port: String(this.device.port || 0),
          deviceId: this.deviceId || ''
        }
      })
      return
    }
    if (leaf.tap) {
      deviceService.hydro(this.device.host || '', this.device.port || 0,
        '/api/hydro/' + leaf.plugin + '/widget/' + this.widgetIdOfLeaf(leaf) + '/event',
        'POST', { event: { handler: leaf.tap, source: 'tap' } })
    }
  },

  onCardChange(evt) {
    const leaf = this._unwrap(evt)
    if (!leaf || !leaf.change) return
    deviceService.hydro(this.device.host || '', this.device.port || 0,
      '/api/hydro/' + leaf.plugin + '/widget/' + this.widgetIdOfLeaf(leaf) + '/event',
      'POST', { event: { handler: leaf.change, source: 'change' } })
  },

  widgetIdOfLeaf(leaf) {
    const card = this.widgetCards.find((c) => c.plugin === leaf.plugin)
    return card ? card.id : ''
  },

  updateTime() {
    const now = new Date()
    this.currentTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`
  },

  async loadDevice() {
    if (this.deviceId === '__interconnect__' && this.icHost) {
      this.device = {
        id: '__interconnect__',
        name: 'HydroLink',
        host: this.icHost,
        port: this.icPort || 9000,
        deviceId: 'interconnect-device',
        deviceType: 'cellphone',
        viaInterconnect: true
      }
      this.deviceName = this.device.name
      return
    }
    const dev = await deviceService.getDevice(this.deviceId)
    if (dev) {
      this.device = dev
      this.deviceName = dev.name || '设备详情'
    }
  },

  async fetchStatus() {
    this.loading = true
    const dev = this.device
    if (!dev || !dev.host) {
      this.loading = false
      return
    }
    const sysInfo = await deviceService.getServerSystemInfo(
      dev.host, dev.port, dev.deviceId
    )
    this.osVersion = sysInfo.version || '未知系统'
    this.hasBattery = sysInfo.hasBattery
    this.batteryPercent = sysInfo.batteryPercent
    this.batteryIcon = getBatteryIcon(sysInfo.batteryPercent, sysInfo.batteryCharging)
    this.loading = false
    setTimeout(() => {
      const el = this.$element('osMarquee')
      if (el) el.start()
    }, 100)
  },

  goBack() {
    router.back()
  },

  async onLock() {
    const dev = this.device
    if (!dev || !dev.host || !dev.port) return
    prompt.showToast({ message: '正在锁屏...' })
    const res = await deviceService.sendCommand(
      dev.host, dev.port, dev.deviceId, '/api/lock', 'POST'
    )
    if (res && res.code === 200 && res.data && res.data.status === 'ok') {
      prompt.showToast({ message: '已锁屏' })
    } else {
      prompt.showToast({ message: '锁屏失败' })
    }
  },

  onQuickCommand() {
    router.push({
      uri: '/pages/commandList',
      params: {
        deviceId: this.deviceId,
        host: this.device.host || '',
        port: this.device.port || 0
      }
    })
  },

  onPerfView() {
    router.push({
      uri: '/pages/perfView',
      params: {
        deviceId: this.deviceId,
        host: this.device.host || '',
        port: this.device.port || 0
      }
    })
  },

  onHydroApps() {
    const dev = this.device || {}
    router.push({
      uri: '/pages/hydro_launcher',
      params: {
        deviceId: this.deviceId,
        host: dev.host || '',
        port: dev.port || 0
      }
    })
  },

  async fetchMusic() {
    const dev = this.device
    if (!dev || !dev.host) return
    try {
      const res = await deviceService.getMusicInfo(
        dev.host, dev.port, dev.deviceId
      )
      if (res && res.has_media) {
        this.hasMusic = true
        this.musicTitle = res.title || '未知曲目'
        this.musicArtist = res.artist || '未知艺术家'
        this.musicPlaying = !!res.playing
      } else {
        this.hasMusic = false
      }
    } catch (e) {
      // ignore
    }
  },

  startMusicPoll() {
    this.stopMusicPoll()
    this._musicInterval = setInterval(() => {
      this.fetchMusic()
    }, 3000)
  },

  stopMusicPoll() {
    if (this._musicInterval) {
      clearInterval(this._musicInterval)
      this._musicInterval = null
    }
  },

  async onMusicPlayPause() {
    const dev = this.device
    if (!dev || !dev.host) return
    const action = this.musicPlaying ? 'pause' : 'play'
    this.musicPlaying = !this.musicPlaying
    await deviceService.controlMusic(
      dev.host, dev.port, dev.deviceId, action
    )
    setTimeout(() => this.fetchMusic(), 800)
  },

  async onMusicNext() {
    const dev = this.device
    if (!dev || !dev.host) return
    await deviceService.controlMusic(
      dev.host, dev.port, dev.deviceId, 'next'
    )
    setTimeout(() => this.fetchMusic(), 800)
  },

  async onMusicPrev() {
    const dev = this.device
    if (!dev || !dev.host) return
    await deviceService.controlMusic(
      dev.host, dev.port, dev.deviceId, 'previous'
    )
    setTimeout(() => this.fetchMusic(), 800)
  },

  pressDown(key) {
    this.releasedKey = ''
    this.pressedKey = key
  },

  pressRelease(key) {
    this.pressedKey = ''
    this.releasedKey = key
    setTimeout(() => {
      if (this.releasedKey === key) this.releasedKey = ''
    }, 160)
  },

  pressCancel(key) {
    if (this.pressedKey === key) this.pressedKey = ''
    if (this.releasedKey === key) this.releasedKey = ''
  }
}
</script>
