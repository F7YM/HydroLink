<import name="hydro-leaf" src="../../components/HydroLeaf/HydroLeaf"></import>
<template>
  <div class="page-container">
    <!-- Header -->
    <div class="header">
      <text class="time-display">{{ currentTime }}</text>
      <text
        class="title pressable {{ pressedKey === 'back' ? 'is-down press-down' : '' }} {{ releasedKey === 'back' ? 'press-up' : '' }}"
        ontouchstart="pressDown('back')"
        ontouchend="pressRelease('back')"
        ontouchcancel="pressCancel('back')"
        onclick="goBack"
      >‹{{ deviceName }}</text>
    </div>

    <!-- Content -->
    <scroll class="content-area" scroll-y="true" bounces="true">
      <!-- Loading -->
      <div if="{{ loading }}" class="loading-state">
        <text class="loading-text">加载中...</text>
      </div>

      <!-- Loaded -->
      <div if="{{ !loading }}" class="card-wrapper">
        <div class="info-card">
          <!-- Left: device icon -->
          <div class="card-icon-area">
            <image class="card-device-icon" src="/common/icons/{{ device.deviceType }}.png"></image>
          </div>
          <!-- Right: OS + battery/IP -->
          <div class="card-info-area">
            <marquee
              id="osMarquee"
              class="os-text"
              scrollamount="{{ 6 }}"
              loop="{{ -1 }}"
            >{{ osVersion }}</marquee>

            <!-- Battery row -->
            <div if="{{ hasBattery }}" class="sub-row">
              <image class="battery-icon" src="/common/icons/{{ batteryIcon }}.png"></image>
              <text class="sub-text">{{ batteryPercent }}%</text>
            </div>
            <!-- IP row (no battery) -->
            <div if="{{ !hasBattery }}" class="sub-row">
              <text class="sub-text">{{ device.host }}:{{ device.port }}</text>
            </div>
          </div>
        </div>

        <!-- Quick Control Card -->
        <div class="control-card">
          <div
            class="control-item pressable {{ pressedKey === 'lock' ? 'is-down press-down' : '' }} {{ releasedKey === 'lock' ? 'press-up' : '' }}"
            ontouchstart="pressDown('lock')"
            ontouchend="pressRelease('lock')"
            ontouchcancel="pressCancel('lock')"
            onclick="onLock"
          >
            <div class="control-circle">
              <image class="control-icon" src="/common/icons/lock-custom.png"></image>
            </div>
            <text class="control-label">锁屏</text>
          </div>

          <div
            class="control-item pressable {{ pressedKey === 'command' ? 'is-down press-down' : '' }} {{ releasedKey === 'command' ? 'press-up' : '' }}"
            ontouchstart="pressDown('command')"
            ontouchend="pressRelease('command')"
            ontouchcancel="pressCancel('command')"
            onclick="onQuickCommand"
          >
            <div class="control-circle">
              <image class="control-icon" src="/common/icons/apple-keyboard-command-custom.png"></image>
            </div>
            <text class="control-label">快速命令</text>
          </div>

          <div
            class="control-item pressable {{ pressedKey === 'perf' ? 'is-down press-down' : '' }} {{ releasedKey === 'perf' ? 'press-up' : '' }}"
            ontouchstart="pressDown('perf')"
            ontouchend="pressRelease('perf')"
            ontouchcancel="pressCancel('perf')"
            onclick="onPerfView"
          >
            <div class="control-circle">
              <image class="control-icon" src="/common/icons/gauge-custom.png"></image>
            </div>
            <text class="control-label">性能</text>
          </div>

          <div
            class="control-item pressable {{ pressedKey === 'hydro' ? 'is-down press-down' : '' }} {{ releasedKey === 'hydro' ? 'press-up' : '' }}"
            ontouchstart="pressDown('hydro')"
            ontouchend="pressRelease('hydro')"
            ontouchcancel="pressCancel('hydro')"
            onclick="onHydroApps"
          >
            <div class="control-circle">
              <image class="control-icon" src="/common/icons/apps.png"></image>
            </div>
            <text class="control-label">HydroApps</text>
          </div>

        </div>

        <!-- Music Control Card -->
        <div if="{{ hasMusic }}" class="music-card">
          <div class="music-header">
            <div class="music-icon-circle">
              <image class="music-icon" src="/common/icons/music-circle-custom.png"></image>
            </div>
            <div class="music-text-area">
              <text class="music-title">{{ musicTitle }}</text>
              <text class="music-artist">{{ musicArtist }}</text>
            </div>
          </div>
          <div class="music-controls">
            <div
              class="music-btn pressable {{ pressedKey === 'mprev' ? 'is-down press-down' : '' }} {{ releasedKey === 'mprev' ? 'press-up' : '' }}"
              ontouchstart="pressDown('mprev')"
              ontouchend="pressRelease('mprev')"
              ontouchcancel="pressCancel('mprev')"
              onclick="onMusicPrev"
            >
              <image class="music-btn-icon" src="/common/icons/skip-previous-custom.png"></image>
            </div>

            <div
              class="music-btn-play pressable {{ pressedKey === 'mplay' ? 'is-down press-down' : '' }} {{ releasedKey === 'mplay' ? 'press-up' : '' }}"
              ontouchstart="pressDown('mplay')"
              ontouchend="pressRelease('mplay')"
              ontouchcancel="pressCancel('mplay')"
              onclick="onMusicPlayPause"
            >
              <image if="{{ musicPlaying }}" class="music-play-icon" src="/common/icons/pause-custom.png"></image>
              <image if="{{ !musicPlaying }}" class="music-play-icon" src="/common/icons/play-custom.png"></image>
            </div>

            <div
              class="music-btn pressable {{ pressedKey === 'mnext' ? 'is-down press-down' : '' }} {{ releasedKey === 'mnext' ? 'press-up' : '' }}"
              ontouchstart="pressDown('mnext')"
              ontouchend="pressRelease('mnext')"
              ontouchcancel="pressCancel('mnext')"
              onclick="onMusicNext"
            >
              <image class="music-btn-icon" src="/common/icons/skip-next-custom.png"></image>
            </div>
          </div>
        </div>

        <!-- HydroWidget 卡片区（与音乐卡同级的对齐上下文；卡片不跳转，button action:'open' 可跳转） -->
        <text class="widgets-title" show="{{ hasWidgets }}">HydroWidget</text>
        <div for="{{ (wi, wc) in widgetCards }}" class="widget-card" show="{{ hasWidgets }}">
          <text class="wcard-name">{{ wc.name }}</text>
          <div for="{{ (i1, l1) in wc.ui }}" style="width: 100%">
            <hydro-leaf if="{{ !l1.c }}" leaf="{{ l1 }}" @hydrotap="onCardTap" @change="onCardChange"></hydro-leaf>
            <div if="{{ l1.c }}" class="wrow" style="{{ l1.s }}">
              <div for="{{ (i2, l2) in l1.kids }}" style="width: 100%">
                <hydro-leaf leaf="{{ l2 }}" @hydrotap="onCardTap" @change="onCardChange"></hydro-leaf>
              </div>
            </div>
          </div>
        </div>
      </div>
    </scroll>
  </div>
</template>

