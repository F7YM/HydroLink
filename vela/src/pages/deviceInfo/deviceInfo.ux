  width: 76px;
  height: 76px;
  border-radius: 38px;
  background-color: #bac3ff;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin: 0 20px;
}
.music-btn-icon {
  width: 32px;
  height: 32px;
}
