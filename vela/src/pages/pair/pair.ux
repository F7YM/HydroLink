    width: 96px;
    height: 96px;
    border-radius: 48px;
  }
  .button-wrapper {
    padding-bottom: 120px;
  }
}

/* ---- Rect screen adaptation ---- */
@media (shape: rect) {
  .header {
    height: 65px;
    flex-direction: row-reverse;
    justify-content: space-between;
    align-items: center;
    padding: 0 48px;
  }
  .title {
    margin-left: 12px;
  }
  .time-display {
    margin-right: 12px;
  }
  .choose-area {
    top: 65px;
  }
  .scan-scroll {
    top: 65px;
  }
  .form-area {
    top: 65px;
  }
  .form-list {
    padding-top: 10px;
  }
  .button-wrapper {
    padding-bottom: 20px;
  }
