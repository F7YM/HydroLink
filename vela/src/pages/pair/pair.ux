  text-align: right;
}
.button-wrapper {
  width: 100%;
  flex-direction: column;
  align-items: center;
  margin-top: 30px;
  padding-bottom: 80px;
}
.pair-go {
  width: 104px;
  height: 104px;
  border-radius: 52px;
  background-color: #bac3ff;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}
.pair-go-icon {
  width: 48px;
  height: 48px;
}

/* 转圈动画 */
.spinner {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
