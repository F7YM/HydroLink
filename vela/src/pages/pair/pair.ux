<template>
  <div class="page-container">
    <!-- Header -->
    <div class="header">
      <text class="time-display">{{ currentTime }}</text>
      <text
        class="title pressable {{ pressedKey === 'back' ? 'is-down press-down' : '' }} {{ releasedKey === 'back' ? 'press-up' : '' }}"
        ontouchstart="pressDown('back')"
        ontouchend="pressRelease('back')"
        ontouchcancel="pressCancel('back')"
        onclick="onHeaderBack"
      >{{ viewMode === 'choose' ? '‹添加设备' : (viewMode === 'scan' ? '‹扫描设备' : '‹配对新设备') }}</text>
    </div>

    <!-- ================= 模式 1: 选择添加方式 (连接着 interconnect) ================= -->
    <div if="{{ viewMode === 'choose' }}" class="choose-area">
      <div class="choose-list">
        <!-- 选项一：尝试自动扫描设备 -->
        <div
          class="option-card pressable {{ pressedKey === 'opt_scan' ? 'is-down press-down' : '' }} {{ releasedKey === 'opt_scan' ? 'press-up' : '' }}"
          ontouchstart="pressDown('opt_scan')"
          ontouchend="pressRelease('opt_scan')"
          ontouchcancel="pressCancel('opt_scan')"
          onclick="chooseScan"
        >
          <div class="option-icon-box">
            <image class="option-icon" src="/common/icons/desktop.png"></image>
          </div>
          <div class="option-info">
            <text class="option-title">尝试自动扫描设备</text>
            <text class="option-desc">自动发现局域网内的设备</text>
          </div>
          <text class="option-chevron">›</text>
        </div>

        <!-- 选项二：通过 IP 地址手动添加设备 -->
        <div
          class="option-card pressable {{ pressedKey === 'opt_manual' ? 'is-down press-down' : '' }} {{ releasedKey === 'opt_manual' ? 'press-up' : '' }}"
          ontouchstart="pressDown('opt_manual')"
          ontouchend="pressRelease('opt_manual')"
          ontouchcancel="pressCancel('opt_manual')"
          onclick="chooseManual"
        >
          <div class="option-icon-box">
            <image class="option-icon" src="/common/icons/arrow-forward.png"></image>
          </div>
          <div class="option-info">
            <text class="option-title">通过 IP 地址手动添加设备</text>
            <text class="option-desc">手动输入 IP 地址与端口</text>
          </div>
          <text class="option-chevron">›</text>
        </div>
      </div>
    </div>

    <!-- ================= 模式 2: 自动扫描设备 ================= -->
    <scroll if="{{ viewMode === 'scan' }}" class="scan-scroll" scroll-y="true" bounces="true">
      <div class="scan-content">
        <!-- 正在扫描中状态 -->
        <div if="{{ lanScanning }}" class="scanning-box">
          <div class="spinner">
            <image class="spinner-img" src="/common/icons/progress-activity.png"></image>
          </div>
          <text class="scanning-tip">正在扫描局域网设备...</text>
        </div>

        <!-- 扫描完成：发现设备列表 -->
        <div if="{{ !lanScanning && lanDevices.length > 0 }}" class="lan-section">
          <div class="section-header">
            <text class="section-title">发现局域网设备 ({{ lanDevices.length }})</text>
            <div
              class="rescan-btn pressable {{ pressedKey === 'rescan' ? 'is-down press-down' : '' }} {{ releasedKey === 'rescan' ? 'press-up' : '' }}"
              ontouchstart="pressDown('rescan')"
              ontouchend="pressRelease('rescan')"
              ontouchcancel="pressCancel('rescan')"
              onclick="startScan"
            >
              <text class="rescan-btn-text">重新扫描</text>
            </div>
          </div>

          <div class="lan-list">
            <div
              for="{{ (index, dev) in lanDevices }}"
              class="device-card {{ dev.isAdded ? 'is-added' : 'pressable' }} {{ pressedKey === 'lan_' + index ? 'is-down press-down' : '' }} {{ releasedKey === 'lan_' + index ? 'press-up' : '' }}"
              ontouchstart="pressDown('lan_' + index)"
              ontouchend="pressRelease('lan_' + index)"
              ontouchcancel="pressCancel('lan_' + index)"
              onclick="addLanDevice(dev)"
            >
              <image class="card-icon {{ dev.isAdded ? 'icon-disabled' : '' }}" src="/common/icons/{{ dev.device_type === 'cellphone' ? 'cellphone' : (dev.device_type === 'laptop' ? 'laptop' : 'desktop') }}.png"></image>
              <div class="card-info">
                <text class="card-name {{ dev.isAdded ? 'text-disabled' : '' }}">{{ dev.name }}</text>
                <text class="card-sub {{ dev.isAdded ? 'sub-disabled' : '' }}">{{ dev.host }}:{{ dev.port }}</text>
              </div>
              <text if="{{ !dev.isAdded }}" class="badge-add">+</text>
              <text if="{{ dev.isAdded }}" class="badge-added">已添加</text>
            </div>
          </div>
        </div>

        <!-- 扫描完成：未发现设备 -->
        <div if="{{ !lanScanning && lanDevices.length === 0 }}" class="empty-box">
          <text class="empty-title">未发现局域网设备</text>
          <text class="empty-sub">请确保设备已启动并在同一网络</text>
          <div
            class="action-btn pressable {{ pressedKey === 'rescan_empty' ? 'is-down press-down' : '' }} {{ releasedKey === 'rescan_empty' ? 'press-up' : '' }}"
            ontouchstart="pressDown('rescan_empty')"
            ontouchend="pressRelease('rescan_empty')"
            ontouchcancel="pressCancel('rescan_empty')"
            onclick="startScan"
          >
            <text class="action-btn-text">重新扫描</text>
          </div>
        </div>

        <!-- 底部切换到手动输入 -->
        <div
          class="manual-switch-btn pressable {{ pressedKey === 'switch_manual' ? 'is-down press-down' : '' }} {{ releasedKey === 'switch_manual' ? 'press-up' : '' }}"
          ontouchstart="pressDown('switch_manual')"
          ontouchend="pressRelease('switch_manual')"
          ontouchcancel="pressCancel('switch_manual')"
          onclick="chooseManual"
        >
          <text class="manual-switch-text">通过 IP 地址手动添加设备 ›</text>
        </div>

        <!-- 底部安全区占位 -->
        <div class="list-bottom-space"></div>
      </div>
    </scroll>

    <!-- ================= 模式 3: 手动输入 IP ================= -->
    <div if="{{ viewMode === 'manual' }}" class="form-area">
      <div class="form-list">
        <!-- Server IP -->
        <div
          class="form-item pressable {{ pressedKey === 'serverIp' ? 'is-down press-down' : '' }} {{ releasedKey === 'serverIp' ? 'press-up' : '' }}"
          ontouchstart="pressDown('serverIp')"
          ontouchend="pressRelease('serverIp')"
          ontouchcancel="pressCancel('serverIp')"
          onclick="() => onFieldClick('serverIp', '服务器IP')"
        >
          <text class="form-label">服务器IP</text>
          <text class="form-value">{{ serverIp || '点击输入' }}</text>
        </div>

        <!-- Port -->
        <div
          class="form-item pressable {{ pressedKey === 'serverPort' ? 'is-down press-down' : '' }} {{ releasedKey === 'serverPort' ? 'press-up' : '' }}"
          ontouchstart="pressDown('serverPort')"
          ontouchend="pressRelease('serverPort')"
          ontouchcancel="pressCancel('serverPort')"
          onclick="() => onFieldClick('serverPort', '端口')"
        >
          <text class="form-label">端口</text>
          <text class="form-value">{{ serverPort || '点击输入' }}</text>
        </div>

        <!-- Device Name -->
        <div
          class="form-item pressable {{ pressedKey === 'deviceName' ? 'is-down press-down' : '' }} {{ releasedKey === 'deviceName' ? 'press-up' : '' }}"
          ontouchstart="pressDown('deviceName')"
          ontouchend="pressRelease('deviceName')"
          ontouchcancel="pressCancel('deviceName')"
          onclick="() => onFieldClick('deviceName', '设备名称')"
        >
          <text class="form-label">设备名称</text>
          <text class="form-value">{{ deviceName || '自动获取' }}</text>
        </div>
      </div>

      <!-- Pair button -->
      <div class="button-wrapper">
        <div
          class="pair-go pressable {{ pressedKey === 'pairGo' ? 'is-down press-down' : '' }} {{ releasedKey === 'pairGo' ? 'press-up' : '' }}"
          ontouchstart="pressDown('pairGo')"
          ontouchend="pressRelease('pairGo')"
          ontouchcancel="pressCancel('pairGo')"
          onclick="onPair"
        >
          <image class="pair-go-icon" src="/common/icons/arrow-forward.png"></image>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
