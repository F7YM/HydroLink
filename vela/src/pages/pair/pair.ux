</style>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import interconnectService from '../../services/interconnectService.js'
import deviceService from '../../services/deviceService.js'

export default {
  private: {
    currentTime: '00:00',
    isIcConnected: false,
    viewMode: 'manual', // 'choose' | 'scan' | 'manual'
    serverIp: '',
    serverPort: '9000',
    deviceName: '',
    lanScanning: false,
    lanDevices: [],
    pressedKey: '',
    releasedKey: ''
  },

  onInit() {
    this.updateTime()
    this._timeInterval = setInterval(() => this.updateTime(), 60000)

    // 检查是否连接着 interconnect
    interconnectService.ensureInit()
    const icReady = interconnectService.isReady()
    this.isIcConnected = !!icReady
    this.viewMode = icReady ? 'choose' : 'manual'
  },

  onDestroy() {
    if (this._timeInterval) clearInterval(this._timeInterval)
  },

  updateTime() {
    const now = new Date()
    this.currentTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`
  },

  onShow() {
    // 从 app.ux 导出的全局对象读取键盘结果
    const appDef = this.$app && this.$app.$def
    const result = appDef ? appDef.keyboardResult : null
    if (result) {
      if (result.field === 'serverIp') {
        this.serverIp = result.value
      } else if (result.field === 'serverPort') {
        this.serverPort = result.value
      } else if (result.field === 'deviceName') {
        this.deviceName = result.value
      }
      appDef.keyboardResult = null
    }
  },

  onHeaderBack() {
    if (this.viewMode === 'scan') {
      this.viewMode = 'choose'
      return
    }
    if (this.viewMode === 'manual' && this.isIcConnected) {
      this.viewMode = 'choose'
      return
    }
    router.back()
  },

  chooseScan() {
    this.viewMode = 'scan'
    this.startScan()
  },

  chooseManual() {
    this.viewMode = 'manual'
  },

  async startScan() {
    if (this.lanScanning) return
    this.lanScanning = true
    try {
      const devices = await interconnectService.discoverLan()
      let saved = []
      try {
        saved = (await deviceService.getDevices()) || []
      } catch (err) {
        console.warn('[pair] getDevices error', err)
      }
      const savedKeys = new Set(saved.map(d => `${d.host}:${d.port || 9000}`))

      if (devices && Array.isArray(devices)) {
        const uniqueKeys = new Set()
        const list = []
        for (const dev of devices) {
          const key = `${dev.host}:${dev.port || 9000}`
          if (!uniqueKeys.has(key)) {
            uniqueKeys.add(key)
            list.push(Object.assign({}, dev, { isAdded: savedKeys.has(key) }))
          }
        }
        this.lanDevices = list
      } else {
        this.lanDevices = []
      }
    } catch (e) {
      console.warn('[pair] scanLan error', e)
      this.lanDevices = []
    } finally {
      this.lanScanning = false
    }
  },

  addLanDevice(dev) {
    if (!dev || !dev.host) return
    if (dev.isAdded) {
      prompt.showToast({ message: '该设备已在列表中' })
      return
    }
    router.push({
      uri: '/pages/pairing',
      params: {
        serverIp: (dev.host || '').trim(),
        serverPort: String(dev.port || 9000),
        deviceName: (dev.name || '').trim()
      }
    })
  },

  onFieldClick(fieldName, label) {
    let currentValue = ''
    if (fieldName === 'serverIp') currentValue = this.serverIp
    else if (fieldName === 'serverPort') currentValue = this.serverPort
    else if (fieldName === 'deviceName') currentValue = this.deviceName

    router.push({
      uri: '/pages/keyboard',
      params: {
        field: fieldName,
        label: label,
        value: currentValue
      }
    })
  },

  onPair() {
    if (!this.serverIp) {
      prompt.showToast({ message: '请输入服务器IP' })
      return
    }
    if (!this.serverPort) {
      prompt.showToast({ message: '请输入端口' })
      return
    }
    const port = parseInt(this.serverPort, 10)
    if (isNaN(port) || port < 1 || port > 65535) {
      prompt.showToast({ message: '端口无效' })
      return
    }

    router.push({
      uri: '/pages/pairing',
      params: {
        serverIp: this.serverIp.trim(),
        serverPort: String(port),
        deviceName: (this.deviceName || '').trim()
      }
    })
  },

  pressDown(key) {
    this.releasedKey = ''
    this.pressedKey = key
  },

  pressRelease(key) {
    this.pressedKey = ''
    this.releasedKey = key
    setTimeout(() => {
      if (this.releasedKey === key) this.releasedKey = ''
    }, 160)
  },

  pressCancel(key) {
    if (this.pressedKey === key) this.pressedKey = ''
    if (this.releasedKey === key) this.releasedKey = ''
  }
}
</script>
