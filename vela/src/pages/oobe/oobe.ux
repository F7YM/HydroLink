  align-items: center;
}
.indicator-row {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 14px;
}
.dot {
  width: 8px;
  height: 8px;
  border-radius: 4px;
  background-color: #5a6270;
  margin: 0 4px;
}
.dot-active {
  width: 24px;
  height: 8px;
  border-radius: 4px;
  background-color: #bac3ff;
}

/* Arrow FAB (仅一个箭头) */
.arrow-fab {
  width: 72px;
  height: 72px;
  border-radius: 36px;
  background-color: #bac3ff;
  justify-content: center;
  align-items: center;
}
.arrow-icon {
  width: 36px;
  height: 36px;
}

/* Spin animation */
.spin {
  animation-name: leaf-spin;
  animation-duration: 900ms;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}
@keyframes leaf-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Pressable feedback */
.pressable {
  transform-origin: 50% 50%;
  transform: scale(1);
  opacity: 1;
}
.is-down {
  opacity: 0.75;
}
.press-down {
  animation-name: PressDown;
  animation-duration: 80ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
.press-up {
  animation-name: PressUp;
  animation-duration: 140ms;
  animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes PressDown {
  0% { transform: scale(1); opacity: 1; }
  100% { transform: scale(0.94); opacity: 0.75; }
}
@keyframes PressUp {
  0% { transform: scale(0.94); opacity: 0.75; }
  100% { transform: scale(1); opacity: 1; }
}
</style>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import settingsService from '../../services/settingsService.js'
import interconnectService from '../../services/interconnectService.js'
import deviceService from '../../services/deviceService.js'

export default {
  private: {
    step: 0,
    currentTime: '00:00',
    pressedKey: '',
    releasedKey: '',
    // Step 3 states
    icConnected: false,
    icDeviceName: '',
    skippedInterconnect: false,
    lanScanning: false,
    lanDevices: []
  },

  onInit() {
    this.updateTime()
    this._timeInterval = setInterval(() => this.updateTime(), 60000)
    // 预初始化 Interconnect 监听
    this.initInterconnect()
  },

  onDestroy() {
    if (this._timeInterval) clearInterval(this._timeInterval)
  },

  updateTime() {
    const now = new Date()
    this.currentTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`
  },

  initInterconnect() {
    try {
      interconnectService.ensureInit()
      interconnectService.setServerInfoHandler((info) => {
        this.icConnected = true
        if (info && info.name) this.icDeviceName = info.name
        // 发现伴侣后自动启动局域网其他设备扫描
        if (this.step === 3 && !this.lanScanning) {
          this.startLanScan()
        }
      })
      if (interconnectService.isReady()) {
        this.icConnected = true
      }
    } catch (e) {
      console.warn('[oobe] initInterconnect failed', e)
    }
  },

  nextStep() {
    if (this.step < 3) {
      this.step += 1
      if (this.step === 3) {
        this.onEnterStep3()
      }
    }
  },

  prevStep() {
    if (this.step > 0) {
      this.step -= 1
    }
  },

  async skipOobe() {
    await settingsService.setOobeCompleted(true)
    router.replace({ uri: '/pages/home' })
  },

  onEnterStep3() {
    // 检查互联状态
    if (interconnectService.isReady()) {
      this.icConnected = true
      this.startLanScan()
    } else {
      interconnectService.discoverServer()
        .then((info) => {
          this.icConnected = true
          if (info && info.name) this.icDeviceName = info.name
          this.startLanScan()
        })
        .catch(() => {
          // 伴侣未就绪，保持等待态
        })
    }
  },

  skipInterconnect() {
    this.skippedInterconnect = true
  },

  async startLanScan() {
    this.lanScanning = true
    try {
      const devices = await interconnectService.discoverLan()
      if (devices && Array.isArray(devices)) {
        this.lanDevices = devices
      }
    } catch (e) {
      console.warn('[oobe] discoverLan error', e)
    } finally {
      this.lanScanning = false
    }
  },

  async addLanDevice(dev) {
    if (!dev) return
    try {
      await deviceService.addDevice({
        name: dev.name,
        host: dev.host,
        port: dev.port || 9000,
        deviceType: dev.device_type || 'desktop'
      })
      prompt.showToast({ message: `已添加 ${dev.name}` })
    } catch (e) {
      prompt.showToast({ message: '添加失败' })
    }
  },

  openManualPair() {
    router.push({ uri: '/pages/pair' })
  },

  async finishOobe() {
    await settingsService.setOobeCompleted(true)
    router.replace({ uri: '/pages/home' })
  },

  pressDown(key) {
    this.releasedKey = ''
    this.pressedKey = key
  },

  pressRelease(key) {
    this.pressedKey = ''
    this.releasedKey = key
    setTimeout(() => {
      if (this.releasedKey === key) this.releasedKey = ''
    }, 160)
  },

  pressCancel(key) {
    if (this.pressedKey === key) this.pressedKey = ''
    if (this.releasedKey === key) this.releasedKey = ''
  }
}
</script>
