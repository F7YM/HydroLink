</style>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import settingsService from '../../services/settingsService.js'
import interconnectService from '../../services/interconnectService.js'
import deviceService from '../../services/deviceService.js'

export default {
  private: {
    step: 0,
    currentTime: '00:00',
    pressedKey: '',
    releasedKey: '',
    // Step 3 states
    icConnected: false,
    icDeviceName: '',
    skippedInterconnect: false,
    lanScanning: false,
    lanDevices: [],
    savedDevices: []
  },

  onInit() {
    this.updateTime()
    this._timeInterval = setInterval(() => this.updateTime(), 1000)
    // 预初始化 Interconnect 监听
    this.initInterconnect()
    this.loadSavedDevices()
  },

  onShow() {
    // 页面可见时（如配对返回），立即重新加载已添加设备
    this.loadSavedDevices()
  },

  onDestroy() {
    if (this._timeInterval) clearInterval(this._timeInterval)
    this.stopContinuousLanScan()
  },

  updateTime() {
    const now = new Date()
    this.currentTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`
  },

  scrollToTop() {
    setTimeout(() => {
      try {
        const el = this.$element('oobeScroll')
        if (el && typeof el.scrollTo === 'function') {
          el.scrollTo({ top: 0, left: 0, behavior: 'instant' })
        }
      } catch (e) {
        console.warn('[oobe] scrollToTop error', e)
      }
    }, 20)
  },

  initInterconnect() {
    try {
      interconnectService.ensureInit()
      interconnectService.setServerInfoHandler((info) => {
        if (!info || !info.host) {
          this.icConnected = false
          return
        }
        this.icConnected = true
        if (info.name) this.icDeviceName = info.name
        // 发现伴侣后，若处于 Step 3 且未跳过互联，立即触发并启动局域网持续扫描
        if (this.step === 3 && !this.skippedInterconnect) {
          this.startContinuousLanScan()
        }
      })
      if (interconnectService.isReady()) {
        this.icConnected = true
      }
    } catch (e) {
      console.warn('[oobe] initInterconnect failed', e)
    }
  },

  nextStep() {
    if (this.step < 3) {
      this.step += 1
      this.scrollToTop()
      if (this.step === 3) {
        this.onEnterStep3()
      }
    }
  },

  onEnterStep3() {
    // 检查互联状态
    if (interconnectService.isReady()) {
      this.icConnected = true
      this.startContinuousLanScan()
    } else {
      interconnectService.discoverServer()
        .then((info) => {
          this.icConnected = true
          if (info && info.name) this.icDeviceName = info.name
          this.startContinuousLanScan()
        })
        .catch(() => {
          // 伴侣未就绪，保持等待态
        })
    }
  },

  skipInterconnect() {
    this.skippedInterconnect = true
    this.stopContinuousLanScan()
  },

  startContinuousLanScan() {
    if (this._lanScanInterval) return
    this.scanLanOnce()
    // 持续轮询扫描：每 4.5 秒探测一次，平滑合并新设备
    this._lanScanInterval = setInterval(() => {
      if (this.step === 3 && !this.skippedInterconnect && !this.lanScanning) {
        this.scanLanOnce()
      }
    }, 4500)
  },

  stopContinuousLanScan() {
    if (this._lanScanInterval) {
      clearInterval(this._lanScanInterval)
      this._lanScanInterval = null
    }
  },

  async loadSavedDevices() {
    try {
      const devices = await deviceService.getDevices()
      this.savedDevices = devices || []
      this.syncAddedFlags()
    } catch (e) {
      this.savedDevices = []
    }
  },

  syncAddedFlags() {
    if (!this.lanDevices || this.lanDevices.length === 0) return
    const savedKeys = new Set((this.savedDevices || []).map(d => `${d.host}:${d.port || 9000}`))
    this.lanDevices = this.lanDevices.map(dev => {
      const key = `${dev.host}:${dev.port || 9000}`
      return Object.assign({}, dev, { isAdded: savedKeys.has(key) })
    })
  },

  async scanLanOnce() {
    this.lanScanning = true
    try {
      const devices = await interconnectService.discoverLan()
      if (devices && Array.isArray(devices)) {
        const savedKeys = new Set((this.savedDevices || []).map(d => `${d.host}:${d.port || 9000}`))
        // 合并去重：保留现有设备列表，将新探测到的设备追加进列表
        const existingKeys = new Set(this.lanDevices.map(d => `${d.host}:${d.port}`))
        const updated = [...this.lanDevices]
        for (const d of devices) {
          const key = `${d.host}:${d.port}`
          if (!existingKeys.has(key)) {
            existingKeys.add(key)
            updated.push(Object.assign({}, d, { isAdded: savedKeys.has(key) }))
          }
        }
        this.lanDevices = updated
      }
    } catch (e) {
      console.warn('[oobe] discoverLan error', e)
    } finally {
      this.lanScanning = false
    }
  },

  addLanDevice(dev) {
    if (!dev || !dev.host) return
    if (dev.isAdded) {
      prompt.showToast({ message: '该设备已在列表中' })
      return
    }
    router.push({
      uri: '/pages/pairing',
      params: {
        serverIp: (dev.host || '').trim(),
        serverPort: String(dev.port || 9000),
        deviceName: (dev.name || '').trim()
      }
    })
  },

  openManualPair() {
    router.push({ uri: '/pages/pair' })
  },

  async finishOobe() {
    await settingsService.setOobeCompleted(true)
    router.replace({ uri: '/pages/home' })
  },

  pressDown(key) {
    this.releasedKey = ''
    this.pressedKey = key
  },

  pressRelease(key) {
    this.pressedKey = ''
    this.releasedKey = key
    setTimeout(() => {
      if (this.releasedKey === key) this.releasedKey = ''
    }, 270)
  },

  pressCancel(key) {
    if (this.pressedKey === key) this.pressedKey = ''
    if (this.releasedKey === key) this.releasedKey = ''
  }
}
</script>
