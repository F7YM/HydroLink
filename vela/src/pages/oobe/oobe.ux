  color: #bac3ff;
}

/* 转圈动画：对齐 pairing.ux 的容器转动规范，精准中心轴 (24px 24px) */
.spinner {
  width: 48px;
  height: 48px;
  margin-right: 14px;
  flex-shrink: 0;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  transform-origin: 24px 24px;
  animation-name: spin;
  animation-duration: 900ms;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}
.spinner-img {
  width: 48px;
  height: 48px;
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Pressable feedback */
.pressable {
  transform-origin: 50% 50%;
  transform: scale(1);
  opacity: 1;
}
.is-down {
  opacity: 0.75;
}
.press-down {
  animation-name: PressDown;
  animation-duration: 150ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
.press-up {
  animation-name: PressUp;
  animation-duration: 250ms;
  animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes PressDown {
  0% { transform: scale(1); opacity: 1; }
  100% { transform: scale(0.94); opacity: 0.75; }
}
@keyframes PressUp {
  0% { transform: scale(0.94); opacity: 0.75; }
  100% { transform: scale(1); opacity: 1; }
}

/* ---- Rect screen adaptation: 完全对齐 settings.ux ---- */
@media (shape: rect) {
  .header {
    height: 65px;
    flex-direction: row-reverse;
    justify-content: space-between;
    align-items: center;
    padding: 0 48px;
  }
  .title {
    margin-left: 12px;
  }
  .time-display {
    margin-right: 12px;
  }
  .scroll-area {
    top: 65px;
    bottom: 0;
  }
  .scroll-content {
    padding-top: 6px;
  }
  /* 方屏没有圆弧可贴：退回普通药丸按钮 */
  .edge-bg {
    display: none;
  }
  .edge-btn {
    height: 96px;
    border-radius: 48px;
    background-color: #bac3ff;
