<template>
  <div class="page-container">
    <!-- Header: 顶部常驻，含时间与返回/跳过 -->
    <div class="header">
      <div class="header-left">
        <text
          if="{{ step > 0 }}"
          class="nav-btn pressable {{ pressedKey === 'prev' ? 'is-down press-down' : '' }} {{ releasedKey === 'prev' ? 'press-up' : '' }}"
          ontouchstart="pressDown('prev')"
          ontouchend="pressRelease('prev')"
          ontouchcancel="pressCancel('prev')"
          onclick="prevStep"
        >‹</text>
      </div>
      <text class="time-display">{{ currentTime }}</text>
      <div class="header-right">
        <text
          if="{{ step < 3 }}"
          class="skip-btn pressable {{ pressedKey === 'skip' ? 'is-down press-down' : '' }} {{ releasedKey === 'skip' ? 'press-up' : '' }}"
          ontouchstart="pressDown('skip')"
          ontouchend="pressRelease('skip')"
          ontouchcancel="pressCancel('skip')"
          onclick="skipOobe"
        >跳过</text>
      </div>
    </div>

    <!-- Step 0: 欢迎页（纯净克制，仅标题 + 副标题“探索设备边界”，无任何长说明） -->
    <div if="{{ step === 0 }}" class="content-body center-flex">
      <image class="welcome-logo" src="/common/icon.png"></image>
      <text class="app-title">HydroLink</text>
      <text class="sub-title">探索设备边界</text>
    </div>

    <!-- Step 1: 多平台适配 -->
    <div if="{{ step === 1 }}" class="content-body">
      <text class="page-title">多平台适配</text>
      <div class="platforms-row">
        <image class="plat-icon" src="/common/icons/gauge-custom.png"></image>
        <image class="plat-icon" src="/common/icons/cellphone.png"></image>
        <image class="plat-icon" src="/common/icons/desktop.png"></image>
      </div>
      <div class="feature-card">
        <div class="feature-item">
          <text class="feat-title">跨端协同</text>
          <text class="feat-desc">手表、手机与桌面无缝互联</text>
        </div>
        <div class="feature-divider"></div>
        <div class="feature-item">
          <text class="feat-title">双通道链路</text>
          <text class="feat-desc">近场蓝牙伴侣 + Wi-Fi 局域网</text>
        </div>
      </div>
    </div>

    <!-- Step 2: 轻量扩展生态（抽象平台化，不提具体插件名） -->
    <div if="{{ step === 2 }}" class="content-body">
      <text class="page-title">轻量扩展生态</text>
      <div class="platforms-row">
        <image class="plat-icon" src="/common/icons/apps.png"></image>
      </div>
      <div class="feature-card">
        <div class="feature-item">
          <text class="feat-title">声明式视图</text>
          <text class="feat-desc">端侧动态下发，随需随用无需固件升级</text>
        </div>
        <div class="feature-divider"></div>
        <div class="feature-item">
          <text class="feat-title">沙箱与能力互通</text>
          <text class="feat-desc">安全轻量隔离，腕上与设备高效交互</text>
        </div>
      </div>
    </div>

    <!-- Step 3: 配对设备（核心连接流：interconnect 优先、可跳过、mDNS 自动发现、手动 IP） -->
    <div if="{{ step === 3 }}" class="content-body step3-body">
      <scroll class="step3-scroll" scroll-y="true" bounces="true">
        <text class="page-title">配对新设备</text>

        <!-- 1. Interconnect 互联卡片（优先） -->
        <div if="{{ !skippedInterconnect }}" class="ic-section">
          <!-- 已连接伴侣 -->
          <div if="{{ icConnected }}" class="device-card ic-active">
            <image class="card-icon" src="/common/icons/cellphone.png"></image>
            <div class="card-info">
              <text class="card-name">{{ icDeviceName || '手机伴侣已连接' }}</text>
              <text class="card-sub">Interconnect 蓝牙直连</text>
            </div>
            <text class="badge-done">已就绪</text>
          </div>

          <!-- 探测中 / 未连接 -->
          <div if="{{ !icConnected }}" class="device-card ic-pending">
            <image class="card-icon spin" src="/common/icons/progress-activity.png"></image>
            <div class="card-info">
              <text class="card-name">正在等待手机伴侣...</text>
              <text class="card-sub">请确保手机运行 HydroLink</text>
            </div>
          </div>

          <!-- 我没有安卓手机（跳过按钮） -->
          <div
            class="ghost-btn pressable {{ pressedKey === 'skipIc' ? 'is-down press-down' : '' }} {{ releasedKey === 'skipIc' ? 'press-up' : '' }}"
            ontouchstart="pressDown('skipIc')"
            ontouchend="pressRelease('skipIc')"
            ontouchcancel="pressCancel('skipIc')"
            onclick="skipInterconnect"
          >
            <text class="ghost-btn-text">我没有安卓手机 ›</text>
          </div>
        </div>

        <!-- 2. 局域网发现其他设备（走已连手机的 mDNS + Probe） -->
        <div class="lan-section">
          <div class="section-header">
            <text class="section-title">局域网发现设备</text>
            <text if="{{ lanScanning }}" class="scanning-text">扫描中...</text>
          </div>

          <!-- 发现的设备列表 -->
          <div if="{{ lanDevices.length > 0 }}" class="lan-list">
            <div
              for="{{ (index, dev) in lanDevices }}"
              class="device-card lan-item pressable {{ pressedKey === 'lan_' + index ? 'is-down press-down' : '' }} {{ releasedKey === 'lan_' + index ? 'press-up' : '' }}"
              ontouchstart="pressDown('lan_' + index)"
              ontouchend="pressRelease('lan_' + index)"
              ontouchcancel="pressCancel('lan_' + index)"
              onclick="addLanDevice(dev)"
            >
              <image class="card-icon" src="/common/icons/desktop.png"></image>
              <div class="card-info">
                <text class="card-name">{{ dev.name }}</text>
                <text class="card-sub">{{ dev.host }}:{{ dev.port }}</text>
              </div>
              <text class="badge-add">+</text>
            </div>
          </div>

          <div if="{{ lanDevices.length === 0 && !lanScanning }}" class="empty-lan">
            <text class="empty-tip">未发现局域网设备</text>
          </div>
        </div>

        <!-- 3. 手动输入 IP 选项 -->
        <div
          class="manual-btn pressable {{ pressedKey === 'manualIp' ? 'is-down press-down' : '' }} {{ releasedKey === 'manualIp' ? 'press-up' : '' }}"
          ontouchstart="pressDown('manualIp')"
          ontouchend="pressRelease('manualIp')"
          ontouchcancel="pressCancel('manualIp')"
          onclick="openManualPair"
        >
          <text class="manual-btn-text">⌨️ 手动输入 IP</text>
        </div>

        <!-- 完成进入主页按钮 -->
        <div
          class="finish-pill pressable {{ pressedKey === 'finish' ? 'is-down press-down' : '' }} {{ releasedKey === 'finish' ? 'press-up' : '' }}"
          ontouchstart="pressDown('finish')"
          ontouchend="pressRelease('finish')"
          ontouchcancel="pressCancel('finish')"
          onclick="finishOobe"
        >
          <text class="finish-pill-text">完成，进入 HydroLink</text>
        </div>

        <div class="scroll-bottom-space"></div>
      </scroll>
    </div>

    <!-- 底部控制栏：指示器 + 单个箭头按钮（Step 0 ~ 2 统一呈现） -->
    <div if="{{ step < 3 }}" class="bottom-bar">
      <!-- MD3 步进指示条 -->
      <div class="indicator-row">
        <div class="dot {{ step === 0 ? 'dot-active' : '' }}"></div>
        <div class="dot {{ step === 1 ? 'dot-active' : '' }}"></div>
        <div class="dot {{ step === 2 ? 'dot-active' : '' }}"></div>
        <div class="dot {{ step === 3 ? 'dot-active' : '' }}"></div>
      </div>

      <!-- 下一步按钮：仅一个箭头（MD3 圆钮） -->
      <div
        class="arrow-fab pressable {{ pressedKey === 'next' ? 'is-down press-down' : '' }} {{ releasedKey === 'next' ? 'press-up' : '' }}"
        ontouchstart="pressDown('next')"
        ontouchend="pressRelease('next')"
        ontouchcancel="pressCancel('next')"
        onclick="nextStep"
      >
        <image class="arrow-icon" src="/common/icons/arrow-forward.png"></image>
      </div>
    </div>
  </div>
</template>

<style>
