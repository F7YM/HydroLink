<template>
  <div class="page-container">
    <!-- Header -->
    <div class="header">
      <text class="time-display">{{ currentTime }}</text>
      <text
        class="title pressable {{ pressedKey === 'back' ? 'is-down press-down' : '' }} {{ releasedKey === 'back' ? 'press-up' : '' }}"
        ontouchstart="pressDown('back')"
        ontouchend="pressRelease('back')"
        ontouchcancel="pressCancel('back')"
        onclick="goBack"
      >‹HydroApps</text>
    </div>

    <scroll class="scroll-area" scroll-y="true" bounces="true">
      <div class="form-list">
        <div
          class="form-item pressable {{ pressedKey === 'style' ? 'is-down' : '' }}"
          ontouchstart="pressDown('style')"
          ontouchend="pressRelease('style')"
          ontouchcancel="pressCancel('style')"
          onclick="onOpenStyle"
        >
          <text class="form-label">列表样式</text>
          <text class="app-chevron">›</text>
        </div>
        <div class="list-bottom-space"></div>
      </div>
    </scroll>
  </div>
</template>

<style>
.page-container {
  width: 100%;
  height: 100%;
  background-color: #000;
  position: relative;
}

/* ---- Header ---- */
.header {
  width: 100%;
  height: 90px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000;
}
.time-display {
  font-size: 28px;
  font-weight: bold;
  color: #fff;
  padding-top: 5px;
  text-align: center;
}
.title {
  font-size: 32px;
  font-weight: bold;
  color: #fff;
  text-align: center;
}

/* ---- List ---- */
.scroll-area {
  position: absolute;
  top: 90px;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  flex-direction: column;
  align-items: center;
}
.form-list {
  width: 100%;
  flex-direction: column;
  align-items: center;
  padding-top: 20px;
}
.list-bottom-space {
  width: 100%;
  height: 40px;
  flex-shrink: 0;
}
.form-item {
  width: 420px;
  height: 96px;
  margin: 0 0 16px 0;
  padding: 0 24px;
  background-color: #2e323c;
  border-radius: 48px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.form-label {
  font-size: 24px;
  font-weight: bold;
  color: #fff;
  lines: 1;
  text-overflow: ellipsis;
  flex-grow: 1;
  margin-right: 16px;
}
.app-chevron {
  font-size: 32px;
  font-weight: bold;
  color: #888;
  margin-left: 8px;
}

.pressable {
  transform-origin: 50% 50%;
  transform: scale(1);
  opacity: 1;
}
.is-down {
  opacity: 0.75;
}
.press-down {
  animation-name: PressDown;
  animation-duration: 150ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
.press-up {
  animation-name: PressUp;
  animation-duration: 250ms;
  animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes PressDown {
  0% { transform: scale(1); opacity: 1; }
  100% { transform: scale(0.94); opacity: 0.75; }
}
@keyframes PressUp {
  0% { transform: scale(0.94); opacity: 0.75; }
  100% { transform: scale(1); opacity: 1; }
}

@media (shape: circle) {
  .list-bottom-space {
    height: 80px;
  }
  .form-list {
    padding-top: 24px;
  }
  .form-item {
    width: 400px;
    height: 100px;
    border-radius: 50px;
  }
}

@media (shape: rect) {
  .header {
    height: 65px;
    flex-direction: row-reverse;
    justify-content: space-between;
    align-items: center;
    padding: 0 48px;
  }
  .title {
    margin-left: 12px;
  }
  .time-display {
    margin-right: 12px;
  }
  .scroll-area {
    top: 65px;
    bottom: 0;
  }
  .form-list {
    padding-top: 10px;
  }
}
</style>

<script>
import router from '@system.router'

export default {
  private: {
    currentTime: '00:00',
    pressedKey: '',
    releasedKey: ''
  },

  onInit() {
    this.updateTime()
    this._timeInterval = setInterval(() => this.updateTime(), 1000)
  },

  onDestroy() {
    if (this._timeInterval) clearInterval(this._timeInterval)
  },

  updateTime() {
    const now = new Date()
    this.currentTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`
  },

  goBack() {
    router.back()
  },

  onOpenStyle() {
    router.push({ uri: '/pages/hydroAppStyle' })
  },

  pressDown(key) {
    this.releasedKey = ''
    this.pressedKey = key
  },

  pressRelease(key) {
    this.pressedKey = ''
    this.releasedKey = key
    setTimeout(() => {
      if (this.releasedKey === key) this.releasedKey = ''
    }, 270)
  },

  pressCancel(key) {
    if (this.pressedKey === key) this.pressedKey = ''
    if (this.releasedKey === key) this.releasedKey = ''
  }
}
</script>
