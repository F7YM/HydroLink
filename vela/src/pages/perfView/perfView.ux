  background-color: #3a3f4a;
}

/* ---- Bar Card ---- */
.bar-card {
  width: 400px;
  margin-top: 16px;
  background-color: #2e323c;
  border-radius: 40px;
  flex-direction: column;
  padding: 24px 32px;
}
.bar-section {
  flex-direction: column;
}
.bar-header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}
.bar-title {
  font-size: 24px;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.6);
}
.bar-percent {
  font-size: 24px;
  font-weight: bold;
  color: #fff;
}
.bar-horizontal {
  width: 100%;
  stroke-width: 10px;
  layer-color: #3a3f4a;
}
.bar-cpu {
  color: #bac3ff;
}
