  font-size: 28px;
  font-weight: bold;
  color: #888;
}

/* ---- Gauge Card ---- */
.gauge-card {
  width: 400px;
  height: 200px;
  background-color: #2e323c;
  border-radius: 50px;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  padding: 0 20px;
}
.gauge-item {
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.ring-wrapper {
  width: 120px;
  height: 120px;
  position: relative;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
/* Arc progress background ring (gray, full circle) */
.ring-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 120px;
  height: 120px;
  stroke-width: 10px;
  color: #3a3f4a;
  layer-color: #3a3f4a;
  start-angle: 240deg;
  total-angle: 240deg;
}
/* CPU arc ring (theme color) */
.ring-cpu {
  position: absolute;
  top: 0;
  left: 0;
  width: 120px;
  height: 120px;
  stroke-width: 10px;
  color: #bac3ff;
  layer-color: #3a3f4a;
  start-angle: 240deg;
  total-angle: 240deg;
}
/* Memory arc ring (theme color) */
.ring-mem {
  position: absolute;
  top: 0;
  left: 0;
  width: 120px;
  height: 120px;
  stroke-width: 10px;
  color: #bac3ff;
  layer-color: #3a3f4a;
  start-angle: 240deg;
  total-angle: 240deg;
}
.ring-center {
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.ring-value {
  font-size: 30px;
  font-weight: bold;
  color: #fff;
}
.ring-unit {
  font-size: 18px;
  font-weight: bold;
  color: #888;
  margin-top: 2px;
}
