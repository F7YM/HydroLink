<template>
  <div class="page-container">
    <!-- Header -->
    <div class="header">
      <text class="time-display">{{ currentTime }}</text>
      <text
        class="title pressable {{ pressedKey === 'back' ? 'is-down press-down' : '' }} {{ releasedKey === 'back' ? 'press-up' : '' }}"
        ontouchstart="pressDown('back')"
        ontouchend="pressRelease('back')"
        ontouchcancel="pressCancel('back')"
        onclick="goBack"
      >‹性能视图</text>
    </div>

    <!-- Content -->
    <scroll class="content-scroll" scroll-y="true" bounces="true">
      <div class="content-area">
        <!-- Loading -->
        <div if="{{ loading }}" class="loading-state">
          <text class="loading-text">加载中...</text>
        </div>

        <!-- Loaded -->
        <div if="{{ !loading }}" class="loaded-content">
          <!-- Gauge Card: CPU + Memory arc rings -->
          <div class="gauge-card">
            <!-- CPU Ring -->
            <div class="gauge-item">
              <div class="ring-wrapper">
                <progress
                  class="ring-bg"
                  percent="{{ 100 }}"
                  type="arc"
                ></progress>
                <progress
                  class="ring-cpu"
                  percent="{{ cpuPercent }}"
                  type="arc"
                ></progress>
                <div class="ring-center">
                  <text class="ring-value">{{ cpuDisplay }}</text>
                  <text class="ring-unit">%</text>
                </div>
              </div>
              <text class="gauge-label">CPU</text>
            </div>

            <!-- Divider -->
            <div class="gauge-divider"></div>

            <!-- Memory Ring -->
            <div class="gauge-item">
              <div class="ring-wrapper">
                <progress
                  class="ring-bg"
                  percent="{{ 100 }}"
                  type="arc"
                ></progress>
                <progress
                  class="ring-mem"
                  percent="{{ memPercent }}"
                  type="arc"
                ></progress>
                <div class="ring-center">
                  <text class="ring-value">{{ memDisplay }}</text>
                  <text class="ring-unit">%</text>
                </div>
              </div>
              <text class="gauge-label">内存</text>
            </div>
          </div>

          <!-- Detail Card: Memory info -->
          <div class="detail-card">
            <div class="detail-row">
              <text class="detail-label">已用内存</text>
              <text class="detail-value">{{ memUsedDisplay }}</text>
            </div>
            <div class="detail-separator"></div>
            <div class="detail-row">
              <text class="detail-label">总内存</text>
              <text class="detail-value">{{ memTotalDisplay }}</text>
            </div>
            <div class="detail-separator"></div>
            <div class="detail-row">
              <text class="detail-label">可用内存</text>
              <text class="detail-value">{{ memAvailDisplay }}</text>
            </div>
          </div>

          <!-- Bar Card: Horizontal progress bars -->
          <div class="bar-card">
            <!-- CPU Bar -->
            <div class="bar-section">
              <div class="bar-header">
                <text class="bar-title">CPU 使用率</text>
                <text class="bar-percent">{{ cpuDisplay }}%</text>
              </div>
              <progress
                class="bar-horizontal bar-cpu"
                percent="{{ cpuPercent }}"
              ></progress>
            </div>

            <!-- Memory Bar -->
            <div class="bar-section">
              <div class="bar-header">
                <text class="bar-title">内存使用率</text>
                <text class="bar-percent">{{ memDisplay }}%</text>
              </div>
              <progress
                class="bar-horizontal bar-mem"
                percent="{{ memPercent }}"
              ></progress>
            </div>
          </div>

          <!-- Temp Card (if available) -->
          <div if="{{ hasTemp }}" class="detail-card">
            <div class="detail-row">
              <text class="detail-label">温度</text>
              <text class="detail-value">{{ tempDisplay }}</text>
            </div>
          </div>
        </div>
      </div>
    </scroll>
  </div>
</template>

<style>
.page-container {
  width: 100%;
  height: 100%;
  background-color: #000;
  position: relative;
}

/* ---- Header ---- */
.header {
  width: 100%;
