  color: #bac3ff;
  margin-top: 24px;
}

/* ---- Press animation ---- */
.pressable {
  transform-origin: 50% 50%;
  transform: scale(1);
  opacity: 1;
}
.is-down {
  opacity: 0.75;
}
.press-down {
  animation-name: PressDown;
  animation-duration: 80ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
.press-up {
  animation-name: PressUp;
  animation-duration: 140ms;
  animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes PressDown {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  100% {
    transform: scale(0.94);
    opacity: 0.75;
  }
}
@keyframes PressUp {
  0% {
    transform: scale(0.94);
    opacity: 0.75;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

/* ---- Circle screen ---- */
@media (shape: circle) {
  .gauge-card {
    width: 360px;
    height: 180px;
    border-radius: 45px;
  }
  .ring-wrapper {
    width: 100px;
    height: 100px;
  }
  .ring-bg, .ring-cpu, .ring-mem {
    width: 100px;
    height: 100px;
  }
  .ring-value {
    font-size: 26px;
  }
  .detail-card {
    width: 360px;
    border-radius: 35px;
  }
  .bar-card {
    width: 360px;
    border-radius: 35px;
  }
  .gauge-divider {
    height: 64px;
  }
  .content-area {
    padding-bottom: 80px;
  }
}

/* ---- Rect screen ---- */
@media (shape: rect) {
  .header {
    height: 65px;
    flex-direction: row-reverse;
    justify-content: space-between;
    align-items: center;
    padding: 0 48px;
  }
  .title {
    margin-left: 12px;
  }
  .time-display {
    margin-right: 12px;
  }
  .content-scroll {
    top: 65px;
  }
  .content-area {
    padding-top: 10px;
  }
  .gauge-card {
    width: 420px;
  }
  .detail-card {
    width: 420px;
  }
  .bar-card {
    width: 420px;
  }
}
</style>

<script>
import router from '@system.router'
import deviceService from '../../services/deviceService.js'

const REFRESH_INTERVAL = 2000
const MAX_ERRORS = 3

export default {
  public: {
    deviceId: '',
    host: '',
    port: 0
  },
  private: {
    currentTime: '00:00',
    loading: true,
    cpuPercent: 0,
    cpuDisplay: '0',
    memPercent: 0,
    memDisplay: '0',
    memUsedDisplay: '--',
    memTotalDisplay: '--',
    memAvailDisplay: '--',
    hasTemp: false,
    tempDisplay: '--',
    pressedKey: '',
    releasedKey: '',
    errorCount: 0
  },

  onInit() {
    this.updateTime()
    this._timeInterval = setInterval(() => this.updateTime(), 60000)
  },

  onDestroy() {
    if (this._timeInterval) clearInterval(this._timeInterval)
    this.stopRefresh()
  },

  async onShow() {
    this.updateTime()
    await this.loadDevice()
    await this.fetchPerf()
    this.startRefresh()
  },

  onHide() {
    this.stopRefresh()
  },

  updateTime() {
    const now = new Date()
    this.currentTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`
  },

  async loadDevice() {
    const dev = await deviceService.getDevice(this.deviceId)
    if (dev) {
      this._device = dev
    } else if (this.host) {
      this._device = {
        host: this.host,
        port: this.port || 9000,
        deviceId: this.deviceId === '__interconnect__' ? 'interconnect-device' : this.deviceId
      }
    }
  },

  async fetchPerf() {
    const dev = this._device
    if (!dev || !dev.host) {
      this.loading = false
      return
    }
    try {
      const perf = await deviceService.getPerformance(
        dev.host, dev.port, dev.deviceId
      )
      if (perf && perf.status === 'ok') {
        this.errorCount = 0
        const cpu = Math.round(perf.cpu || 0)
        const memPct = Math.round(perf.mem_percent || 0)
        this.cpuPercent = cpu
        this.cpuDisplay = String(cpu)
        this.memPercent = memPct
        this.memDisplay = String(memPct)

        if (perf.mem_used != null && perf.mem_total != null) {
          this.memUsedDisplay = this.formatMem(perf.mem_used)
          this.memTotalDisplay = this.formatMem(perf.mem_total)
          const avail = perf.mem_total - perf.mem_used
          this.memAvailDisplay = this.formatMem(avail > 0 ? avail : 0)
        }

        if (perf.temp != null && perf.temp !== 0) {
          this.hasTemp = true
          this.tempDisplay = Math.round(perf.temp) + '°C'
        } else {
          this.hasTemp = false
        }

        this.loading = false
      } else {
        this.handleFetchError()
      }
    } catch (e) {
      this.handleFetchError()
    }
  },

  handleFetchError() {
    this.errorCount++
    if (this.errorCount >= MAX_ERRORS) {
      this.stopRefresh()
      if (this.loading) this.loading = false
    } else if (this.loading) {
      this.loading = false
    }
  },

  formatMem(mb) {
    if (mb >= 1024) {
      return (mb / 1024).toFixed(1) + ' GB'
    }
    return Math.round(mb) + ' MB'
  },

  startRefresh() {
    this.stopRefresh()
    this._refreshInterval = setInterval(() => {
      this.fetchPerf()
    }, REFRESH_INTERVAL)
  },

  stopRefresh() {
    if (this._refreshInterval) {
      clearInterval(this._refreshInterval)
      this._refreshInterval = null
    }
  },

  goBack() {
    router.back()
  },

  pressDown(key) {
    this.releasedKey = ''
    this.pressedKey = key
  },

  pressRelease(key) {
    this.pressedKey = ''
    this.releasedKey = key
    setTimeout(() => {
      if (this.releasedKey === key) this.releasedKey = ''
    }, 160)
  },

  pressCancel(key) {
    if (this.pressedKey === key) this.pressedKey = ''
    if (this.releasedKey === key) this.releasedKey = ''
  }
}
</script>
