<template>
  <div class="page-container">
    <div class="header">
      <text class="time-display">{{ currentTime }}</text>
      <text class="title">HydroLink</text>
    </div>

    <scroll
      id="deviceScroll"
      class="scroll-wrapper"
      scroll-y="true"
      bounces="true"
    >
      <!-- Interconnect discovered device -->
      <div if="{{ icDevice }}" class="list-content">
        <div
          class="device-item ic-device pressable {{ pressedKey === 'ic_device' ? 'is-down' : '' }}"
          ontouchstart="onIcTouchStart"
          ontouchend="onIcTouchEnd"
          ontouchcancel="onIcTouchCancel"
          onclick="onIcTap"
        >
          <image class="device-icon" src="/common/icons/cellphone.png"></image>
          <div class="device-info">
            <text class="device-name">{{ icDevice.name }}</text>
            <text class="device-ip">Interconnect</text>
          </div>
        </div>
      </div>

      <!-- Manual devices -->
      <div if="{{ devices.length > 0 }}" class="list-content">
        <!-- 外层只负责外观；点击区拆成并列的两块（主体 + 更多），互不嵌套 →
             不用赌事件冒泡/stopPropagation 的行为 -->
        <div
          for="{{ (index, item) in devices }}"
          class="device-item {{ !item.reachable ? 'device-offline' : '' }}"
        >
          <div
            class="device-main pressable {{ pressedKey === 'device_' + index ? 'is-down' : '' }}"
            ontouchstart="onDeviceTouchStart(index)"
            ontouchend="onDeviceTouchEnd(index)"
            ontouchcancel="onDeviceTouchCancel(index)"
            onclick="onDeviceTap(index)"
          >
            <image class="device-icon" src="/common/icons/{{ item.deviceType }}.png"></image>
            <div class="device-info">
              <text class="device-name">{{ item.name }}</text>
              <text class="device-ip">{{ item.host }}:{{ item.port }}</text>
            </div>
          </div>
          <!-- 更多（进设备详情/管理页）。原来是"长按卡片"：既难发现又和滚动/点击打架。
               图标半透明（见 .device-more-icon）。 -->
          <div
            class="device-more pressable {{ pressedKey === 'more_' + index ? 'is-down' : '' }}"
            ontouchstart="pressDown('more_' + index)"
            ontouchend="pressRelease('more_' + index)"
            ontouchcancel="pressCancel('more_' + index)"
            onclick="onDeviceMore(index)"
          >
            <image class="device-more-icon" src="/common/icons/more_vert.png"></image>
          </div>
        </div>
      </div>

      <!-- Empty state -->
      <div if="{{ devices.length === 0 && !icDevice }}" class="empty-state">
        <text class="empty-text">暂无设备</text>
      </div>

      <!-- Bottom clearance for the FAB row (keeps card spacing tight) -->
      <div class="list-bottom-space"></div>
    </scroll>

    <div class="fab-wrapper">
      <div
        class="fab pressable {{ pressedKey === 'addDevice' ? 'is-down press-down' : '' }} {{ releasedKey === 'addDevice' ? 'press-up' : '' }}"
        ontouchstart="pressDown('addDevice')"
        ontouchend="pressRelease('addDevice')"
        ontouchcancel="pressCancel('addDevice')"
        onclick="onAddDevice"
      >
        <image class="fab-icon" src="/common/icons/plus.png"></image>
      </div>
      <!-- Settings button: same style, right next to the + button -->
      <div
        class="fab pressable {{ pressedKey === 'settings' ? 'is-down press-down' : '' }} {{ releasedKey === 'settings' ? 'press-up' : '' }}"
        ontouchstart="pressDown('settings')"
        ontouchend="pressRelease('settings')"
        ontouchcancel="pressCancel('settings')"
        onclick="onOpenSettings"
      >
        <image class="fab-icon" src="/common/icons/cog-custom.png"></image>
      </div>
    </div>
  </div>
</template>

<style>
.page-container {
  width: 100%;
  height: 100%;
  background-color: #000;
  position: relative;
}
.header {
  width: 100%;
  height: 90px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000;
}
.time-display {
  font-size: 28px;
  font-weight: bold;
  color: #fff;
  padding-top: 5px;
  text-align: center;
}
.title {
  font-size: 32px;
  font-weight: bold;
  color: #fff;
  text-align: center;
}
.scroll-wrapper {
  position: absolute;
  top: 90px;
  left: 0;
  right: 0;
  /* Vela：竖向滚动需要定高（官方文档）。这里 466 - 90 头部 = 376px */
  height: 376px;
  width: 100%;
  flex-direction: column;
  align-items: center;
}
.empty-state {
  width: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 100px;
}
.empty-text {
  font-size: 26px;
  color: #888;
  text-align: center;
  font-weight: bold;
}
.list-content {
  flex-direction: column;
  width: 100%;
  align-items: center;
}
.list-bottom-space {
  width: 100%;
  height: 130px;
  flex-shrink: 0;
}
.device-item {
  width: 400px;
  height: 120px;
  margin: 8px 0;
  padding: 0 8px 0 20px;
  background-color: #2e323c;
  border-radius: 60px;
  flex-direction: row;
  align-items: center;
}
/* 卡片主体：点它进设备信息页（占满左侧，更多按钮固定在右边） */
.device-main {
  flex-grow: 1;
  height: 120px;
  flex-direction: row;
  align-items: center;
}
.device-offline {
  opacity: 0.35;
}
.ic-device {
  background-color: #1e3a5f;
}
.device-icon {
  width: 48px;
  height: 48px;
  margin-right: 16px;
  flex-shrink: 0;
}
.device-info {
  flex-grow: 1;
  flex-direction: column;
  justify-content: center;
}
.device-more {
  width: 64px;
  height: 64px;
  border-radius: 32px;
  justify-content: center;
  align-items: center;
}
.device-more-icon {
  width: 32px;
  height: 32px;
  /* 半透明：按钮是次要操作，别抢卡片的视觉权重 */
  opacity: 0.55;
}
.device-name {
  font-size: 26px;
  font-weight: bold;
  color: #fff;
  lines: 1;
  text-overflow: ellipsis;
}
.device-ip {
  font-size: 22px;
  font-weight: bold;
  color: #888;
  lines: 1;
  text-overflow: ellipsis;
  margin-top: 4px;
}
.fab-wrapper {
  position: absolute;
  bottom: 30px;
  left: 0;
  right: 0;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.fab {
  width: 80px;
  height: 80px;
  border-radius: 40px;
  background-color: #bac3ff;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin: 0 8px;
}
.fab-icon {
  width: 36px;
  height: 36px;
}
.pressable {
  transform-origin: 50% 50%;
  transform: scale(1);
  opacity: 1;
}
.is-down {
  opacity: 0.75;
}
.press-down {
  animation-name: PressDown;
  animation-duration: 150ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
.press-up {
  animation-name: PressUp;
  animation-duration: 250ms;
  animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes PressDown {
  0% { transform: scale(1); opacity: 1; }
  100% { transform: scale(0.94); opacity: 0.75; }
}
@keyframes PressUp {
  0% { transform: scale(0.94); opacity: 0.75; }
  100% { transform: scale(1); opacity: 1; }
}

@media (shape: circle) {
  .scroll-wrapper {
    padding-left: 40px;
    padding-right: 40px;
  }
  .list-bottom-space {
    height: 150px;
  }
  .fab-wrapper {
    bottom: 40px;
  }
}

@media (shape: rect) {
  .header {
    height: 65px;
    flex-direction: row-reverse;
    justify-content: space-between;
    align-items: center;
    padding: 0 48px;
  }
  .title {
    margin-left: 12px;
  }
  .time-display {
    margin-right: 12px;
  }
  .scroll-wrapper {
    top: 65px;
  }
}
</style>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import deviceService from '../../services/deviceService.js'
import interconnectService from '../../services/interconnectService.js'

const PING_INTERVAL = 2000
const PING_TIMEOUT = 3000
const IC_DISCOVER_TIMEOUT = 12000
const IC_RETRY_INTERVAL = 5000

export default {
  private: {
    devices: [],
    currentTime: '00:00',
    pressedKey: '',
    releasedKey: '',
    icDevice: null
  },

  onInit() {
    this.updateTime()
    this._timeInterval = setInterval(() => this.updateTime(), 1000)
    // Make sure this page's interconnectService instance has a connection
    // (no-op if the app entry already initialized the shared singleton).
    interconnectService.ensureInit()
  },

  onDestroy() {
    if (this._timeInterval) clearInterval(this._timeInterval)
    this.stopPing()
    this.stopIcRetry()
    interconnectService.setServerInfoHandler(null)
  },

  /**
   * 设备列表是应用入口页（splash 用 router.replace 进来，栈里没有上一页）。
   * 返回键直接退出应用，不要停留在空路由栈或回到启动图。
   */
  onBackPress() {
    try {
      this.$app.exit()
    } catch (e) {
      console.warn('[home] $app.exit 失败', e)
    }
    return true   // 消费返回事件，避免系统再执行默认返回
  },

  onShow() {
    this.updateTime()
    this.loadDevices()
    if (this.icDevice && !interconnectService.checkAlive()) {
      this.icDevice = null
    }
    this.tryInterconnectDiscover()
    // Phone pushes server_info every 5s — handle it immediately so the
    // device appears without waiting for a discover retry, and disappears
    // immediately when disconnected / offline.
    interconnectService.setServerInfoHandler((info) => {
      if (info && info.host) {
        console.log('[home] server_info handler: ' + JSON.stringify(info))
        this.applyIcServerInfo(info)
      } else {
        console.log('[home] interconnect offline, removing icDevice card')
        this.icDevice = null
        this.scheduleIcRetry()
      }
    })
  },

  onHide() {
    this.stopPing()
    this.stopIcRetry()
  },

  updateTime() {
    const now = new Date()
    this.currentTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`
  },

  async loadDevices() {
    const devices = await deviceService.readDevices()
    for (let i = 0; i < devices.length; i++) {
      if (!devices[i].deviceType) {
        devices[i].deviceType = 'desktop'
      }
      devices[i].reachable = true
    }
    this.devices = devices
    this.startPing()
  },

  /**
   * Try to auto-discover the server via interconnect.
   * Runs silently in the background; retries periodically until found.
   */
  tryInterconnectDiscover() {
    if (!interconnectService.isAvailable()) {
      this.icDevice = null
      return
    }
    // Already found - no need to search
    if (this.icDevice) return

    interconnectService.discoverServer()
      .then((info) => {
        if (info && info.host) {
          this.applyIcServerInfo(info)
        } else {
          this.scheduleIcRetry()
        }
      })
      .catch(() => {
        this.scheduleIcRetry()
      })

    // Timeout fallback for this attempt
    if (this._icTimer) clearTimeout(this._icTimer)
    this._icTimer = setTimeout(() => {
      this.scheduleIcRetry()
    }, IC_DISCOVER_TIMEOUT)
  },

  applyIcServerInfo(info) {
    const host = info.host
    const port = info.port || 9000
    const cached = deviceService.peekCache('sysinfo', '__interconnect__')
    const cachedModel = (cached && cached.hostname) || ''
    const initialName = info.name || cachedModel || (this.icDevice && this.icDevice.name) || 'HydroLink'
    this.icDevice = {
      name: initialName,
      host: host,
      port: port,
      viaInterconnect: true
    }
    if (!info.name && !cachedModel) {
      deviceService.getServerSystemInfo(host, port, 'interconnect-device')
        .then((sysInfo) => {
          if (sysInfo && sysInfo.hostname) {
            deviceService.putCache('sysinfo', '__interconnect__', sysInfo)
            if (this.icDevice) {
              this.icDevice = {
                name: sysInfo.hostname,
                host: this.icDevice.host,
                port: this.icDevice.port,
                viaInterconnect: true
              }
            }
          }
        })
        .catch(() => {})
    }
  },

  /**
   * Schedule a retry for interconnect discovery after IC_RETRY_INTERVAL.
   */
  scheduleIcRetry() {
    // Don't retry if we already found the device
    if (this.icDevice) return
    // Don't schedule duplicate retries
    if (this._icRetryTimer) return
    this._icRetryTimer = setTimeout(() => {
      this._icRetryTimer = null
      this.tryInterconnectDiscover()
    }, IC_RETRY_INTERVAL)
  },

  /**
   * Stop the interconnect retry timer.
   */
  stopIcRetry() {
    if (this._icTimer) {
      clearTimeout(this._icTimer)
      this._icTimer = null
    }
    if (this._icRetryTimer) {
      clearTimeout(this._icRetryTimer)
      this._icRetryTimer = null
    }
  },

  startPing() {
    this.stopPing()
    this.pingAll()
    this._pingInterval = setInterval(() => this.pingAll(), PING_INTERVAL)
  },

  stopPing() {
    if (this._pingInterval) {
      clearInterval(this._pingInterval)
      this._pingInterval = null
    }
  },

  async pingAll() {
    if (this.icDevice && !interconnectService.checkAlive()) {
      this.icDevice = null
      this.scheduleIcRetry()
    }
    const devices = this.devices
    if (!devices || devices.length === 0) return
    const results = await Promise.all(
      devices.map(d => deviceService.pingWithTimeout(d.host, d.port, PING_TIMEOUT))
    )
    let changed = false
    for (let i = 0; i < devices.length; i++) {
      if (devices[i].reachable !== results[i]) {
        devices[i].reachable = results[i]
        changed = true
      }
    }
    if (changed) {
      this.devices = [...devices]
    }
  },

  onAddDevice() {
    router.push({ uri: '/pages/pair' })
  },

  onOpenSettings() {
    router.push({ uri: '/pages/settings' })
  },

  /* ---- Interconnect device handlers ---- */
  // Long-press editing is disabled for the interconnect card — tapping opens
  // deviceInfo. Long-press is treated the same as tap (no edit menu).
  onIcTouchStart() {
    this.pressDown('ic_device')
  },

  onIcTouchEnd() {
    // 同上：只做按压视觉，跳转在 onclick（避免滚动时误触）
    this.pressRelease('ic_device')
  },

  onIcTap() {
    if (!this.icDevice || !interconnectService.isReady()) {
      this.icDevice = null
      this.scheduleIcRetry()
      return
    }
    this.openIcDevice('deviceInfo')
  },

  onIcTouchCancel() {
    this.pressCancel('ic_device')
  },

  openIcDevice(page) {
    if (!this.icDevice) return
    router.push({
      uri: '/pages/' + page,
      params: {
        deviceId: '__interconnect__',
        icHost: this.icDevice.host,
        icPort: this.icDevice.port,
        icName: this.icDevice.name || ''
      }
    })
  },

  /* ---- Manual device handlers ---- */
  onDeviceTouchStart(index) {
    this.pressDown('device_' + index)
  },

  onDeviceTouchEnd(index) {
    // 只做按压视觉：跳转交给 onclick（滚动时不会产生 click，避免误触）
    this.pressRelease('device_' + index)
  },

  /**
   * 点击进设备页。放在 onclick 而不是 touchend：滚动列表时的滑动不会产生 click，
   * 于是"滑动结束"不会再误触发（插件启动器一直是这个写法，所以那边没这个问题）。
   * 长按已经进过详情页的话，这一次 click 吃掉，避免连推两个页面。
   */
  onDeviceTap(index) {
    this.openDevice(index, 'deviceInfo')
  },

  /** 右侧「更多」：进设备详情页（改名/地址/端口/类型/删除） */
  onDeviceMore(index) {
    this.openDevice(index, 'deviceDetail')
  },

  openDevice(index, page) {
    const device = this.devices[index]
    if (!device) return
    const deviceKey = device.id || (device.host + ':' + device.port)
    if (page === 'deviceDetail' || device.reachable) {
      router.push({
        uri: '/pages/' + page,
        params: { deviceId: deviceKey }
      })
    } else {
      prompt.showToast({ message: '无法访问' })
    }
  },

  onDeviceTouchCancel(index) {
    this.pressCancel('device_' + index)
  },

  pressDown(key) {
    this.releasedKey = ''
    this.pressedKey = key
  },

  pressRelease(key) {
    this.pressedKey = ''
    this.releasedKey = key
    setTimeout(() => {
      if (this.releasedKey === key) this.releasedKey = ''
    }, 270)
  },

  pressCancel(key) {
    if (this.pressedKey === key) this.pressedKey = ''
    if (this.releasedKey === key) this.releasedKey = ''
  }
}
</script>
