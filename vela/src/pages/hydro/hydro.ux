<import name="hydro-leaf" src="../../components/HydroLeaf/HydroLeaf"></import>
<template>
  <div class="page" style="{{ pageStyle }}">

    <!-- 加载 / 错误（头部下方垂直居中，不与返回栏重叠） -->
    <div class="center-area" if="{{ loading && !errorText }}">
      <image class="spin" src="/common/icons/progress-activity.png"></image>
    </div>
    <div class="center-area" if="{{ errorText }}">
      <text class="err">{{ errorText }}</text>
      <text class="hint" onclick="goBack">‹ 返回</text>
    </div>

    <!-- 组件树：滚动由插件声明（根节点 type:'scroll'）；非 scroll 根按内容流动（可能被裁） -->
    <div class="tree-area" show="{{ !loading && !errorText }}">
      <div class="safe {{ safeClass }}">
        <scroll if="{{ rootScroll }}" class="tree-scroll" scroll-y="true" bounces="true">
          <div class="content" style="{{ contentStyle }}">
            <div for="{{ (i1, l1) in ui }}" style="{{ l1.ws }}">
              <!-- L1 容器 -->
              <div if="{{ l1.c }}" style="{{ l1.s }}">
                <div for="{{ (i2, l2) in l1.kids }}" style="{{ l2.ws }}">
                  <!-- L2 容器 -->
                  <div if="{{ l2.c }}" style="{{ l2.s }}">
                    <div for="{{ (i3, l3) in l2.kids }}" style="{{ l3.ws }}">
                      <hydro-leaf leaf="{{ l3 }}" @hydrotap="leafTap" @change="leafChange" @hydroinput="leafInput" @hydronav="leafNav"></hydro-leaf>
                    </div>
                  </div>
                  <hydro-leaf if="{{ !l2.c }}" leaf="{{ l2 }}" @hydrotap="leafTap" @change="leafChange" @hydroinput="leafInput" @hydronav="leafNav"></hydro-leaf>
                </div>
              </div>
              <hydro-leaf if="{{ !l1.c }}" leaf="{{ l1 }}" @hydrotap="leafTap" @change="leafChange" @hydroinput="leafInput" @hydronav="leafNav"></hydro-leaf>
            </div>
          </div>
        </scroll>
        <div if="{{ !rootScroll }}" class="content" style="{{ contentStyle }}">
          <div for="{{ (i1, l1) in ui }}" style="{{ l1.ws }}">
            <!-- L1 容器 -->
            <div if="{{ l1.c }}" style="{{ l1.s }}">
              <div for="{{ (i2, l2) in l1.kids }}" style="{{ l2.ws }}">
                <!-- L2 容器 -->
                <div if="{{ l2.c }}" style="{{ l2.s }}">
                  <div for="{{ (i3, l3) in l2.kids }}" style="{{ l3.ws }}">
                    <hydro-leaf leaf="{{ l3 }}" @hydrotap="leafTap" @change="leafChange" @hydroinput="leafInput" @hydronav="leafNav"></hydro-leaf>
                  </div>
                </div>
                <hydro-leaf if="{{ !l2.c }}" leaf="{{ l2 }}" @hydrotap="leafTap" @change="leafChange" @hydroinput="leafInput" @hydronav="leafNav"></hydro-leaf>
              </div>
            </div>
            <hydro-leaf if="{{ !l1.c }}" leaf="{{ l1 }}" @hydrotap="leafTap" @change="leafChange" @hydroinput="leafInput" @hydronav="leafNav"></hydro-leaf>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #000;
  position: relative;
}
/* 树区：整页；滚动与导航都来自插件树（导航节点 type:"nav"） */
.tree-area {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}
.tree-scroll {
  width: 100%;
  height: 100%;
}
.content {
  width: 100%;
  flex-direction: column;
  color: #ffffff;
}
/* 加载/错误块：整页垂直居中 */
.center-area {
  position: absolute;
  left: 0; right: 0;
  top: 0; bottom: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
/* 圆屏安全区（由 device.getInfo 的 shape 驱动，JS 侧计算）。
   数值按 466px(233dp) 圆面弧边测算：顶部 30px 起内容可见（留给居中的导航），
   左右 42px 保证 y≈100px 处左对齐行不被切，底部 48px 顶出最后一行。
   box-sizing 必须 border-box：否则 padding 会把滚动区高度撑出页面，
   底部内容被推出屏幕（此前"刷新"被裁的根因）。 */
.safe { width: 100%; height: 100%; box-sizing: border-box; }
.safe-circle { padding-top: 30px; padding-left: 42px; padding-right: 42px; padding-bottom: 48px; }
.spin { width: 56px; height: 56px; }
.err { color: #ffb4ab; font-size: 24px; margin-bottom: 8px; }
.hint { color: #666; font-size: 20px; }

/* 方屏/圆角矩形：无额外安全区（插件按需自留边距） */
@media (shape: rect) {
  .safe-circle { padding: 0; }
}
</style>

<script>
import router from '@system.router'
import device from '@system.device'
import deviceService from '../../services/deviceService.js'

// 已知内置图标 -> 本地资源（其余未知图标不显示）
const ICON_MAP = {
  play: '/common/icons/play-custom.png',
  pause: '/common/icons/pause-custom.png',
  next: '/common/icons/skip-next-custom.png',
  prev: '/common/icons/skip-previous-custom.png',
  music: '/common/icons/music-circle-custom.png',
  lock: '/common/icons/lock-custom.png',
  gauge: '/common/icons/gauge-custom.png',
  battery: '/common/icons/battery-custom.png',
  laptop: '/common/icons/laptop.png',
  desktop: '/common/icons/desktop.png',
  mobile: '/common/icons/mobile.png'
}

// 数值单位：角度类（startAngle/totalAngle…）补 deg，其余补 px；
// 字符串原样透传（调用方可自带单位，如 "240deg"）
// 绝对定位相关样式：在包装层生效（见 buildLeaf 注释）
const POSITION_KEYS = ['position', 'top', 'left', 'right', 'bottom', 'zIndex']

function cssVal(key, v) {
  if (typeof v === 'number') {
    return /angle$/i.test(key) ? v + 'deg' : v + 'px'
  }
  return String(v)
}
function toCssStyle(obj) {
  if (!obj || typeof obj !== 'object') return ''
  const parts = []
  Object.keys(obj).forEach((k) => {
    const v = obj[k]
    if (v === null || v === undefined) return
    // Vela 用 font-weight；协议里允许简写 weight
    const prop = k === 'weight' ? 'font-weight' : k.replace(/([A-Z])/g, '-$1').toLowerCase()
    parts.push(prop + ': ' + cssVal(k, v))
  })
  return parts.join('; ')
}

// 按屏幕形状合并且节点的 media 覆盖：base style < 形状键（circle/rect/pill）
function resolveStyle(n, ctx) {
  const style = Object.assign({}, n.style || {})
  const media = n.media
  if (!media || typeof media !== 'object' || !ctx) return style
  const apply = (m) => {
    if (!m || typeof m !== 'object') return
    Object.keys(m).forEach((k) => { style[k] = m[k] })
  }
  if (ctx.shape && media[ctx.shape]) apply(media[ctx.shape])
  return style
}

// 节点 -> 叶子渲染条目（容器由模板展开）
function buildLeaf(n, inRow, ctx) {
  const p = n.props || {}
  const type = n.type || ''
  const isText = type === 'text'
  const isBtn = type === 'button'
  const isSw = type === 'switch'
  const isBadge = type === 'badge'
  const isSpin = type === 'spinner'
  const isIcon = type === 'icon'
  const isImg = type === 'image'
  const isInput = type === 'input'
  const isNav = type === 'nav'
  const isProgress = type === 'progress'
  const isBox = type === 'box'
  const iconSrc = isIcon ? (ICON_MAP[p.name] || '') : ''
  const st = resolveStyle(n, ctx)
  // 绝对定位样式**上提到包装 div**：叶子在自定义组件内部没有定位上下文
  // （包含块尺寸为 0，left/right 过约束会把宽高算成 0 → 完全不渲染）。
  // 包装层是普通 div，包含块正常（.tree-area / .page）。
  const isAbs = !!(st && st.position === 'absolute')
  const wrapPos = {}
  const leafSt = Object.assign({}, st)
  if (isAbs) {
    POSITION_KEYS.forEach((k) => {
      if (st[k] !== undefined) { wrapPos[k] = st[k]; delete leafSt[k] }
    })
  }
  // 容器默认主题：文本未指定颜色时用白色（Vela 默认文本色是灰的）
  let s = toCssStyle(leafSt)
  if (isText && !(leafSt && typeof leafSt.color === 'string')) {
    s = 'color: #FFFFFF; ' + s
  }
  let ws = toCssStyle(wrapPos)
  if (inRow && isText) ws = ws ? ws + '; flex-grow: 1' : 'flex-grow: 1'
  return {
    c: false,
    t: type,
    s: s,
    ws: ws,
    // 行容器里的文本叶子自动撑满剩余宽度，把后面的控件顶到右侧
    // （Vela 内联 justify-content 不生效，用 flex-grow 实现）
    grow: !!(inRow && isText),
    v: (isInput ? (p.value || '') : (p.text || '')),
    label: p.label || '',
    placeholder: p.placeholder || '',
    chk: !!(p.checked),
    src: p.src || '',
    iconSrc: iconSrc,
    tap: (n.events && n.events.tap) || '',
    change: (n.events && n.events.change) || '',
    isText: isText,
    isBtn: isBtn,
    isSw: isSw,
    isBadge: isBadge,
    isSpin: isSpin,
    isIcon: isIcon,
    isImg: isImg,
    isInput: isInput,
    isNav: isNav,
    isProgress: isProgress,
    isBox: isBox,
    percent: (typeof p.percent === 'number' ? p.percent : parseFloat(p.percent) || 0),
    variant: p.variant === 'arc' ? 'arc' : 'horizontal',
    navAction: p.action || '',
    navLabel: p.label || (p.action === 'open' ? '›' : '‹'),
    navSurface: p.surface || 'app',
    navItem: p.item || '',
    isOther: !(isText || isBtn || isSw || isBadge || isSpin || isIcon || isImg || isInput || isNav || isProgress || isBox)
  }
}

function build(n, inRow, ctx) {
  if (!n) return null
  const hasKids = !!(n.children && n.children.length)
  if (hasKids) {
    // Vela 的 div 默认按内容收窄，容器必须显式撑满父级，
    // 行内才有剩余空间供 flex-grow / space-between 分配
    const dir = n.type === 'row' ? 'row' : 'column'
    const cst = resolveStyle(n, ctx)
    const cWrap = {}
    const cSt = Object.assign({}, cst)
    if (cst && cst.position === 'absolute') {
      POSITION_KEYS.forEach((k) => {
        if (cst[k] !== undefined) { cWrap[k] = cst[k]; delete cSt[k] }
      })
    }
    return {
      c: true,
      sc: n.type === 'scroll',
      s: 'width: 100%; flex-direction: ' + dir + '; ' + toCssStyle(cSt),
      ws: toCssStyle(cWrap),
      kids: n.children.map((c) => build(c, n.type === 'row', ctx))
    }
  }
  return buildLeaf(n, inRow, ctx)
}

export default {
  protected: {
    plugin: '',
    surface: '',
    item: '',
    host: '',
    port: 0,
    deviceId: ''
  },

  private: {
    ui: [],
    contentStyle: '',
    loading: true,
    errorText: '',
    refreshMs: 0,
    _timer: null,
    _busy: false,
    _started: false,
    _inputItem: null,
    _screen: null,
    _watchStore: null,
    safeClass: '',
    rootScroll: false,
    pageStyle: ''
  },

  onInit() {
    this._init()
  },

  // 先取屏幕信息（形状/分辨率/DPR），再加载视图；
  // 屏幕信息同时用于请求参数(A) 和 media 解析(B)
  async _init() {
    this._screen = await this._readScreen()
    this.safeClass = this._screen && this._screen.shape === 'circle' ? 'safe-circle' : ''
    // 插件手表端存储（scope:'watch'）：请求上送快照，响应落盘
    this._watchStore = await deviceService.readPluginStore(this.plugin)
    await this.load()
  },

  _storeHeader() {
    return { 'X-Hydro-Store': JSON.stringify(this._watchStore || {}) }
  },

  _readScreen() {
    const empty = { shape: '', width: 0, height: 0, dpr: 0, deviceType: '' }
    return new Promise((resolve) => {
      try {
        device.getInfo({
          success: (d) => resolve({
            shape: this._normShape(d.screenShape),
            width: Number(d.screenWidth) || 0,
            height: Number(d.screenHeight) || 0,
            dpr: Number(d.screenDensity) || 0,
            deviceType: d.deviceType || ''
          }),
          fail: () => resolve(empty)
        })
      } catch (e) {
        resolve(empty)
      }
    })
  },

  _normShape(s) {
    const v = String(s || '').toLowerCase()
    if (v === 'pill-shaped' || v === 'pillshape') return 'pill'
    return v
  },

  _screenCtx() {
    return { shape: this._screen ? this._screen.shape : '' }
  },

  onDestroy() {
    this._clearTimer()
  },

  onHide() {
    this._clearTimer()
  },

  onShow() {
    // 键盘返回结果（输入框）
    const appDef = this.$app && this.$app.$def
    const res = appDef ? appDef.keyboardResult : null
    if (res && res.field === 'hydro_input') {
      appDef.keyboardResult = null
      const it = this._inputItem
      if (it && it.change) {
        this._send({ handler: it.change, source: 'change', value: res.value })
      }
      this._inputItem = null
    }
    if (this._started && this.refreshMs > 0 && !this.errorText && !this._timer) this._startTimer()
  },

  _clearTimer() {
    if (this._timer) { clearInterval(this._timer); this._timer = null }
  },

  _startTimer() {
    this._clearTimer()
    if (this.refreshMs > 0) {
      this._timer = setInterval(() => this.refresh(), this.refreshMs)
    }
  },

  path(action) {
    let p = '/api/hydro/' + this.plugin + '/' + this.surface + '/' + this.item + '/' + action
    const sc = this._screen
    // 递增序号：轮询/事件用同一路径，避免 WebView 或中间层缓存 GET 响应
    // （否则切歌、CPU 变化等宿主状态更新不会反映到界面）
    this._seq = (this._seq || 0) + 1
    let q = '_=' + this._seq
    if (sc && sc.shape) {
      q = 'shape=' + encodeURIComponent(sc.shape) +
        '&width=' + sc.width +
        '&height=' + sc.height +
        '&dpr=' + sc.dpr +
        '&dt=' + encodeURIComponent(sc.deviceType || '') +
        '&' + q
    }
    return p + '?' + q
  },

  async load() {
    this.loading = true
    this.errorText = ''
    const view = await deviceService.hydro(this.host, this.port, this.path('view'), 'GET', null, this._storeHeader())
    this.loading = false
    if (!view || !view.root) {
      this.errorText = '加载失败，请检查服务端'
      return
    }
    this._apply(view)
    this._started = true
    this._startTimer()
  },

  async refresh() {
    const view = await deviceService.hydro(this.host, this.port, this.path('refresh'), 'GET', null, this._storeHeader())
    if (view && view.root) this._apply(view)
  },

  _apply(view) {
    const root = view.root
    this.rootScroll = !!(root && root.type === 'scroll')
    const ctx = this._screenCtx()
    // 根节点的背景样式提升到整页容器（全屏背景层，不受安全区内边距限制）
    const rootStyle = root ? resolveStyle(root, ctx) : {}
    const bgKeys = ['backgroundImage', 'backgroundSize', 'backgroundPosition', 'backgroundRepeat', 'backgroundColor']
    const pageBg = {}
    const contentStyle = Object.assign({}, rootStyle)
    bgKeys.forEach((k) => {
      if (rootStyle[k] !== undefined) {
        pageBg[k] = rootStyle[k]
        delete contentStyle[k]
      }
    })
    this.pageStyle = toCssStyle(pageBg)
    if (root && root.children && root.children.length) {
      this.ui = root.children.map((c) => build(c, false, ctx))
      this.contentStyle = toCssStyle(contentStyle)
    } else {
      this.ui = root ? [build(root, false, ctx)] : []
      this.contentStyle = ''
    }
    // 手表端存储写入：合并并持久化到设备本机
    this._applyWatchStore(view)
    this.refreshMs = view.refreshMs || 0
    this._startTimer()
  },

  _applyWatchStore(view) {
    if (!view || !view.storage || typeof view.storage !== 'object') return
    const merged = Object.assign({}, this._watchStore || {}, view.storage)
    this._watchStore = merged
    deviceService.writePluginStore(this.plugin, merged)
  },

  // 页面导航：协议节点 type:"nav"（back / open 动作），由插件声明
  leafNav(evt) {
    const item = this._unwrap(evt)
    if (!item) return
    if (item.navAction === 'back') {
      router.back()
    } else if (item.navAction === 'open') {
      router.push({
        uri: '/pages/hydro',
        params: {
          plugin: this.plugin,
          surface: item.navSurface || 'app',
          item: item.navItem || '',
          host: this.host || '',
          port: String(this.port || 0),
          deviceId: this.deviceId || ''
        }
      })
    }
  },

  // Vela 自定义组件 $emit 的 payload 包在 evt.detail 里（见组件事件文档/
  // NumPad 用法），这里统一解包
  _unwrap(evt) {
    return evt && evt.detail !== undefined && evt.detail !== null ? evt.detail : evt
  },

  // HydroLeaf 事件（由组件 $emit 上来）
  leafTap(evt) {
    const item = this._unwrap(evt)
    if (item && item.tap) this._send({ handler: item.tap, source: 'tap' })
  },
  leafChange(evt) {
    const item = this._unwrap(evt)
    if (item && item.change) this._send({ handler: item.change, source: 'change' })
  },
  leafInput(evt) {
    const item = this._unwrap(evt)
    if (!item || !item.change) return
    this._inputItem = item
    router.push({
      uri: '/pages/keyboard',
      params: { field: 'hydro_input', label: '输入', value: item.v || item.placeholder || '' }
    })
  },

  async _send(ev) {
    if (this._busy) return
    this._busy = true
    try {
      const view = await deviceService.hydro(this.host, this.port, this.path('event'), 'POST', { event: ev }, this._storeHeader())
      if (view && view.root) this._apply(view)
    } catch (err) {
      console.warn('[hydro] event failed', err)
    } finally {
      this._busy = false
    }
  },

  goBack() {
    router.back()
  }
}
</script>
