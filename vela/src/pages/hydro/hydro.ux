<import name="hydro-leaf" src="../../components/HydroLeaf/HydroLeaf"></import>
<template>
  <div class="page">
    <!-- 返回栏：独立一行，避免压住内容树，避开屏幕圆角 -->
    <div class="header">
      <text class="back" onclick="goBack">‹</text>
    </div>

    <!-- 加载 / 错误 -->
    <div class="center" if="{{ loading && !errorText }}">
      <image class="spin" src="/common/icons/progress-activity.png"></image>
    </div>
    <div class="center" if="{{ errorText }}">
      <text class="err">{{ errorText }}</text>
      <text class="hint">点击 ‹ 返回</text>
    </div>

    <!-- 组件树（容器最多三层嵌套，叶子由 hydro-leaf 渲染） -->
    <scroll class="hscroll" scroll-y="true" show="{{ !loading && !errorText }}">
      <div class="content" style="{{ contentStyle }}">
        <div for="{{ (i1, l1) in ui }}" style="{{ l1.grow ? 'flex-grow: 1' : '' }}">
          <!-- L1 容器 -->
          <div if="{{ l1.c }}" style="{{ l1.s }}">
            <div for="{{ (i2, l2) in l1.kids }}" style="{{ l2.grow ? 'flex-grow: 1' : '' }}">
              <!-- L2 容器 -->
              <div if="{{ l2.c }}" style="{{ l2.s }}">
                <div for="{{ (i3, l3) in l2.kids }}" style="{{ l3.grow ? 'flex-grow: 1' : '' }}">
                  <hydro-leaf leaf="{{ l3 }}" onhydrotap="leafTap" onchange="leafChange" onhydroinput="leafInput"></hydro-leaf>
                </div>
              </div>
              <hydro-leaf if="{{ !l2.c }}" leaf="{{ l2 }}" onhydrotap="leafTap" onchange="leafChange" onhydroinput="leafInput"></hydro-leaf>
            </div>
          </div>
          <hydro-leaf if="{{ !l1.c }}" leaf="{{ l1 }}" onhydrotap="leafTap" onchange="leafChange" onhydroinput="leafInput"></hydro-leaf>
        </div>
      </div>
    </scroll>
  </div>
</template>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #000;
  position: relative;
}
/* 默认按圆屏（circle）安全区留白；rect 屏在下方媒体查询里收紧 */
.header {
  width: 100%;
  height: 108px;
  flex-direction: row;
  align-items: center;
  padding-left: 40px;
}
.back {
  font-size: 44px;
  color: rgba(255, 255, 255, 0.85);
}
.hscroll {
  position: absolute;
  top: 108px;
  left: 0;
  right: 0;
  bottom: 0;
}
.content {
  width: 100%;
  flex-direction: column;
  color: #ffffff;
}
.center {
  position: absolute;
  left: 0;
  right: 0;
  top: 45%;
  flex-direction: column;
  align-items: center;
}
.spin { width: 56px; height: 56px; }
.err { color: #ffb4ab; font-size: 24px; margin-bottom: 8px; }
.hint { color: #666; font-size: 20px; }

/* 方屏/圆角矩形：角上安全区小，头部收紧 */
@media (shape: rect) {
  .header { height: 72px; padding-left: 24px; }
  .hscroll { top: 72px; }
}
</style>

<script>
import router from '@system.router'
import deviceService from '../../services/deviceService.js'

// 已知内置图标 -> 本地资源（其余未知图标不显示）
const ICON_MAP = {
  play: '/common/icons/play-custom.png',
  pause: '/common/icons/pause-custom.png',
  next: '/common/icons/skip-next-custom.png',
  prev: '/common/icons/skip-previous-custom.png',
  music: '/common/icons/music-circle-custom.png',
  lock: '/common/icons/lock-custom.png',
  gauge: '/common/icons/gauge-custom.png',
  battery: '/common/icons/battery-custom.png',
  laptop: '/common/icons/laptop.png',
  desktop: '/common/icons/desktop.png',
  mobile: '/common/icons/mobile.png'
}

function cssVal(v) {
  return typeof v === 'number' ? v + 'px' : String(v)
}
function toCssStyle(obj) {
  if (!obj || typeof obj !== 'object') return ''
  const parts = []
  Object.keys(obj).forEach((k) => {
    const v = obj[k]
    if (v === null || v === undefined) return
    // Vela 用 font-weight；协议里允许简写 weight
    const prop = k === 'weight' ? 'font-weight' : k.replace(/([A-Z])/g, '-$1').toLowerCase()
    parts.push(prop + ': ' + cssVal(v))
  })
  return parts.join('; ')
}

// 节点 -> 叶子渲染条目（容器由模板展开）
function buildLeaf(n, inRow) {
  const p = n.props || {}
  const type = n.type || ''
  const isText = type === 'text'
  const isBtn = type === 'button'
  const isSw = type === 'switch'
  const isBadge = type === 'badge'
  const isSpin = type === 'spinner'
  const isIcon = type === 'icon'
  const isImg = type === 'image'
  const isInput = type === 'input'
  const iconSrc = isIcon ? (ICON_MAP[p.name] || '') : ''
  // 容器默认主题：文本未指定颜色时用白色（Vela 默认文本色是灰的）
  let s = toCssStyle(n.style)
  if (isText && !(n.style && typeof n.style.color === 'string')) {
    s = 'color: #FFFFFF; ' + s
  }
  return {
    c: false,
    t: type,
    s: s,
    // 行容器里的文本叶子自动撑满剩余宽度，把后面的控件顶到右侧
    // （Vela 内联 justify-content 不生效，用 flex-grow 实现）
    grow: !!(inRow && isText),
    v: p.text || '',
    label: p.label || '',
    placeholder: p.placeholder || '',
    chk: !!(p.checked),
    src: p.src || '',
    iconSrc: iconSrc,
    tap: (n.events && n.events.tap) || '',
    change: (n.events && n.events.change) || '',
    isText: isText,
    isBtn: isBtn,
    isSw: isSw,
    isBadge: isBadge,
    isSpin: isSpin,
    isIcon: isIcon,
    isImg: isImg,
    isInput: isInput,
    isOther: !(isText || isBtn || isSw || isBadge || isSpin || isIcon || isImg || isInput)
  }
}

function build(n, inRow) {
  if (!n) return null
  const hasKids = !!(n.children && n.children.length)
  if (hasKids) {
    // Vela 的 div 默认按内容收窄，容器必须显式撑满父级，
    // 行内才有剩余空间供 flex-grow / space-between 分配
    const dir = n.type === 'row' ? 'row' : 'column'
    return {
      c: true,
      s: 'width: 100%; flex-direction: ' + dir + '; ' + toCssStyle(n.style),
      kids: n.children.map((c) => build(c, n.type === 'row'))
    }
  }
  return buildLeaf(n, inRow)
}

export default {
  protected: {
    plugin: '',
    surface: '',
    item: '',
    host: '',
    port: 0,
    deviceId: ''
  },

  private: {
    ui: [],
    contentStyle: '',
    loading: true,
    errorText: '',
    refreshMs: 0,
    _timer: null,
    _busy: false,
    _started: false,
    _inputItem: null
  },

  onInit() {
    this.load()
  },

  onDestroy() {
    this._clearTimer()
  },

  onHide() {
    this._clearTimer()
  },

  onShow() {
    // 键盘返回结果（输入框）
    const appDef = this.$app && this.$app.$def
    const res = appDef ? appDef.keyboardResult : null
    if (res && res.field === 'hydro_input') {
      appDef.keyboardResult = null
      const it = this._inputItem
      if (it && it.change) {
        this._send({ handler: it.change, source: 'change', value: res.value })
      }
      this._inputItem = null
    }
    if (this._started && this.refreshMs > 0 && !this.errorText && !this._timer) this._startTimer()
  },

  _clearTimer() {
    if (this._timer) { clearInterval(this._timer); this._timer = null }
  },

  _startTimer() {
    this._clearTimer()
    if (this.refreshMs > 0) {
      this._timer = setInterval(() => this.refresh(), this.refreshMs)
    }
  },

  path(action) {
    return '/api/hydro/' + this.plugin + '/' + this.surface + '/' + this.item + '/' + action
  },

  async load() {
    this.loading = true
    this.errorText = ''
    const view = await deviceService.hydro(this.host, this.port, this.path('view'), 'GET')
    this.loading = false
    if (!view || !view.root) {
      this.errorText = '加载失败，请检查服务端'
      return
    }
    this._apply(view)
    this._started = true
    this._startTimer()
  },

  async refresh() {
    const view = await deviceService.hydro(this.host, this.port, this.path('refresh'), 'GET')
    if (view && view.root) this._apply(view)
  },

  _apply(view) {
    const root = view.root
    if (root && root.children && root.children.length) {
      this.ui = root.children.map((c) => build(c, false))
      this.contentStyle = root.style ? toCssStyle(root.style) : ''
    } else {
      this.ui = root ? [build(root)] : []
      this.contentStyle = ''
    }
    this.refreshMs = view.refreshMs || 0
    this._startTimer()
  },

  // HydroLeaf 事件（由组件 $emit 上来）
  leafTap(item) {
    if (item && item.tap) this._send({ handler: item.tap, source: 'tap' })
  },
  leafChange(item) {
    if (item && item.change) this._send({ handler: item.change, source: 'change' })
  },
  leafInput(item) {
    if (!item || !item.change) return
    this._inputItem = item
    router.push({
      uri: '/pages/keyboard',
      params: { field: 'hydro_input', label: '输入', value: item.v || item.placeholder || '' }
    })
  },

  async _send(ev) {
    if (this._busy) return
    this._busy = true
    try {
      const view = await deviceService.hydro(this.host, this.port, this.path('event'), 'POST', { event: ev })
      if (view && view.root) this._apply(view)
    } catch (err) {
      console.warn('[hydro] event failed', err)
    } finally {
      this._busy = false
    }
  },

  goBack() {
    router.back()
  }
}
</script>
