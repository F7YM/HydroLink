<template>
  <div class="page">
    <text class="back" onclick="goBack">‹</text>

    <!-- 加载 / 错误 -->
    <div class="center" if="{{ loading && !errorText }}">
      <image class="spin" src="/common/icons/progress-activity.png"></image>
    </div>
    <div class="center" if="{{ errorText }}">
      <text class="err">{{ errorText }}</text>
      <text class="hint">点击 ‹ 返回</text>
    </div>

    <!-- 组件树（最多三层嵌套展开） -->
    <scroll class="hscroll" scroll-y="true" show="{{ !loading && !errorText }}">
      <div class="content" style="{{ contentStyle }}">
        <!-- ===== 层级 1 ===== -->
        <div for="{{ (i1, l1) in ui }}" style="width: 100%">
          <!-- L1 容器 -->
          <div if="{{ l1.c }}" style="{{ l1.s }}">
            <!-- ===== 层级 2 ===== -->
            <div for="{{ (i2, l2) in l1.kids }}" style="width: 100%">
              <!-- L2 容器 -->
              <div if="{{ l2.c }}" style="{{ l2.s }}">
                <!-- ===== 层级 3（叶子） ===== -->
                <div for="{{ (i3, l3) in l2.kids }}" style="width: 100%">
                  <text if="{{ l3.isText }}" style="{{ l3.s }}" onclick="doTap(l3.tap)">{{ l3.v }}</text>
                  <div if="{{ l3.isBtn }}" class="btn" style="{{ l3.s }}" onclick="doTap(l3.tap)">
                    <text class="btn-text">{{ l3.label }}</text>
                  </div>
                  <switch if="{{ l3.isSw }}" style="{{ l3.s }}" checked="{{ l3.chk }}" @change="doSwitch(l3)"></switch>
                  <text if="{{ l3.isOther }}" style="{{ l3.s }}">[{{ l3.t }}]</text>
                </div>
              </div>
              <!-- L2 叶子 -->
              <text if="{{ !l2.c && l2.isText }}" style="{{ l2.s }}" onclick="doTap(l2.tap)">{{ l2.v }}</text>
              <div if="{{ !l2.c && l2.isBtn }}" class="btn" style="{{ l2.s }}" onclick="doTap(l2.tap)">
                <text class="btn-text">{{ l2.label }}</text>
              </div>
              <switch if="{{ !l2.c && l2.isSw }}" style="{{ l2.s }}" checked="{{ l2.chk }}" @change="doSwitch(l2)"></switch>
              <text if="{{ !l2.c && l2.isOther }}" style="{{ l2.s }}">[{{ l2.t }}]</text>
            </div>
          </div>
          <!-- L1 叶子 -->
          <text if="{{ !l1.c && l1.isText }}" style="{{ l1.s }}" onclick="doTap(l1.tap)">{{ l1.v }}</text>
          <div if="{{ !l1.c && l1.isBtn }}" class="btn" style="{{ l1.s }}" onclick="doTap(l1.tap)">
            <text class="btn-text">{{ l1.label }}</text>
          </div>
          <switch if="{{ !l1.c && l1.isSw }}" style="{{ l1.s }}" checked="{{ l1.chk }}" @change="doSwitch(l1)"></switch>
          <text if="{{ !l1.c && l1.isOther }}" style="{{ l1.s }}">[{{ l1.t }}]</text>
        </div>
      </div>
    </scroll>
  </div>
</template>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #000;
  position: relative;
}
.back {
  position: absolute;
  top: 10px;
  left: 16px;
  font-size: 42px;
  color: rgba(255, 255, 255, 0.85);
  z-index: 10;
}
.hscroll {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}
.content {
  width: 100%;
  flex-direction: column;
  padding: 20px;
}
.btn {
  background-color: #bac3ff;
  border-radius: 40px;
  padding: 8px 24px;
  align-items: center;
  justify-content: center;
}
.btn-text {
  color: #00237c;
  font-size: 24px;
  font-weight: bold;
}
.center {
  position: absolute;
  left: 0;
  right: 0;
  top: 40%;
  flex-direction: column;
  align-items: center;
}
.spin {
  width: 56px;
  height: 56px;
}
.err { color: #ffb4ab; font-size: 24px; margin-bottom: 8px; }
.hint { color: #666; font-size: 20px; }
</style>

<script>
import router from '@system.router'
import deviceService from '../../services/deviceService.js'

// style 对象（camelCase）-> Vela 内联 css 字符串
function cssVal(v) {
  return typeof v === 'number' ? v + 'px' : String(v)
}
function toCssStyle(obj) {
  if (!obj || typeof obj !== 'object') return ''
  const parts = []
  Object.keys(obj).forEach((k) => {
    const v = obj[k]
    if (v === null || v === undefined) return
    const prop = k.replace(/([A-Z])/g, '-$1').toLowerCase()
    parts.push(prop + ': ' + cssVal(v))
  })
  return parts.join('; ')
}

// 单节点 -> 渲染条目（容器 or 叶子）
function build(n) {
  const hasKids = !!(n.children && n.children.length)
  if (hasKids) {
    return {
      c: true,
      s: 'flex-direction: ' + (n.type === 'row' ? 'row' : 'column') + '; ' + toCssStyle(n.style),
      kids: n.children.map(build)
    }
  }
  const p = n.props || {}
  const type = n.type || ''
  const isText = type === 'text'
  const isBtn = type === 'button'
  const isSw = type === 'switch'
  return {
    c: false,
    t: type,
    s: toCssStyle(n.style),
    v: p.text || '',
    label: p.label || '',
    chk: !!(p.checked),
    tap: (n.events && n.events.tap) || '',
    change: (n.events && n.events.change) || '',
    isText: isText,
    isBtn: isBtn,
    isSw: isSw,
    isOther: !isText && !isBtn && !isSw
  }
}

export default {
  protected: {
    plugin: '',
    surface: '',
    item: '',
    host: '',
    port: 0,
    deviceId: ''
  },

  private: {
    ui: [],
    contentStyle: '',
    loading: true,
    errorText: '',
    refreshMs: 0,
    _timer: null,
    _busy: false,
    _started: false
  },

  onInit() {
    this.load()
  },

  onDestroy() {
    this._clearTimer()
  },

  onHide() {
    this._clearTimer()
  },

  onShow() {
    if (this._started && this.refreshMs > 0 && !this.errorText && !this._timer) this._startTimer()
  },

  _clearTimer() {
    if (this._timer) { clearInterval(this._timer); this._timer = null }
  },

  _startTimer() {
    this._clearTimer()
    if (this.refreshMs > 0) {
      this._timer = setInterval(() => this.refresh(), this.refreshMs)
    }
  },

  path(action) {
    return '/api/hydro/' + this.plugin + '/' + this.surface + '/' + this.item + '/' + action
  },

  async load() {
    this.loading = true
    this.errorText = ''
    const view = await deviceService.hydro(this.host, this.port, this.path('view'), 'GET')
    this.loading = false
    if (!view || !view.root) {
      this.errorText = '加载失败，请检查服务端'
      return
    }
    this._apply(view)
    this._started = true
    this._startTimer()
  },

  async refresh() {
    const view = await deviceService.hydro(this.host, this.port, this.path('refresh'), 'GET')
    if (view && view.root) this._apply(view)
  },

  _apply(view) {
    const root = view.root
    if (root && root.children && root.children.length) {
      this.ui = root.children.map(build)
      this.contentStyle = root.style ? toCssStyle(root.style) : ''
    } else {
      this.ui = root ? [build(root)] : []
      this.contentStyle = ''
    }
    this.refreshMs = view.refreshMs || 0
    this._startTimer()
  },

  async doTap(handler) {
    if (!handler) return
    await this._send({ handler: handler, source: 'tap' })
  },

  async doSwitch(item) {
    if (!item.change) return
    await this._send({ handler: item.change, source: 'change' })
  },

  async _send(ev) {
    if (this._busy) return
    this._busy = true
    try {
      const view = await deviceService.hydro(this.host, this.port, this.path('event'), 'POST', { event: ev })
      if (view && view.root) this._apply(view)
    } catch (err) {
      console.warn('[hydro] event failed', err)
    } finally {
      this._busy = false
    }
  },

  goBack() {
    router.back()
  }
}
</script>
