<import name="gif-player" src="../../components/GifPlayer/GifPlayer"></import>
<template>
  <div id="hydroPage" class="page" style="{{ pageStyle }}" ontouchstart="traceFirstTouch">

    <!-- 加载 / 错误（垂直居中） -->
    <div class="center-area" if="{{ loading && !errorText }}">
      <image class="spin" src="/common/icons/progress-activity.png"></image>
    </div>
    <div class="center-area" if="{{ errorText }}">
      <text class="err">{{ errorText }}</text>
      <text class="hint" onclick="goBack">‹ 返回</text>
    </div>

    <!-- 组件树：单层绝对定位扁平渲染 (JSLab 纯 JS 布局引擎) -->
    <div class="tree-area" show="{{ !loading && !errorText }}">
      <!-- 滚动视图：根据 JS 测量精确总高度提供安全视口与底部留白 -->
      <scroll id="hydroScroll" if="{{ rootScroll }}" class="tree-scroll" style="{{ viewportStyle }}" scroll-y="true" bounces="true" onscroll="traceFirstScroll">
        <div id="hydroScrollContent" class="scroll-content-flat" style="{{ { height: totalHeight + 'px' } }}" onclick="rootTap">
          <div for="{{ (i, node) in flatNodes }}" tid="id" class="abs-node" style="{{ node.wrapStyle }}">
            <!-- 容器背景 / 纯样式盒子 -->
            <div if="{{ node.kind === 'container_bg' || node.kind === 'box' }}" class="flat-box" style="{{ node.innerStyle }}" onclick="onNodeTap(node)"></div>

            <!-- text -->
            <text elif="{{ node.kind === 'text' }}" class="flat-text" style="{{ node.textStyle }}" onclick="onNodeTap(node)">{{ node.text }}</text>

            <!-- button -->
            <div elif="{{ node.kind === 'button' }}" class="flat-btn" style="{{ node.btnStyle }}" onclick="onNodeTap(node)">
              <text class="flat-btn-text" style="{{ node.btnTextStyle }}">{{ node.label }}</text>
            </div>

            <!-- image -->
            <image elif="{{ node.kind === 'image' && node.src }}" class="flat-img" style="{{ node.imgStyle }}" src="{{ node.src }}" onclick="onNodeTap(node)"></image>

            <!-- icon -->
            <image elif="{{ node.kind === 'icon' && node.iconSrc }}" class="flat-icon" style="{{ node.iconStyle }}" src="{{ node.iconSrc }}" onclick="onNodeTap(node)"></image>

            <!-- spinner -->
            <image elif="{{ node.kind === 'spinner' }}" class="flat-spin" src="/common/icons/progress-activity.png"></image>

            <!-- badge -->
            <div elif="{{ node.kind === 'badge' }}" class="flat-badge" style="{{ node.badgeStyle }}">
              <text class="flat-badge-text" style="{{ node.badgeTextStyle }}">{{ node.badgeText }}</text>
            </div>

            <!-- switch -->
            <switch elif="{{ node.kind === 'switch' }}" class="flat-switch" checked="{{ node.checked }}" @change="onSwitchChange(node)"></switch>

            <!-- input -->
            <div elif="{{ node.kind === 'input' }}" class="flat-input" style="{{ node.inputStyle }}" onclick="onInputClick(node)">
              <text class="flat-input-text" style="{{ node.inputTextStyle }}">{{ node.value || node.placeholder || '点击输入' }}</text>
            </div>

            <!-- progress -->
            <progress elif="{{ node.kind === 'progress' }}" class="flat-progress" style="{{ node.progressStyle }}" percent="{{ node.percent }}" type="{{ node.variant }}"></progress>

            <!-- nav -->
            <div elif="{{ node.kind === 'nav' }}" class="flat-nav" style="{{ node.navStyle }}" onclick="onNavClick(node)">
              <text class="flat-nav-text" style="{{ node.navTextStyle }}">{{ node.navLabel }}</text>
            </div>

            <!-- gif-player (本地双缓冲播放器组件) -->
            <gif-player elif="{{ node.kind === 'gif-player' }}" player-data="{{ node.playerData }}" @playerready="onPlayerReady(node)" @playerfinish="onPlayerFinish(node)" @segmentchange="onPlayerSegmentChange(node)"></gif-player>

            <!-- fallback other -->
            <text elif="{{ node.kind === 'other' }}" class="flat-other">[{{ node.type }}]</text>
          </div>
        </div>
      </scroll>

      <!-- 静态非滚动视图 -->
      <div if="{{ !rootScroll }}" class="static-content-flat" style="{{ viewportStyle }}" onclick="rootTap">
        <div for="{{ (i, node) in flatNodes }}" tid="id" class="abs-node" style="{{ node.wrapStyle }}">
          <div if="{{ node.kind === 'container_bg' || node.kind === 'box' }}" class="flat-box" style="{{ node.innerStyle }}" onclick="onNodeTap(node)"></div>
          <text elif="{{ node.kind === 'text' }}" class="flat-text" style="{{ node.textStyle }}" onclick="onNodeTap(node)">{{ node.text }}</text>
          <div elif="{{ node.kind === 'button' }}" class="flat-btn" style="{{ node.btnStyle }}" onclick="onNodeTap(node)">
            <text class="flat-btn-text" style="{{ node.btnTextStyle }}">{{ node.label }}</text>
          </div>
          <image elif="{{ node.kind === 'image' && node.src }}" class="flat-img" style="{{ node.imgStyle }}" src="{{ node.src }}" onclick="onNodeTap(node)"></image>
          <image elif="{{ node.kind === 'icon' && node.iconSrc }}" class="flat-icon" style="{{ node.iconStyle }}" src="{{ node.iconSrc }}" onclick="onNodeTap(node)"></image>
          <image elif="{{ node.kind === 'spinner' }}" class="flat-spin" src="/common/icons/progress-activity.png"></image>
          <div elif="{{ node.kind === 'badge' }}" class="flat-badge" style="{{ node.badgeStyle }}">
            <text class="flat-badge-text" style="{{ node.badgeTextStyle }}">{{ node.badgeText }}</text>
          </div>
          <switch elif="{{ node.kind === 'switch' }}" class="flat-switch" checked="{{ node.checked }}" @change="onSwitchChange(node)"></switch>
          <div elif="{{ node.kind === 'input' }}" class="flat-input" style="{{ node.inputStyle }}" onclick="onInputClick(node)">
            <text class="flat-input-text" style="{{ node.inputTextStyle }}">{{ node.value || node.placeholder || '点击输入' }}</text>
          </div>
          <progress elif="{{ node.kind === 'progress' }}" class="flat-progress" style="{{ node.progressStyle }}" percent="{{ node.percent }}" type="{{ node.variant }}"></progress>
          <div elif="{{ node.kind === 'nav' }}" class="flat-nav" style="{{ node.navStyle }}" onclick="onNavClick(node)">
            <text class="flat-nav-text" style="{{ node.navTextStyle }}">{{ node.navLabel }}</text>
          </div>
          <gif-player elif="{{ node.kind === 'gif-player' }}" player-data="{{ node.playerData }}" @playerready="onPlayerReady(node)" @playerfinish="onPlayerFinish(node)" @segmentchange="onPlayerSegmentChange(node)"></gif-player>
          <text elif="{{ node.kind === 'other' }}" class="flat-other">[{{ node.type }}]</text>
        </div>
      </div>
    </div>

    <div if="{{ eventStatus }}" class="event-status">
      <text class="event-status-text">{{ eventStatus }}</text>
    </div>
  </div>
</template>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #000;
  position: relative;
}
.tree-area {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}
.tree-scroll {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  flex-direction: column;
}
.scroll-content-flat {
  width: 100%;
  position: relative;
  flex-direction: column;
  flex-shrink: 0;
}
.static-content-flat {
  width: 100%;
  height: 100%;
  position: relative;
  flex-direction: column;
}
.abs-node {
  position: absolute;
}
.center-area {
  position: absolute;
  left: 0; right: 0;
  top: 0; bottom: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.spin { width: 56px; height: 56px; }
.err { color: #ffb4ab; font-size: 24px; margin-bottom: 8px; }
.hint { color: #666; font-size: 20px; }
.event-status {
  position: absolute;
  left: 48px;
  right: 48px;
  top: 30px;
  padding: 8px;
  background-color: #242630;
  border-radius: 12px;
  justify-content: center;
}
.event-status-text { color: #ffffff; font-size: 20px; }

/* 扁平节点内部元素样式 */
.flat-box { width: 100%; height: 100%; }
.flat-text { width: 100%; height: 100%; }
.flat-btn {
  width: 100%; height: 100%;
  align-items: center;
  justify-content: center;
}
.flat-btn-text {
  font-weight: bold;
}
.flat-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.flat-icon { width: 100%; height: 100%; }
.flat-spin {
  width: 100%; height: 100%;
  animation-name: flat-spin-anim;
  animation-duration: 900ms;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}
.flat-badge {
  width: 100%; height: 100%;
  align-items: center;
  justify-content: center;
}
.flat-badge-text { font-size: 20px; }
.flat-switch { width: 100%; height: 100%; }
.flat-input {
  width: 100%; height: 100%;
  align-items: center;
  justify-content: center;
}
.flat-input-text { font-size: 22px; color: #BAC3FF; }
.flat-progress { width: 100%; height: 100%; }
.flat-nav {
  width: 100%; height: 100%;
  align-items: center;
}
.flat-nav-text { font-size: 26px; }
.flat-other { color: #666666; font-size: 20px; }

@keyframes flat-spin-anim {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
</style>

<script>
import router from '@system.router';
import device from '@system.device';
import deviceService from '../../services/deviceService.js';
import { compileHydroUi, resolveStyle, toCssStyle } from './layout/uiLayout.js';
import { createUiPublisher } from './layout/uiPublisher.js';
import { createClientSandbox } from './layout/clientRuntime.js';

export default {
  protected: {
    plugin: '',
    surface: '',
    item: '',
    host: '',
    port: 0,
    deviceId: ''
  },

  private: {
    flatNodes: [],
    totalHeight: 480,
    _rootTap: '',
    loading: true,
    errorText: '',
    refreshMs: 0,
    _timer: null,
    _busy: false,
    _refreshing: false,
    eventStatus: '',
    _started: false,
    _visible: false,
    _destroyed: false,
    _inputItem: null,
    _screen: null,
    _watchStore: null,
    viewportStyle: 'height: 480px',
    rootScroll: false,
    pageStyle: '',
    _publisher: null,
    _previousNodes: null,
    _cache: null,
    _handlers: {},
    _sandbox: null,
    _lastView: null
  },

  onInit() {
    this._publisher = createUiPublisher();
    this._sandbox = createClientSandbox({
      onLocalStateChange: () => this._applyLocal(),
      getStore: (k, def) => (this._watchStore && this._watchStore[k] !== undefined ? this._watchStore[k] : def),
      setStore: (k, val) => {
        if (!this._watchStore) this._watchStore = {};
        this._watchStore[k] = val;
        deviceService.writePluginStore(this.plugin, this._watchStore);
      },
      sendServerEvent: (ev) => this._send(ev)
    });
    this._init();
  },

  async _init() {
    this._screen = await this._readScreen();
    if (this._destroyed) return;
    if (this._screen.width > 0 && this._screen.height > 0) {
      this.viewportStyle = 'height: ' + (480 * this._screen.height / this._screen.width) + 'px';
    }
    this._watchStore = await deviceService.readPluginStore(this.plugin);
    if (this._destroyed) return;
    await this.load();
  },

  _storeHeader() {
    return { 'X-Hydro-Store': JSON.stringify(this._watchStore || {}) };
  },

  _readScreen() {
    const empty = { shape: '', width: 0, height: 0, dpr: 0, deviceType: '' };
    return new Promise((resolve) => {
      try {
        device.getInfo({
          success: (d) => resolve({
            shape: this._normShape(d.screenShape),
            width: Number(d.screenWidth) || 0,
            height: Number(d.screenHeight) || 0,
            dpr: Number(d.screenDensity) || 0,
            deviceType: d.deviceType || ''
          }),
          fail: () => resolve(empty)
        });
      } catch (e) {
        resolve(empty);
      }
    });
  },

  _normShape(s) {
    const v = String(s || '').toLowerCase();
    if (v === 'pill-shaped' || v === 'pillshape') return 'pill';
    return v;
  },

  _screenCtx() {
    return {
      shape: this._screen ? this._screen.shape : '',
      width: this._screen ? this._screen.width : 0,
      height: this._screen ? this._screen.height : 0,
      dpr: this._screen ? this._screen.dpr : 0
    };
  },

  onDestroy() {
    this._destroyed = true;
    this._visible = false;
    this._clearTimer();
    this.flatNodes = [];
    if (this._publisher) this._publisher.clear();
    if (this._sandbox) {
      this._sandbox.destroy();
      this._sandbox = null;
    }
    this._previousNodes = null;
    this._cache = null;
    this._inputItem = null;
    this._watchStore = null;
    this._lastView = null;
  },

  onHide() {
    this._visible = false;
    this._clearTimer();
  },

  onShow() {
    this._visible = true;
    const appDef = this.$app && this.$app.$def;
    const res = appDef ? appDef.keyboardResult : null;
    if (res && res.field === 'hydro_input') {
      appDef.keyboardResult = null;
      const it = this._inputItem;
      if (it && it.change) {
        this._send({ handler: it.change, source: 'change', value: res.value });
      }
      this._inputItem = null;
    }
    if (this._started && this.refreshMs > 0 && !this.errorText && !this._timer) this._startTimer();
  },

  _clearTimer() {
    if (this._timer) { clearInterval(this._timer); this._timer = null; }
  },

  _startTimer() {
    this._clearTimer();
    if (this._visible && !this._destroyed && this.refreshMs > 0) {
      this._timer = setInterval(() => this.refresh(), this.refreshMs);
    }
  },

  path(action) {
    let p = '/api/hydro/' + this.plugin + '/' + this.surface + '/' + this.item + '/' + action;
    const sc = this._screen;
    this._seq = (this._seq || 0) + 1;
    let q = '_=' + this._seq;
    if (sc && sc.shape) {
      q = 'shape=' + encodeURIComponent(sc.shape) +
        '&width=' + sc.width +
        '&height=' + sc.height +
        '&dpr=' + sc.dpr +
        '&dt=' + encodeURIComponent(sc.deviceType || '') +
        '&' + q;
    }
    return p + '?' + q;
  },

  async load() {
    if (this._destroyed) return;
    this.loading = true;
    this.errorText = '';
    const view = await deviceService.hydro(this.host, this.port, this.path('view'), 'GET', null, this._storeHeader());
    if (this._destroyed) return;
    this.loading = false;
    if (!view || !view.root) {
      this.errorText = this._failText(view);
      return;
    }
    this._apply(view);
    this._started = true;
    this._startTimer();
  },

  _failText(view) {
    if (typeof view === 'string' && view) return view.slice(0, 80);
    if (view && (view.message || view.error)) return String(view.message || view.error).slice(0, 80);
    if (!view) return '服务端没响应（检查网络/服务是否在运行）';
    return '返回数据异常：缺少 root';
  },

  async refresh() {
    if (!this._visible || this._destroyed || this._busy || this._refreshing) return;
    this._refreshing = true;
    const eventGeneration = this._eventGeneration || 0;
    try {
      const view = await deviceService.hydro(this.host, this.port, this.path('refresh'), 'GET', null, this._storeHeader());
      if (this._visible && !this._destroyed && eventGeneration === (this._eventGeneration || 0) && view && view.root) {
        this._apply(view);
      }
    } finally {
      this._refreshing = false;
    }
  },

  _apply(view) {
    if (this._destroyed) return;
    const root = view.root;
    this.rootScroll = !!(root && root.type === 'scroll');
    const ctx = this._screenCtx();

    // 背景样式提升到整页容器
    const rootStyle = root ? resolveStyle(root, ctx) : {};
    const bgKeys = ['backgroundImage', 'backgroundSize', 'backgroundPosition', 'backgroundRepeat', 'backgroundColor'];
    const pageBg = {};
    bgKeys.forEach((k) => {
      if (rootStyle[k] !== undefined) pageBg[k] = rootStyle[k];
    });
    this.pageStyle = toCssStyle(pageBg);
    this._rootTap = (root && root.events && root.events.tap) || '';

    // JSLab 扁平排版引擎编译
    const compiled = compileHydroUi(root, ctx, this._previousNodes, this._cache);
    this._previousNodes = compiled.flatNodes;
    this._cache = compiled.cache;
    this._handlers = compiled.handlers;
    this.totalHeight = compiled.totalHeight;

    // 增量 In-place patch 发布
    this.flatNodes = this._publisher.update(compiled.flatNodes, this.flatNodes);

    this._applyWatchStore(view);
    this._lastView = view;

    // 若下发了客户端微脚本，载入沙盒执行
    if (view && (view.script || view.clientScript)) {
      if (this._sandbox) this._sandbox.evaluate(view.script || view.clientScript);
    }

    this.refreshMs = view.refreshMs || 0;
    this._startTimer();
  },

  _applyLocal() {
    if (this._destroyed || !this._lastView || !this._lastView.root) return;
    const ctx = this._screenCtx();
    const compiled = compileHydroUi(this._lastView.root, ctx, this._previousNodes, this._cache);
    this._previousNodes = compiled.flatNodes;
    this._cache = compiled.cache;
    this._handlers = compiled.handlers;
    this.totalHeight = compiled.totalHeight;
    this.flatNodes = this._publisher.update(compiled.flatNodes, this.flatNodes);
  },

  _applyWatchStore(view) {
    if (!view || !view.storage || typeof view.storage !== 'object') return;
    const merged = Object.assign({}, this._watchStore || {}, view.storage);
    this._watchStore = merged;
    deviceService.writePluginStore(this.plugin, merged);
  },

  _unwrap(evt) {
    return evt && evt.detail !== undefined && evt.detail !== null ? evt.detail : evt;
  },

  traceFirstTouch() {
    if (this._touchTraced) return;
    this._touchTraced = true;
    console.info('[hydro] native touch reached flat page');
  },

  traceFirstScroll() {
    if (this._scrollTraced) return;
    this._scrollTraced = true;
    console.info('[hydro] native scroll fired');
  },

  rootTap(evt) {
    if (!this._rootTap) return;
    if (evt && typeof evt.stopPropagation === 'function') evt.stopPropagation();
    this._send({ handler: this._rootTap, source: 'tap' });
  },

  onNodeTap(node, evt) {
    if (evt && typeof evt.stopPropagation === 'function') evt.stopPropagation();
    console.info('[hydro] flat node tap handler=' + (node && node.tap || '(none)'));
    if (!node || !node.tap) return;
    // 优先尝试客户端沙盒本地拦截（0ms 响应，免蓝牙/网络往返）
    if (this._sandbox && this._sandbox.invoke(node.tap, node)) {
      console.info('[hydro] intercepted locally by client sandbox: ' + node.tap);
      return;
    }
    this._send({ handler: node.tap, source: 'tap' });
  },

  onSwitchChange(node, evt) {
    const checked = evt && evt.checked !== undefined ? evt.checked : !node.checked;
    node.checked = checked;
    if (!node || !node.change) return;
    if (this._sandbox && this._sandbox.invoke(node.change, checked)) {
      console.info('[hydro] switch change intercepted locally: ' + node.change);
      return;
    }
    this._send({ handler: node.change, source: 'change', value: checked });
  },

  onInputClick(node, evt) {
    if (evt && typeof evt.stopPropagation === 'function') evt.stopPropagation();
    if (!node || !node.change) return;
    this._inputItem = node;
    router.push({
      uri: '/pages/keyboard',
      params: {
        field: 'hydro_input',
        label: node.placeholder || '输入',
        value: node.value || ''
      }
    });
  },

  onNavClick(node, evt) {
    if (evt && typeof evt.stopPropagation === 'function') evt.stopPropagation();
    if (!node) return;
    if (node.navAction === 'back') {
      router.back();
    } else if (node.navAction === 'open') {
      router.push({
        uri: '/pages/hydro',
        params: {
          plugin: this.plugin,
          surface: node.navSurface || 'app',
          item: node.navItem || '',
          host: this.host || '',
          port: String(this.port || 0),
          deviceId: this.deviceId || ''
        }
      });
    }
  },

  onPlayerReady(node, evt) {
    const detail = this._unwrap(evt);
    if (detail && detail.controller && this._sandbox) {
      this._sandbox.setPlayerController(detail.controller);
    }
  },

  onPlayerFinish(node, evt) {
    const detail = this._unwrap(evt);
    if (!node || !node.events || !node.events.finish) return;
    if (this._sandbox && this._sandbox.invoke(node.events.finish, detail)) return;
    this._send({ handler: node.events.finish, source: 'playerFinish', detail });
  },

  onPlayerSegmentChange(node, evt) {
    const detail = this._unwrap(evt);
    if (!node || !node.events || !node.events.segmentChange) return;
    if (this._sandbox && this._sandbox.invoke(node.events.segmentChange, detail)) return;
    this._send({ handler: node.events.segmentChange, source: 'segmentChange', detail });
  },

  async _send(ev) {
    console.info('[hydro] event dispatch handler=' + ev.handler + ' busy=' + this._busy + ' destroyed=' + this._destroyed);
    if (this._busy || this._destroyed) return;
    this._busy = true;
    this._eventGeneration = (this._eventGeneration || 0) + 1;
    this.eventStatus = '正在更新…';
    this._clearTimer();
    try {
      const view = await deviceService.hydro(this.host, this.port, this.path('event'), 'POST', { event: ev }, this._storeHeader());
      if (this._destroyed) return;
      if (view && view.root) {
        this._apply(view);
        this.eventStatus = '';
      } else if (view && typeof view === 'object' && !view.error && !view.message && Object.keys(view).length === 0) {
        this.eventStatus = '';
      } else {
        this.eventStatus = this._failText(view);
      }
    } catch (err) {
      console.warn('[hydro] event failed', err);
      if (!this._destroyed) this.eventStatus = '更新失败，请重试';
    } finally {
      this._busy = false;
      this._startTimer();
    }
  },

  goBack() {
    router.back();
  }
};
</script>
