<template>
  <div class="page-container">
    <!-- Header -->
    <div class="header">
      <text class="time-display">{{ currentTime }}</text>
      <text
        class="title pressable {{ pressedKey === 'back' ? 'is-down press-down' : '' }} {{ releasedKey === 'back' ? 'press-up' : '' }}"
        ontouchstart="pressDown('back')"
        ontouchend="pressRelease('back')"
        ontouchcancel="pressCancel('back')"
        onclick="goBack"
      >‹设备类型</text>
    </div>

    <!-- Type buttons -->
    <div class="type-area">
      <div class="type-list">
        <div
          for="{{ (index, item) in typeList }}"
          class="type-item pressable {{ pressedKey === item.key ? 'is-down press-down' : '' }} {{ releasedKey === item.key ? 'press-up' : '' }}"
          ontouchstart="pressDown(item.key)"
          ontouchend="pressRelease(item.key)"
          ontouchcancel="pressCancel(item.key)"
          onclick="onSelect(item.key)"
        >
          <div class="type-circle {{ selectedType === item.key ? 'type-circle-selected' : '' }}">
            <image class="type-icon" src="/common/icons/{{ item.key }}.png"></image>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
.page-container {
  width: 100%;
  height: 100%;
  background-color: #000;
  position: relative;
}

/* ---- Header ---- */
.header {
  width: 100%;
  height: 90px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000;
}
.time-display {
  font-size: 28px;
  font-weight: bold;
  color: #fff;
  padding-top: 5px;
  text-align: center;
}
.title {
  font-size: 32px;
  font-weight: bold;
  color: #fff;
  text-align: center;
}

/* ---- Type area ---- */
.type-area {
  position: absolute;
  top: 90px;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.type-list {
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.type-item {
  flex-direction: column;
  align-items: center;
  margin: 0 16px;
}
.type-circle {
  width: 120px;
  height: 120px;
  border-radius: 60px;
  background-color: #2e323c;
  border-width: 3px;
  border-style: solid;
  border-color: transparent;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.type-circle-selected {
  background-color: #bac3ff;
  border-color: #bac3ff;
}
.type-icon {
  width: 56px;
  height: 56px;
}

/* ---- Press animation ---- */
.pressable {
  transform-origin: 50% 50%;
  transform: scale(1);
  opacity: 1;
}
.is-down {
  opacity: 0.75;
}
.press-down {
  animation-name: PressDown;
  animation-duration: 80ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
.press-up {
  animation-name: PressUp;
  animation-duration: 140ms;
  animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes PressDown {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  100% {
    transform: scale(0.94);
    opacity: 0.75;
  }
}
@keyframes PressUp {
  0% {
    transform: scale(0.94);
    opacity: 0.75;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

/* ---- Circle screen ---- */
@media (shape: circle) {
  .type-list {
    padding-left: 20px;
    padding-right: 20px;
  }
  .type-item {
    margin: 0 10px;
  }
  .type-circle {
    width: 100px;
    height: 100px;
    border-radius: 50px;
  }
  .type-icon {
    width: 46px;
    height: 46px;
  }
}

/* ---- Rect screen ---- */
@media (shape: rect) {
  .header {
    height: 65px;
  }
  .type-area {
    top: 65px;
  }
}
</style>

<script>
import router from '@system.router'

export default {
  public: {
    currentType: 'desktop'
  },
  private: {
    selectedType: 'desktop',
    currentTime: '00:00',
    typeList: [
      { key: 'cellphone' },
      { key: 'laptop' },
      { key: 'desktop' }
    ],
    pressedKey: '',
    releasedKey: ''
  },

  onInit() {
    this.selectedType = this.currentType || 'desktop'
    this.updateTime()
    this._timeInterval = setInterval(() => this.updateTime(), 60000)
  },

  onDestroy() {
    if (this._timeInterval) clearInterval(this._timeInterval)
  },

  onShow() {
    this.updateTime()
  },

  updateTime() {
    const now = new Date()
    this.currentTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`
  },

  onSelect(key) {
    this.selectedType = key
    const appDef = this.$app && this.$app.$def
    if (appDef) {
      appDef.typeResult = { deviceType: key }
    }
  },

  goBack() {
    router.back()
  },

  pressDown(key) {
    this.releasedKey = ''
    this.pressedKey = key
  },

  pressRelease(key) {
    this.pressedKey = ''
    this.releasedKey = key
    setTimeout(() => {
      if (this.releasedKey === key) this.releasedKey = ''
    }, 160)
  },

  pressCancel(key) {
    if (this.pressedKey === key) this.pressedKey = ''
    if (this.releasedKey === key) this.releasedKey = ''
  }
}
</script>
