<template>
  <div class="page-container">
    <!-- Header -->
    <div class="header">
      <text class="time-display">{{ currentTime }}</text>
      <text
        class="title pressable {{ pressedKey === 'back' ? 'is-down press-down' : '' }} {{ releasedKey === 'back' ? 'press-up' : '' }}"
        ontouchstart="pressDown('back')"
        ontouchend="pressRelease('back')"
        ontouchcancel="pressCancel('back')"
        onclick="goBack"
      >‹终端</text>
    </div>

    <!-- Output area -->
    <scroll class="output-area" scroll-y="true" bounces="true" id="outputScroll">
      <div class="output-content">
        <div for="{{ history }}" class="output-entry">
          <text class="cmd-line">$ {{ $item.cmd }}</text>
          <text if="{{ $item.error }}" class="output-text output-error">{{ $item.output }}</text>
          <text if="{{ !$item.error }}" class="output-text">{{ $item.output }}</text>
        </div>
        <div if="{{ executing }}" class="output-entry">
          <text class="cmd-line">$ {{ currentCmd }}</text>
          <text class="output-text output-pending">执行中...</text>
        </div>
        <div if="{{ history.length === 0 && !executing }}" class="empty-hint">
          <text class="empty-text">点击下方输入命令</text>
        </div>
      </div>
    </scroll>

    <!-- Input bar -->
    <div class="input-bar">
      <div
        class="input-field pressable {{ pressedKey === 'input' ? 'is-down press-down' : '' }} {{ releasedKey === 'input' ? 'press-up' : '' }}"
        ontouchstart="pressDown('input')"
        ontouchend="pressRelease('input')"
        ontouchcancel="pressCancel('input')"
        onclick="onTapInput"
      >
        <text class="input-text">{{ currentCmd || '输入命令...' }}</text>
      </div>
      <div
        class="run-btn pressable {{ pressedKey === 'run' ? 'is-down press-down' : '' }} {{ releasedKey === 'run' ? 'press-up' : '' }}"
        ontouchstart="pressDown('run')"
        ontouchend="pressRelease('run')"
        ontouchcancel="pressCancel('run')"
        onclick="onRun"
      >
        <text class="run-btn-text">▶</text>
      </div>
    </div>
  </div>
</template>

<style>
.page-container {
  width: 100%;
  height: 100%;
  background-color: #000;
  position: relative;
}

/* ---- Header ---- */
.header {
  width: 100%;
  height: 90px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000;
}
.time-display {
  font-size: 28px;
  font-weight: bold;
  color: #fff;
  padding-top: 5px;
  text-align: center;
}
.title {
  font-size: 32px;
  font-weight: bold;
  color: #fff;
  text-align: center;
  lines: 1;
  text-overflow: ellipsis;
  max-width: 360px;
}

/* ---- Output area ---- */
.output-area {
  position: absolute;
  top: 90px;
  bottom: 90px;
  left: 0;
  right: 0;
  width: 100%;
  flex-direction: column;
}
.output-content {
  width: 100%;
  flex-direction: column;
  padding: 12px 30px;
}
.output-entry {
  flex-direction: column;
  margin-bottom: 12px;
}
.cmd-line {
  font-size: 22px;
  font-weight: bold;
  color: #bac3ff;
  lines: 3;
  text-overflow: ellipsis;
}
.output-text {
  font-size: 20px;
  color: #ccc;
  lines: 20;
  text-overflow: ellipsis;
  margin-top: 4px;
}
.output-error {
  color: #ef9a9a;
}
.output-pending {
  color: #888;
}
.empty-hint {
  width: 100%;
  flex-direction: column;
  align-items: center;
  padding-top: 60px;
}
.empty-text {
  font-size: 24px;
  color: #555;
}

/* ---- Input bar ---- */
.input-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 90px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  padding: 0 16px;
}
.input-field {
  width: 280px;
  height: 56px;
  background-color: #2e323c;
  border-radius: 28px;
  flex-direction: row;
  align-items: center;
  padding: 0 24px;
}
.input-text {
  font-size: 24px;
  color: #888;
  lines: 1;
  text-overflow: ellipsis;
}
.run-btn {
  width: 56px;
  height: 56px;
  border-radius: 28px;
  background-color: #bac3ff;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin-left: 12px;
}
.run-btn-text {
  font-size: 24px;
  color: #000;
  font-weight: bold;
}

/* ---- Press animation ---- */
.pressable {
  transform-origin: 50% 50%;
  transform: scale(1);
  opacity: 1;
}
.is-down {
  opacity: 0.75;
}
.press-down {
  animation-name: PressDown;
  animation-duration: 80ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
.press-up {
  animation-name: PressUp;
  animation-duration: 140ms;
  animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes PressDown {
  0% { transform: scale(1); opacity: 1; }
  100% { transform: scale(0.94); opacity: 0.75; }
}
@keyframes PressUp {
  0% { transform: scale(0.94); opacity: 0.75; }
  100% { transform: scale(1); opacity: 1; }
}

/* ---- Circle screen (466x466) ----
 * On a 466x466 circular screen the inscribed rectangle is ~330x330.
 * The previous layout let the run button slip behind the curved edge and
 * clipped the input field on both sides. The input bar is raised
 * (bottom: 10px) and shrunk so the whole row stays inside the circle. */
@media (shape: circle) {
  .output-area {
    top: 90px;
    bottom: 90px;
  }
  .output-content {
    padding: 8px 50px;
  }
  .cmd-line {
    font-size: 20px;
  }
  .output-text {
    font-size: 18px;
  }
  .input-bar {
    bottom: 10px;
    height: 64px;
    padding: 0 50px;
  }
  .input-field {
    width: 210px;
    height: 44px;
    border-radius: 22px;
    padding: 0 18px;
  }
  .input-text {
    font-size: 20px;
  }
  .run-btn {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    margin-left: 10px;
  }
  .run-btn-text {
    font-size: 20px;
  }
}

/* ---- Rect screen ---- */
@media (shape: rect) {
  .header {
    height: 65px;
    flex-direction: row-reverse;
    justify-content: space-between;
    align-items: center;
    padding: 0 48px;
  }
  .title {
    margin-left: 12px;
  }
  .time-display {
    margin-right: 12px;
  }
  .output-area {
    top: 65px;
    bottom: 80px;
  }
  .input-bar {
    height: 80px;
    padding: 0 16px;
  }
  .input-field {
    width: 320px;
    height: 52px;
  }
}
</style>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import deviceService from '../../services/deviceService.js'

export default {
  public: {
    deviceId: '',
    host: '',
    port: 0
  },
  private: {
    currentTime: '00:00',
    currentCmd: '',
    history: [],
    executing: false,
    pressedKey: '',
    releasedKey: ''
  },

  onInit() {
    this.updateTime()
    this._timeInterval = setInterval(() => this.updateTime(), 60000)
  },

  onDestroy() {
    if (this._timeInterval) clearInterval(this._timeInterval)
  },

  async onShow() {
    this.updateTime()
    if (!this._device) {
      const dev = await deviceService.getDevice(this.deviceId)
      if (dev) {
        this._device = dev
      } else if (this.host) {
        this._device = {
          host: this.host,
          port: this.port || 9000,
          deviceId: this.deviceId === '__interconnect__' ? 'interconnect-device' : this.deviceId
        }
      }
    }
    if (this.$app && this.$app.$def && this.$app.$def.keyboardResult) {
      const result = this.$app.$def.keyboardResult
      if (result.field === 'terminal' && result.value) {
        this.currentCmd = result.value
      }
      delete this.$app.$def.keyboardResult
    }
    this.scrollToBottom()
  },

  updateTime() {
    const now = new Date()
    this.currentTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`
  },

  onTapInput() {
    router.push({
      uri: '/pages/keyboard',
      params: {
        field: 'terminal',
        label: '终端输入',
        value: this.currentCmd || ''
      }
    })
  },

  async onRun() {
    const cmd = (this.currentCmd || '').trim()
    if (!cmd) {
      prompt.showToast({ message: '请输入命令' })
      return
    }
    if (this.executing) return

    const dev = this._device
    if (!dev || !dev.host) {
      prompt.showToast({ message: '设备未连接' })
      return
    }

    this.executing = true
    const res = await deviceService.sendTerminalCommand(
      dev.host, dev.port, dev.deviceId, cmd
    )
    this.executing = false

    let output = ''
    let isError = false
    if (res && res.status === 'ok') {
      output = res.output || '(无输出)'
      if (res.returncode !== 0) {
        output = output + '\n[退出码: ' + res.returncode + ']'
      }
    } else {
      output = (res && res.message) || '执行失败'
      isError = true
    }

    this.history.push({ cmd: cmd, output: output, error: isError })
    this.currentCmd = ''
    this.scrollToBottom()
  },

  scrollToBottom() {
    setTimeout(() => {
      const el = this.$element('outputScroll')
      if (el) el.scrollToBottom()
    }, 50)
  },

  goBack() {
    router.back()
  },

  pressDown(key) {
    this.releasedKey = ''
    this.pressedKey = key
  },

  pressRelease(key) {
    this.pressedKey = ''
    this.releasedKey = key
    setTimeout(() => {
      if (this.releasedKey === key) this.releasedKey = ''
    }, 160)
  },

  pressCancel(key) {
    if (this.pressedKey === key) this.pressedKey = ''
    if (this.releasedKey === key) this.releasedKey = ''
  }
}
</script>
