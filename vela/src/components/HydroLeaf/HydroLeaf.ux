<template>
  <div class="hydro-leaf">
    <!-- text -->
    <text if="{{ leaf.isText }}" style="{{ leaf.s }}" onclick="emitTap">{{ leaf.v }}</text>

    <!-- button -->
    <div if="{{ leaf.isBtn }}" class="btn" style="{{ leaf.s }}" onclick="emitTap">
      <text class="btn-text" style="{{ leaf.btnTextS }}">{{ leaf.label }}</text>
    </div>

    <!-- badge -->
    <div if="{{ leaf.isBadge }}" class="badge" style="{{ leaf.s }}">
      <text class="badge-text">{{ leaf.v || leaf.label }}</text>
    </div>

    <!-- switch -->
    <switch if="{{ leaf.isSw }}" style="{{ leaf.s }}" checked="{{ leaf.chk }}" @change="emitChange"></switch>

    <!-- spinner -->
    <image if="{{ leaf.isSpin }}" class="spin-img" style="{{ leaf.s }}" src="/common/icons/progress-activity.png"></image>

    <!-- icon (已知内置图标) / 未知不显示 -->
    <image if="{{ leaf.isIcon && leaf.iconSrc }}" class="icon-img" style="{{ leaf.s }}" src="{{ leaf.iconSrc }}"></image>

    <!-- image -->
    <image if="{{ leaf.isImg }}" class="img" style="{{ leaf.s }}" src="{{ leaf.src }}"></image>

    <!-- input: 点击弹出键盘输入 -->
    <div if="{{ leaf.isInput }}" class="btn ghost" style="{{ leaf.s }}" onclick="emitOpenInput">
      <text class="btn-text ghost-text">{{ leaf.v || leaf.placeholder || '点击输入' }}</text>
    </div>

    <!-- 进度条（协议节点 type:"progress"：props.percent 0-100，props.variant arc|bar）
         Vela progress 的 percent/type 是属性；颜色/粗细/弧参数走 style -->
    <progress if="{{ leaf.isProgress }}" class="leaf-progress" style="{{ leaf.s }}"
      percent="{{ leaf.percent }}" type="{{ leaf.variant }}"></progress>

    <!-- 空盒子（协议节点 type:"box"：纯样式块，用于进度条/分隔线/占位） -->
    <div if="{{ leaf.isBox }}" class="leaf-box" style="{{ leaf.s }}" onclick="emitTap"></div>

    <!-- 页面导航（协议节点 type:"nav"：action=back/open）。
         样式作用于容器 div（Vela 文本元素上 width 行为不可靠）；
         居中由插件在 style/media 里用 justifyContent 声明（div 是 flex 容器） -->
    <div if="{{ leaf.isNav }}" class="nav" style="{{ leaf.s }}" onclick="emitNav">
      <text class="nav-text">{{ leaf.navLabel }}</text>
    </div>

    <!-- 未知类型占位 -->
    <text if="{{ leaf.isOther }}" style="{{ leaf.s }}">[{{ leaf.t }}]</text>
  </div>
</template>

<style>
.hydro-leaf {
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
}
.btn {
  background-color: #bac3ff;
  border-radius: 40px;
  padding: 8px 24px;
  align-items: center;
  justify-content: center;
}
.btn.ghost {
  background-color: transparent;
  border-width: 2px;
  border-style: solid;
  border-color: #5a6270;
}
.ghost-text {
  color: #bac3ff;
}
.btn-text { color: #00237c; font-size: 24px; font-weight: bold; }
.badge {
  border-radius: 16px;
  padding: 4px 14px;
  align-items: center;
  justify-content: center;
}
.badge-text { color: #ffffff; font-size: 20px; }
.spin-img {
  width: 40px; height: 40px;
  transform-origin: 20px 20px;
  animation-name: leaf-spin;
  animation-duration: 900ms;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}
.leaf-progress { width: 100%; }
.leaf-box { width: 100%; height: 8px; }
.nav { padding: 6px 0; align-items: center; }
.nav-text { font-size: 28px; color: #ffffff; }
.icon-img { width: 28px; height: 28px; }
.img { width: 120px; height: 120px; }
@keyframes leaf-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
</style>

<script>
export default {
  props: ['leaf'],
  stopClick(evt) {
    if (evt && typeof evt.stopPropagation === 'function') evt.stopPropagation()
  },
  emitTap(evt) {
    console.info('[hydro] native leaf click handler=' + (this.leaf && this.leaf.tap || '(none)'))
    // 'tap' 是 Vela 的手势保留名，$emit('tap') 收不上去，改用非保留名
    if (this.leaf && this.leaf.tap) {
      this.stopClick(evt)
      this.$emit('hydrotap', this.leaf)
    }
  },
  emitChange() {
    if (this.leaf && this.leaf.change) this.$emit('change', this.leaf)
  },
  emitOpenInput(evt) {
    if (this.leaf && this.leaf.change) {
      this.stopClick(evt)
      this.$emit('hydroinput', this.leaf)
    }
  },
  emitNav(evt) {
    if (this.leaf && this.leaf.navAction) {
      this.stopClick(evt)
      this.$emit('hydronav', this.leaf)
    }
  }
}
</script>
