<template>
  <div class="handwriting-container">
    <!-- 顶部操作与候选字栏 -->
    <div class="top-bar">
      <!-- 切换输入法模式按钮 (切回全键盘/九宫格) -->
      <div
        class="mode-switch-btn pressable {{ pressedKey === 'switch' ? 'is-down press-down' : '' }} {{ releasedKey === 'switch' ? 'press-up' : '' }}"
        ontouchstart="pressDown('switch')"
        ontouchend="pressRelease('switch')"
        ontouchcancel="pressCancel('switch')"
        onclick="onSwitchKeyboard"
      >
        <text class="mode-switch-text">{{ switchLabel || '拼' }}</text>
      </div>

      <!-- 候选字横向展示区 (带横向滚动胶囊，防挤压防截断) -->
      <div class="candidate-bar">
        <scroll class="candidate-scroll" scroll-x="{{true}}">
          <div class="candidate-list">
            <div
              for="{{(idx, item) in candidates}}"
              class="candidate-item"
              onclick="selectCandidate(item)"
            >
              <text class="candidate-word">{{ item }}</text>
            </div>
          </div>
        </scroll>
      </div>

      <!-- 退格删除键 (纯文字“删”，无emoji) -->
      <div
        class="action-btn pressable {{ pressedKey === 'del' ? 'is-down press-down' : '' }} {{ releasedKey === 'del' ? 'press-up' : '' }}"
        ontouchstart="pressDown('del')"
        ontouchend="pressRelease('del')"
        ontouchcancel="pressCancel('del')"
        onclick="onDelete"
      >
        <text class="action-text">删</text>
      </div>
    </div>

    <!-- 居中纯净手写触控板 -->
    <div
      class="writing-pad"
      ontouchstart="onTouchStart"
      ontouchmove="onTouchMove"
      ontouchend="onTouchEnd"
      ontouchcancel="onTouchCancel"
    >
      <!-- 落笔点高光指示器 (随手指实时跟随) -->
      <div
        class="highlight-dot"
        style="{{ dotStyle }}"
        if="{{ showHighlight }}"
      ></div>
    </div>
  </div>
</template>

<style>
.handwriting-container {
  width: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  background-color: #000000;
}

/* ---- 顶部栏 ---- */
.top-bar {
  width: 100%;
  height: 52px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  background-color: #121212;
}

.mode-switch-btn {
  width: 56px;
  height: 42px;
  background-color: #242424;
  border-radius: 21px;
  justify-content: center;
  align-items: center;
}

.mode-switch-text {
  font-size: 22px;
  font-weight: bold;
  color: #bac3ff;
}

.candidate-bar {
  flex: 1;
  height: 48px;
  flex-direction: row;
  align-items: center;
  margin: 0 6px;
  overflow: hidden;
}

.candidate-scroll {
  width: 100%;
  height: 46px;
  flex-direction: row;
  align-items: center;
}

.candidate-list {
  height: 44px;
  flex-direction: row;
  align-items: center;
  padding: 0 2px;
}

.candidate-item {
  height: 38px;
  min-width: 44px;
  padding: 0 14px;
  margin-right: 8px;
  background-color: #242424;
  border-radius: 19px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.candidate-word {
  font-size: 24px;
  color: #ffffff;
  font-weight: bold;
  text-align: center;
}

.action-btn {
  width: 56px;
  height: 42px;
  background-color: #242424;
  border-radius: 21px;
  justify-content: center;
  align-items: center;
}

.action-text {
  font-size: 22px;
  font-weight: bold;
  color: #bac3ff;
}

/* ---- 按压反馈动画 ---- */
.pressable {
  transform-origin: 50% 50%;
  transform: scale(1);
  opacity: 1;
}
.is-down {
  opacity: 0.75;
}
.press-down {
  transform: scale(0.92);
  opacity: 0.75;
}
.press-up {
  transform: scale(1);
  opacity: 1;
}

/* ---- 居中纯净手写板 (圆表留出安全边距) ---- */
.writing-pad {
  width: 400px;
  height: 240px;
  background-color: #0c0c0c;
  border-width: 1px;
  border-style: solid;
  border-color: #262626;
  border-radius: 20px;
  margin-top: 6px;
  margin-bottom: 12px;
  position: relative;
}

/* ---- 落笔点高光指示器 ---- */
.highlight-dot {
  position: absolute;
  width: 32px;
  height: 32px;
  border-radius: 16px;
  background-color: rgba(186, 195, 255, 0.35);
  border-width: 2px;
  border-style: solid;
  border-color: #bac3ff;
}
</style>

<script>
import vibrator from '@system.vibrator'
import interconnectService from '../../services/interconnectService.js'

export default {
  props: {
    switchLabel: {
      type: String,
      default: '拼'
    }
  },

  data: {
    candidates: [],
    showHighlight: false,
    dotStyle: 'left: 0px; top: 0px;',
    strokes: [],
    currentStroke: [],
    commitTimer: null,
    pressedKey: '',
    releasedKey: ''
  },

  onDestroy() {
    if (this.commitTimer) {
      clearTimeout(this.commitTimer)
      this.commitTimer = null
    }
  },

  getTouchCoords(e) {
    var touch = (e.touches && e.touches[0]) || (e.changedTouches && e.changedTouches[0]) || e
    // 优先读取相对当前元素的 offsetX / offsetY，如果不存在则使用 clientX / pageX
    var x = typeof touch.offsetX === 'number' ? touch.offsetX : (touch.clientX || touch.pageX || touch.x || 0)
    var y = typeof touch.offsetY === 'number' ? touch.offsetY : (touch.clientY || touch.pageY || touch.y || 0)
    return { x: x, y: y }
  },

  onTouchStart(e) {
    if (this.commitTimer) {
      clearTimeout(this.commitTimer)
      this.commitTimer = null
    }

    var pos = this.getTouchCoords(e)
    var x = pos.x
    var y = pos.y

    // 更新高光位置居中 (光斑宽32px，半宽16px)
    var dotLeft = Math.max(0, Math.min(368, x - 16))
    var dotTop = Math.max(0, Math.min(208, y - 16))
    this.dotStyle = 'left: ' + dotLeft + 'px; top: ' + dotTop + 'px;'
    this.showHighlight = true

    // 开启新笔画
    this.currentStroke = [[x, y]]

    // 落笔短振动触觉反馈
    try {
      vibrator.vibrate({ mode: 'short' })
    } catch (_) {}
  },

  onTouchMove(e) {
    var pos = this.getTouchCoords(e)
    var x = pos.x
    var y = pos.y

    // 实时跟随手指高光
    var dotLeft = Math.max(0, Math.min(368, x - 16))
    var dotTop = Math.max(0, Math.min(208, y - 16))
    this.dotStyle = 'left: ' + dotLeft + 'px; top: ' + dotTop + 'px;'

    // 笔画采样 (位移 >= 3px 记录点)
    if (this.currentStroke.length > 0) {
      var last = this.currentStroke[this.currentStroke.length - 1]
      var dx = x - last[0]
      var dy = y - last[1]
      if (dx * dx + dy * dy >= 9) {
        this.currentStroke.push([x, y])
      }
    } else {
      this.currentStroke.push([x, y])
    }
  },

  onTouchEnd() {
    this.showHighlight = false

    if (this.currentStroke.length > 0) {
      this.strokes.push(this.currentStroke)
      this.currentStroke = []
    }

    // 500ms 抬笔超时自动提交识别
    this.commitTimer = setTimeout(() => {
      this.commitStrokes()
    }, 500)
  },

  onTouchCancel() {
    this.showHighlight = false
    if (this.currentStroke.length > 0) {
      this.strokes.push(this.currentStroke)
      this.currentStroke = []
    }
    this.commitTimer = setTimeout(() => {
      this.commitStrokes()
    }, 500)
  },

  commitStrokes() {
    if (!this.strokes || this.strokes.length === 0) return

    var payload = {
      strokes: this.strokes,
      width: 400,
      height: 240,
      max: 8
    }

    // 自动清空本地笔画缓存，允许用户立即开始写下一个字
    this.strokes = []

    // 走统一的 /api/ime/handwriting 互联通道
    interconnectService.sendApiRequest('/api/ime/handwriting', 'POST', payload)
      .then((res) => {
        if (res && res.ok && Array.isArray(res.candidates) && res.candidates.length > 0) {
          this.candidates = res.candidates
        }
      })
      .catch((err) => {
        console.warn('[handwriting] recognize request failed: ' + JSON.stringify(err))
      })
  },

  selectCandidate(word) {
    if (!word) return
    this.$emit('complete', { content: word })
    this.candidates = []
    try {
      vibrator.vibrate({ mode: 'short' })
    } catch (_) {}
  },

  onDelete() {
    this.$emit('delete', {})
    try {
      vibrator.vibrate({ mode: 'short' })
    } catch (_) {}
  },

  onSwitchKeyboard() {
    this.$emit('switchkeyboard', {})
    try {
      vibrator.vibrate({ mode: 'short' })
    } catch (_) {}
  },

  pressDown(key) {
    this.releasedKey = ''
    this.pressedKey = key
  },

  pressRelease(key) {
    this.pressedKey = ''
    this.releasedKey = key
    setTimeout(() => {
      if (this.releasedKey === key) this.releasedKey = ''
    }, 160)
  },

  pressCancel(key) {
    if (this.pressedKey === key) this.pressedKey = ''
    if (this.releasedKey === key) this.releasedKey = ''
  }
}
</script>
