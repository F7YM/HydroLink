{
  "package": "com.hydro.station",
  "name": "HydroStation",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1200,
  "icon": "/common/icon.png",
  "deviceTypeList": ["watch"],
  "features": [
    { "name": "system.router" },
    { "name": "system.file" },
    { "name": "system.prompt" },
    { "name": "system.fetch" },
    { "name": "system.device" },
    { "name": "system.vibrator" },
    { "name": "system.interconnect" },
    { "name": "system.audio" },
    { "name": "system.app"}
  ],
  "permissions": [
    { "name": "hapjs.permission.DEVICE_INFO" }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": 480
  },
  "router": {
    "entry": "pages/splash",
    "pages": {
      "pages/splash": {
        "component": "splash"
      },
      "pages/home": {
        "component": "home"
      },
      "pages/pair": {
        "component": "pair"
      },
      "pages/keyboard": {
        "component": "keyboard"
      },
      "pages/deviceDetail": {
        "component": "deviceDetail"
      },
      "pages/deviceInfo": {
        "component": "deviceInfo"
      },
      "pages/deviceType": {
        "component": "deviceType"
      },
      "pages/perfView": {
        "component": "perfView"
      },
      "pages/commandList": {
        "component": "commandList"
      },
      "pages/terminal": {
        "component": "terminal"
      },
      "pages/settings": {
        "component": "settings"
      }
    }
  }
}
