# Go 构建缓存（会话沙箱下 ~/.cache 只读时用工作区内缓存）
.gocache/

# Android build artifacts
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.apk
*.aab

# Local writable gradle home used when /home/float/.gradle is read-only
.gradle-home/
.xdgdata/

# Vela build artifacts
vela/build/
vela/dist/
vela/.temp/
.temp_vela/

# 打包产物与中间目录（dist/ 是要分发的成品，不入库）
dist/
packaging/build/

# Auto-generated build metadata (regenerated by scripts/update-buildinfo.js
# via the prebuild/prerelease npm lifecycle hooks before each build)
vela/src/services/buildInfo.js

# IDE
.idea/
*.iml
.vscode/
.DS_Store

# JVM 堆转储与崩溃日志（调试产物，勿入库）
*.hprof
hs_err_pid*.log
replay_pid*.log

# Android 发布产物与正式签名私钥（本地保留，不入库）
dist/*.apk
*.keystore
*.jks
# 快应用签名私钥（正式与调试；本地保留，首次可用 aiot 工具重新生成）
vela/sign/**/private.pem

# 本地开发笔记（不入库）
AGENTS.md

# Desktop Compose build artifacts
desktop-compose/.gradle/
desktop-compose/build/
desktop-compose/.kotlin/
desktop-compose/out/
desktop-compose/kcef-bundle/
desktop-compose/kcef-cache/

# 插件市场索引工程（独立 git 仓库，不属于主仓）
hydromarket-index/


# Rust 构建产物
target/
**/target/

