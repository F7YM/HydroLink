# Go 构建缓存（会话沙箱下 ~/.cache 只读时用工作区内缓存）
.gocache/

# Android build artifacts
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.apk
*.aab

# Local writable gradle home used when /home/float/.gradle is read-only
.gradle-home/
.xdgdata/

# Vela build artifacts
vela/build/
vela/dist/
vela/.temp/
.temp_vela/

# 打包产物与中间目录（dist/ 是要分发的成品，不入库）
dist/
packaging/build/

# Auto-generated build metadata (regenerated by scripts/update-buildinfo.js
# via the prebuild/prerelease npm lifecycle hooks before each build)
vela/src/services/buildInfo.js

# IDE
.idea/
*.iml
.vscode/
.DS_Store

# Android 发布产物（本地构建，不入库；仓库里保留的是签名用的 keystore）
dist/*.apk

# 本地开发笔记（不入库）
AGENTS.md

# 桌面端重写工程（独立 git 仓库，不属于主仓）
desktop-compose/

# 插件市场索引工程（独立 git 仓库，不属于主仓）
hydromarket-index/

# Go telemetry/本地构建缓存
desktop/go/
